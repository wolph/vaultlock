  TRANSITION_COMMAND=${VAULTLOCK_TEST_TRANSITION:-}
  LOCK_CRYPTO_MARKER_LOG=${VAULTLOCK_TEST_LOCK_CRYPTO_MARKER_LOG:-}
fi
