  export VAULTLOCK_TEST_PROCESS_PID=$$
  BSD_FIND=${VAULTLOCK_TEST_BSD_FIND:-$BSD_FIND}
  BSD_LS=${VAULTLOCK_TEST_BSD_LS:-$BSD_LS}
  BSD_STAT=${VAULTLOCK_TEST_BSD_STAT:-$BSD_STAT}
  DITTO_COMMAND=${VAULTLOCK_TEST_DITTO:-$DITTO_COMMAND}
  PS_COMMAND=${VAULTLOCK_TEST_PS:-$PS_COMMAND}
  OPENSSL_COMMAND=${VAULTLOCK_TEST_OPENSSL:-$OPENSSL_COMMAND}
  MKDIR_COMMAND=${VAULTLOCK_TEST_MKDIR:-$MKDIR_COMMAND}
  MKTEMP_COMMAND=${VAULTLOCK_TEST_MKTEMP:-$MKTEMP_COMMAND}
  LN_COMMAND=${VAULTLOCK_TEST_LN:-$LN_COMMAND}
  MV_COMMAND=${VAULTLOCK_TEST_MV:-$MV_COMMAND}
  RM_COMMAND=${VAULTLOCK_TEST_RM:-$RM_COMMAND}
