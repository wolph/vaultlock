die() { printf 'vaultlock: %s\n' "$*" >&2; exit 1; }
die_usage() { printf 'vaultlock: %s\n' "$*" >&2; exit 64; }
note() { printf '%s\n' "$*"; }

validate_command_options() { # command operands
  local command=$1
  shift

  case "$command" in
    init)
      [[ "$OPTION_HOOKS" == "true" ]] \
        || die_usage "--no-hooks is not valid for init"
      [[ $# -eq 0 ]] \
        || die_usage "usage: vaultlock init [--dry-run] [--yes]"
      ;;
    adopt)
      [[ "$OPTION_HOOKS" == "true" ]] \
        || die_usage "--no-hooks is not valid for adopt"
      [[ $# -eq 1 ]] \
        || die_usage "usage: vaultlock adopt [--dry-run] [--yes] <directory>"
      OPTION_OPERANDS=$1
      ;;
    lock)
      [[ $# -gt 0 ]] \
        || die_usage "usage: vaultlock lock [--dry-run] [--yes] [--no-hooks] <deadline>"
      OPTION_OPERANDS=$*
      ;;
    unlock)
      [[ "$OPTION_YES" == "false" ]] \
        || die_usage "--yes is not valid for unlock"
      [[ $# -eq 0 ]] \
        || die_usage "usage: vaultlock unlock [--dry-run] [--no-hooks]"
      ;;
    *)
      die_usage "unknown command: $command"
      ;;
  esac
}

parse_command_options() { # command argv
  local command=$1 argument
  shift
  OPTION_DRY_RUN=false
  OPTION_YES=false
  OPTION_HOOKS=true
  OPTION_OPERANDS=""

  while [[ $# -gt 0 && $1 == --* ]]; do
    argument=$1
    shift
    case "$argument" in
      --dry-run) OPTION_DRY_RUN=true ;;
      --yes) OPTION_YES=true ;;
      --no-hooks) OPTION_HOOKS=false ;;
      *) die_usage "unknown $command option: $argument" ;;
    esac
  done

  for argument in "$@"; do
    [[ "$argument" != --* ]] \
      || die_usage "options must precede $command operands: $argument"
  done
  validate_command_options "$command" "$@"
}

confirmation_accepts() { # response
  local response
  response=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
  [[ "$response" == "y" || "$response" == "yes" ]]
}

confirm_plan() {
  local response
  [[ "$OPTION_DRY_RUN" == "false" ]] || return 0
  [[ "$OPTION_YES" == "false" ]] || return 0
  [[ -r "$CONFIRM_DEVICE" && -w "$CONFIRM_DEVICE" ]] \
    || die "confirmation requires a terminal, rerun with --yes"
  if ! { exec 9<>"$CONFIRM_DEVICE"; } 2>/dev/null; then
    die "confirmation requires a terminal, rerun with --yes"
  fi
  printf 'Proceed? [y/N] ' >&9
  IFS= read -r response <&9 || response=""
  exec 9>&-
  confirmation_accepts "$response" || die "cancelled, no changes made"
}

tle_bin() {
  if command -v tle; then return 0; fi
  local p
  for p in "$HOME/bin/tle" "$HOME/go/bin/tle"; do
    if [[ -x "$p" ]]; then printf '%s\n' "$p"; return 0; fi
  done
  return 1
}

# Smallest round whose beacon time (genesis + (r-1)*period) >= epoch.
round_for_epoch() {
  local epoch=$1
  if (( epoch <= QUICKNET_GENESIS )); then printf '1\n'; return 0; fi
  printf '%s\n' $(( (epoch - QUICKNET_GENESIS + QUICKNET_PERIOD - 1) / QUICKNET_PERIOD + 1 ))
}

current_round() { round_for_epoch "$(/bin/date +%s)"; }

# Keep arithmetic operands small enough to avoid signed 64-bit overflow.
safe_component() {
  local value=$1
  [[ "$value" =~ ^[0-9]+$ && ${#value} -le 9 ]]
}

safe_epoch() {
  local value=$1
  [[ "$value" =~ ^[0-9]+$ && ${#value} -le 18 ]]
}

normalize_clock() {
  local value=$1
  local -i hour minute
  local clock_re='^([0-9]|[0-9][0-9]):([0-9][0-9])$'
  [[ "$value" =~ $clock_re ]] || return 1
  hour=$((10#${BASH_REMATCH[1]}))
  minute=$((10#${BASH_REMATCH[2]}))
  (( hour <= 23 && minute <= 59 )) || return 1
  printf '%02d:%02d\n' "$hour" "$minute"
}

format_local_minute() {
  /bin/date -j -r "$1" '+%Y-%m-%d %H:%M' 2>/dev/null
}

# Parse a canonical local minute without accepting date's normalization.
parse_local_minute() {
  local value=$1 epoch
  epoch=$(/bin/date -j -f '%Y-%m-%d %H:%M:%S' "$value:00" +%s 2>/dev/null) \
    || return 1
  [[ "$(format_local_minute "$epoch")" == "$value" ]] || return 1
  printf '%s\n' "$epoch"
}

local_date_for_epoch() {
  /bin/date -j -r "$1" '+%Y-%m-%d' 2>/dev/null
}

add_local_days() {
  local date_value=$1 days=$2
  /bin/date -j "-v+${days}d" -f '%Y-%m-%d %H:%M:%S' \
    "$date_value 12:00:00" '+%Y-%m-%d' 2>/dev/null
}

epoch_is_supported() {
  /bin/date -j -r "$1" '+%Y-%m-%dT%H:%M:%S%z' >/dev/null 2>&1
}

resolve_duration() {
  local expression=$1 now=$2 day_part hour_part minute_part
  local duration_re='^([0-9]+d)?([0-9]+h)?([0-9]+m)?$'
  local -i days=0 hours=0 minutes=0 total target

  [[ -n "$expression" && "$expression" =~ $duration_re ]] || return 1
  day_part=${BASH_REMATCH[1]%d}
  hour_part=${BASH_REMATCH[2]%h}
  minute_part=${BASH_REMATCH[3]%m}

  if [[ -n "$day_part" ]]; then
    safe_component "$day_part" || return 1
    days=$((10#$day_part))
  fi
  if [[ -n "$hour_part" ]]; then
    safe_component "$hour_part" || return 1
    hours=$((10#$hour_part))
  fi
  if [[ -n "$minute_part" ]]; then
    safe_component "$minute_part" || return 1
    minutes=$((10#$minute_part))
  fi

  total=$(( days * 86400 + hours * 3600 + minutes * 60 ))
  (( total > 0 )) || return 1
  target=$(( now + total ))
  (( target > now )) || return 1
  epoch_is_supported "$target" || return 1
  printf '%s\n' "$target"
}

resolve_clock() {
  local raw_clock=$1 now=$2 clock date_value first second wanted
  local -i attempt=0
  clock=$(normalize_clock "$raw_clock") || return 1
  date_value=$(local_date_for_epoch "$now") || return 1

  while (( attempt < 3 )); do
    wanted="$date_value $clock"
    if first=$(parse_local_minute "$wanted"); then
      if (( first > now )); then
        printf '%s\n' "$first"
        return 0
      fi

      # Europe/Amsterdam fall-back repeats the local hour one hour later.
      second=$(( first + 3600 ))
      if (( second > now )) \
          && [[ "$(format_local_minute "$second")" == "$wanted" ]]; then
        printf '%s\n' "$second"
        return 0
      fi
    fi
    date_value=$(add_local_days "$date_value" 1) || return 1
    attempt=$(( attempt + 1 ))
  done
  return 1
}

resolve_deadline() {
  local expression=$1 now_text=$2 clock days_text today target_date
  local -i now target days
  local absolute_re='^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9] [0-9][0-9]:[0-9][0-9]$'
  local combined_re='^(([0-9]|[0-9][0-9]):[0-9][0-9])[[:space:]]+\+([0-9]+)d$'
  local clock_re='^([0-9]|[0-9][0-9]):[0-9][0-9]$'

  safe_epoch "$now_text" || return 1
  now=$((10#$now_text))

  if [[ "$expression" =~ $absolute_re ]]; then
    target=$(parse_local_minute "$expression") || return 1
    (( target > now )) || return 1
    printf '%s\n' "$target"
    return 0
  fi

  if [[ "$expression" =~ $combined_re ]]; then
    clock=${BASH_REMATCH[1]}
    days_text=${BASH_REMATCH[3]}
    clock=$(normalize_clock "$clock") || return 1
    safe_component "$days_text" || return 1
    days=$((10#$days_text))
    (( days > 0 )) || return 1
    today=$(local_date_for_epoch "$now") || return 1
    target_date=$(add_local_days "$today" "$days") || return 1
    target=$(parse_local_minute "$target_date $clock") || return 1
    (( target > now )) || return 1
    printf '%s\n' "$target"
    return 0
  fi

  if [[ "$expression" =~ $clock_re ]]; then
    resolve_clock "$expression" "$now"
    return
  fi

  resolve_duration "$expression" "$now"
}

# "YYYY-MM-DD HH:MM" in local time -> epoch seconds at second zero.
parse_deadline() {
  parse_local_minute "$1"
}

state_get() { jq -r "$1" "$state_file"; }
vol_uuid() { state_get .volume_uuid; }

SNAPSHOT_RECORDED_LOCKED=unknown
SNAPSHOT_APFS_LOCKED=unknown
SNAPSHOT_APFS_MOUNTED=unknown
SNAPSHOT_EXPECTED_UUID=unknown
SNAPSHOT_ACTUAL_UUID=unknown
SNAPSHOT_DEVICE=unknown
SNAPSHOT_ACTUAL_MOUNT_POINT=unknown
SNAPSHOT_DEADLINE=null
SNAPSHOT_DEADLINE_EPOCH=null
SNAPSHOT_ROUND=null
SNAPSHOT_PLAINTEXT_PRESENT=false
SNAPSHOT_CIPHERTEXT_PRESENT=false
SNAPSHOT_HASH_PRESENT=false
SNAPSHOT_STATE_VALID=false
SNAPSHOT_APFS_VALID=false
SNAPSHOT_APFS_INSPECTED=false
SNAPSHOT_VALID=false
SNAPSHOT_ERROR="state has not been inspected"
RUNTIME_ASSESSMENT=inconsistent

inspect_runtime_state() {
  local state_json state_fields apfs_plist locked_value uuid_value
  local device_value mount_value mount_type
  local locked_valid=false mount_valid=true

  SNAPSHOT_INIT_ABSENT=false

  SNAPSHOT_RECORDED_LOCKED=unknown
  SNAPSHOT_APFS_LOCKED=unknown
  SNAPSHOT_APFS_MOUNTED=unknown
  SNAPSHOT_EXPECTED_UUID=unknown
  SNAPSHOT_ACTUAL_UUID=unknown
  SNAPSHOT_DEVICE=unknown
  SNAPSHOT_ACTUAL_MOUNT_POINT=unknown
  SNAPSHOT_DEADLINE=null
  SNAPSHOT_DEADLINE_EPOCH=null
  SNAPSHOT_ROUND=null
  SNAPSHOT_PLAINTEXT_PRESENT=false
  SNAPSHOT_CIPHERTEXT_PRESENT=false
  SNAPSHOT_HASH_PRESENT=false
  SNAPSHOT_STATE_VALID=false
  SNAPSHOT_APFS_VALID=false
  SNAPSHOT_APFS_INSPECTED=false
  SNAPSHOT_VALID=false
  SNAPSHOT_ERROR="state file fields are missing or malformed"

  [[ -f "$STATE_DIR/passphrase.txt" ]] \
    && SNAPSHOT_PLAINTEXT_PRESENT=true
  [[ -f "$STATE_DIR/passphrase.tle" ]] \
    && SNAPSHOT_CIPHERTEXT_PRESENT=true
  [[ -f "$STATE_DIR/passphrase.sha256" ]] \
    && SNAPSHOT_HASH_PRESENT=true

  [[ -f "$state_file" ]] || {
    SNAPSHOT_ERROR="state file is missing"
    return 0
  }
  [[ -r "$state_file" ]] || {
    SNAPSHOT_ERROR="state file is unreadable"
    return 0
  }
  if ! state_json=$(< "$state_file") 2>/dev/null; then
    SNAPSHOT_ERROR="state file is unreadable"
    return 0
  fi
  state_fields=$(printf '%s' "$state_json" | jq -er '
    def plain_string:
      if type == "string" then
        length > 0 and (test("[[:cntrl:]]") | not)
      else false end;
    def optional_string: . == null or plain_string;
    def optional_uint:
      if type == "number" then
        . >= 0 and . <= 999999999999999999 and floor == .
      else . == null end;
    if type == "object"
      and (.locked | type == "boolean")
      and (.volume_uuid | plain_string)
      and (.deadline | optional_string)
      and (.deadline_epoch | optional_uint)
      and (.round | optional_uint)
      and (if .locked then
        (.deadline | plain_string)
        and (.deadline_epoch | type == "number")
        and (.round | type == "number")
      else true end)
    then [
      (.locked | tostring),
      .volume_uuid,
      (if .deadline == null then "null" else .deadline end),
      (if .deadline_epoch == null then "null"
        else (.deadline_epoch | tostring) end),
      (if .round == null then "null" else (.round | tostring) end)
    ] | @tsv
    else error("invalid state") end
  ' 2>/dev/null) || return 0

  IFS=$'\t' read -r SNAPSHOT_RECORDED_LOCKED SNAPSHOT_EXPECTED_UUID \
    SNAPSHOT_DEADLINE SNAPSHOT_DEADLINE_EPOCH SNAPSHOT_ROUND \
    <<< "$state_fields"
  SNAPSHOT_STATE_VALID=true

  if ! apfs_plist=$(diskutil info -plist "$SNAPSHOT_EXPECTED_UUID" 2>/dev/null); then
    SNAPSHOT_ERROR="diskutil info failed"
    return 0
  fi
  SNAPSHOT_APFS_INSPECTED=true
  if ! printf '%s' "$apfs_plist" | plutil -lint - >/dev/null 2>&1; then
    SNAPSHOT_ERROR="APFS property list is malformed"
    return 0
  fi

  if locked_value=$(printf '%s' "$apfs_plist" \
      | plutil -extract Locked raw -expect bool -o - - 2>/dev/null); then
    locked_valid=true
  else
    locked_value=unknown
  fi
  uuid_value=$(printf '%s' "$apfs_plist" \
    | plutil -extract VolumeUUID raw -expect string -o - - 2>/dev/null) \
    || uuid_value=""
  device_value=$(printf '%s' "$apfs_plist" \
    | plutil -extract DeviceIdentifier raw -expect string -o - - 2>/dev/null) \
    || device_value=""
  if mount_type=$(printf '%s' "$apfs_plist" \
      | plutil -type MountPoint -o - - 2>/dev/null); then
    if [[ "$mount_type" == "string" ]]; then
      mount_value=$(printf '%s' "$apfs_plist" \
        | plutil -extract MountPoint raw -expect string -o - - 2>/dev/null) \
        || mount_valid=false
    else
      mount_valid=false
    fi
  else
    mount_value=""
  fi

  SNAPSHOT_ACTUAL_UUID=${uuid_value:-unknown}
  SNAPSHOT_DEVICE=${device_value:-unknown}
  if [[ "$mount_valid" == "true" ]]; then
    SNAPSHOT_ACTUAL_MOUNT_POINT=$mount_value
    if [[ -n "$mount_value" ]]; then
      SNAPSHOT_APFS_MOUNTED=true
    else
      SNAPSHOT_APFS_MOUNTED=false
    fi
  else
    SNAPSHOT_ACTUAL_MOUNT_POINT=unknown
    SNAPSHOT_APFS_MOUNTED=unknown
  fi

  if [[ "$locked_valid" != "true" \
      || ( "$locked_value" != "true" && "$locked_value" != "false" ) ]]; then
    SNAPSHOT_ERROR="APFS Locked is missing or malformed"
    return 0
  fi
  SNAPSHOT_APFS_LOCKED=$locked_value
  if [[ -z "$uuid_value" ]]; then
    SNAPSHOT_ERROR="APFS volume UUID is missing"
    return 0
  fi
  if [[ "$uuid_value" != "$SNAPSHOT_EXPECTED_UUID" ]]; then
    SNAPSHOT_ERROR="volume UUID mismatch: expected $SNAPSHOT_EXPECTED_UUID, actual $uuid_value"
    return 0
  fi
  if [[ ! "$device_value" =~ ^disk[[:alnum:]]+$ ]]; then
    SNAPSHOT_ERROR="APFS device identifier is missing or malformed"
    return 0
  fi
  if [[ "$mount_valid" != "true" ]]; then
    SNAPSHOT_ERROR="APFS MountPoint is malformed"
    return 0
  fi

  SNAPSHOT_APFS_VALID=true
  SNAPSHOT_VALID=true
  SNAPSHOT_ERROR=""
}

classify_runtime_state() {
  RUNTIME_ASSESSMENT=inconsistent
  [[ "$SNAPSHOT_VALID" == "true" ]] || return 0

  if [[ "$SNAPSHOT_APFS_LOCKED" == "true" \
      && "$SNAPSHOT_APFS_MOUNTED" == "true" ]]; then
    return 0
  fi
  if [[ "$SNAPSHOT_APFS_MOUNTED" == "true" \
      && "$SNAPSHOT_ACTUAL_MOUNT_POINT" != "$MOUNT_POINT" ]]; then
    return 0
  fi

  if [[ "$SNAPSHOT_RECORDED_LOCKED" == "false" ]]; then
    if [[ "$SNAPSHOT_APFS_LOCKED" == "false" \
        && "$SNAPSHOT_APFS_MOUNTED" == "true" \
        && "$SNAPSHOT_PLAINTEXT_PRESENT" == "true" ]]; then
      RUNTIME_ASSESSMENT=usable
    elif [[ "$SNAPSHOT_APFS_LOCKED" == "false" \
        && "$SNAPSHOT_APFS_MOUNTED" == "false" \
        && "$SNAPSHOT_PLAINTEXT_PRESENT" == "true" ]]; then
      RUNTIME_ASSESSMENT="repairable: run diskutil mount $SNAPSHOT_DEVICE"
    elif [[ "$SNAPSHOT_APFS_LOCKED" == "true" \
        && "$SNAPSHOT_APFS_MOUNTED" == "false" \
        && "$SNAPSHOT_PLAINTEXT_PRESENT" == "true" \
        && "$SNAPSHOT_HASH_PRESENT" == "true" ]]; then
      RUNTIME_ASSESSMENT="repairable: run vaultlock unlock"
    fi
    return 0
  fi

  if [[ "$SNAPSHOT_RECORDED_LOCKED" == "true" \
      && "$SNAPSHOT_APFS_LOCKED" == "true" \
      && "$SNAPSHOT_APFS_MOUNTED" == "false" \
      && "$SNAPSHOT_CIPHERTEXT_PRESENT" == "true" \
      && "$SNAPSHOT_HASH_PRESENT" == "true" \
      && "$SNAPSHOT_PLAINTEXT_PRESENT" == "false" ]]; then
    RUNTIME_ASSESSMENT="securely locked"
  fi
}

render_runtime_summary() {
  local actual_mount=unknown plaintext=absent ciphertext=absent hash=absent

  if [[ "$SNAPSHOT_INIT_ABSENT" == "true" ]]; then
    note "Recorded: absent (init preflight)"
  elif [[ "$SNAPSHOT_STATE_VALID" == "true" ]]; then
    if [[ "$SNAPSHOT_RECORDED_LOCKED" == "true" ]]; then
      note "Recorded: locked until $SNAPSHOT_DEADLINE"
    else
      note "Recorded: unlocked"
    fi
  else
    note "Recorded: unknown ($SNAPSHOT_ERROR)"
  fi

  if [[ "$SNAPSHOT_INIT_ABSENT" == "true" ]]; then
    note "APFS: absent (no volume named $VOLUME)"
  elif [[ "$SNAPSHOT_APFS_VALID" == "true" ]]; then
    if [[ "$SNAPSHOT_APFS_LOCKED" == "true" ]]; then
      note "APFS: locked (UUID $SNAPSHOT_ACTUAL_UUID, device $SNAPSHOT_DEVICE)"
    else
      note "APFS: unlocked (UUID $SNAPSHOT_ACTUAL_UUID, device $SNAPSHOT_DEVICE)"
    fi
  elif [[ "$SNAPSHOT_APFS_INSPECTED" == "true" ]]; then
    note "APFS: unknown ($SNAPSHOT_ERROR)"
  elif [[ "$SNAPSHOT_STATE_VALID" == "true" ]]; then
    note "APFS: unknown ($SNAPSHOT_ERROR)"
  else
    note "APFS: unknown (not inspected: invalid state snapshot)"
  fi

  if [[ "$SNAPSHOT_APFS_INSPECTED" == "true" ]]; then
    if [[ -n "$SNAPSHOT_ACTUAL_MOUNT_POINT" ]]; then
      actual_mount=$SNAPSHOT_ACTUAL_MOUNT_POINT
    else
      actual_mount="not mounted"
    fi
  fi
  note "Mount: expected $MOUNT_POINT, actual $actual_mount"

  [[ "$SNAPSHOT_PLAINTEXT_PRESENT" == "true" ]] && plaintext=present
  [[ "$SNAPSHOT_CIPHERTEXT_PRESENT" == "true" ]] && ciphertext=present
  [[ "$SNAPSHOT_HASH_PRESENT" == "true" ]] && hash=present
  note "Recovery: plaintext $plaintext, ciphertext $ciphertext, hash $hash"
  note "Assessment: $RUNTIME_ASSESSMENT"

  if [[ "$SNAPSHOT_STATE_VALID" == "true" \
      && "$SNAPSHOT_RECORDED_LOCKED" == "true" ]]; then
    note "remaining: $(remaining_human "$SNAPSHOT_DEADLINE_EPOCH")"
    note "drand round: target $SNAPSHOT_ROUND, current $(current_round)"
    note "when the deadline passes: vaultlock unlock (needs internet)"
  fi
}

run_named_transition() { # transition subject
  [[ -z "$TRANSITION_COMMAND" ]] \
    || "$TRANSITION_COMMAND" "$1" "$2"
}

private_path_acl_is_absent() { # path
  local listing
  listing=$(LC_ALL=C "$BSD_LS" -ldeB -- "$1" 2>/dev/null) || return 1
  [[ "$listing" != *$'\n'* ]]
}

private_directory_is_valid() { # path identity mode [link_count]
  local path=$1 expected_identity=$2 expected_mode=$3 metadata
  local expected_links=${4:-}
  local device inode mode owner link_count
  [[ -d "$path" && ! -L "$path" ]] || return 1
  metadata=$("$BSD_STAT" -f '%d:%i:%Lp:%u:%l' -- "$path" 2>/dev/null) \
    || return 1
  IFS=: read -r device inode mode owner link_count <<< "$metadata"
  [[ "$device:$inode" == "$expected_identity" \
      && "$mode" == "$expected_mode" && "$owner" == "$UID" \
      && "$link_count" =~ ^[1-9][0-9]*$ \
      && ( -z "$expected_links" || "$link_count" == "$expected_links" ) ]] \
    || return 1
  private_path_acl_is_absent "$path"
}

private_directory_is_empty() { # path
  local path=$1 entry
  entry=$("$BSD_FIND" -P "$path" -mindepth 1 -maxdepth 1 -print -quit \
    2>/dev/null) || return 1
  [[ -z "$entry" ]]
}

private_file_is_valid() { # path identity mode link_count
  local path=$1 expected_identity=$2 expected_mode=$3 expected_links=$4
  local metadata device inode mode owner link_count
  [[ -f "$path" && ! -L "$path" ]] || return 1
  metadata=$("$BSD_STAT" -f '%d:%i:%Lp:%u:%l' -- "$path" 2>/dev/null) \
    || return 1
  IFS=: read -r device inode mode owner link_count <<< "$metadata"
  [[ "$device:$inode" == "$expected_identity" \
      && "$mode" == "$expected_mode" && "$owner" == "$UID" \
      && "$link_count" == "$expected_links" ]] || return 1
  private_path_acl_is_absent "$path"
}

protect_private_file() { # path
  local path=$1 identity
  identity=$(operation_path_identity "$path") || return 1
  "$CHMOD_COMMAND" -N "$path" || return 1
  "$CHMOD_COMMAND" 600 "$path" || return 1
  private_file_is_valid "$path" "$identity" 600 1
}

operation_owner_digest() { # path
  local output
  output=$(/usr/bin/shasum -a 256 -- "$1" 2>/dev/null) || return 1
  [[ "$output" =~ ^([0-9a-f]{64})[[:space:]] ]] || return 1
  printf '%s\n' "${BASH_REMATCH[1]}"
}

operation_path_identity() { # path
  "$BSD_STAT" -f '%d:%i' -- "$1" 2>/dev/null
}

hook_file_signature() { # path
  local path=$1 link_metadata target_metadata link_digest target_digest output
  [[ -f "$path" && -x "$path" ]] || return 1
  if [[ -L "$path" ]]; then
    link_metadata=$("$BSD_STAT" -f '%d:%i:%HT:%Lp:%u:%l' -- \
      "$path" 2>/dev/null) || return 1
    [[ "$link_metadata" == *':Symbolic Link:'* ]] || return 1
    output=$(/usr/bin/readlink -n -- "$path" 2>/dev/null \
      | /usr/bin/shasum -a 256) || return 1
    [[ "$output" =~ ^([0-9a-f]{64})[[:space:]] ]] || return 1
    link_digest=${BASH_REMATCH[1]}
    target_metadata=$("$BSD_STAT" -L -f '%d:%i:%HT:%Lp:%u:%l' -- \
      "$path" 2>/dev/null) || return 1
    [[ "$target_metadata" == *':Regular File:'* ]] || return 1
    target_digest=$(operation_owner_digest "$path") || return 1
    printf 'symlink:%s:%s:%s:%s\n' "$link_metadata" "$link_digest" \
      "$target_metadata" "$target_digest"
    return 0
  fi
  target_metadata=$("$BSD_STAT" -f '%d:%i:%HT:%Lp:%u:%l' -- \
    "$path" 2>/dev/null) || return 1
  [[ "$target_metadata" == *':Regular File:'* ]] || return 1
  target_digest=$(operation_owner_digest "$path") || return 1
  printf 'file:%s:%s\n' "$target_metadata" "$target_digest"
}

valid_process_start_identity() { # value
  local value=$1 normalized
  [[ -n "$value" && "$value" != *$'\n'* && "$value" != *$'\t'* ]] \
    || return 1
  normalized=$(TZ=UTC0 LC_ALL=C /bin/date -j -f '%a %b %e %T %Y' "$value" \
    '+%a %b %e %T %Y' 2>/dev/null) || return 1
  [[ "$normalized" == "$value" ]]
}

inspect_operation_lock() {
  local directory_metadata owner_metadata line1 line2 line3 line4 line5
  local directory_link_count
  [[ -d "$OPERATION_LOCK_DIR" && ! -L "$OPERATION_LOCK_DIR" ]] \
    || return 1
  directory_metadata=$(
    "$BSD_STAT" -f '%d:%i:%Lp:%u:%l' -- "$OPERATION_LOCK_DIR" 2>/dev/null
  ) || return 1
  IFS=: read -r directory_device directory_inode directory_mode directory_uid \
    directory_link_count <<< "$directory_metadata"
  [[ "$directory_mode" == "700" && "$directory_uid" == "$UID" \
      && "$directory_link_count" =~ ^[1-9][0-9]*$ ]] \
    || return 1
  private_path_acl_is_absent "$OPERATION_LOCK_DIR" || return 1
  [[ -f "$OPERATION_LOCK_DIR/owner" \
    && ! -L "$OPERATION_LOCK_DIR/owner" ]] || return 1
  owner_metadata=$(
    "$BSD_STAT" -f '%d:%i:%Lp:%u:%l' -- "$OPERATION_LOCK_DIR/owner" \
      2>/dev/null
  ) || return 1
  IFS=: read -r owner_device owner_inode owner_mode owner_uid owner_nlink \
    <<< "$owner_metadata"
  [[ "$owner_mode" == "600" && "$owner_uid" == "$UID" \
    && "$owner_nlink" == "1" ]] || return 1
  private_path_acl_is_absent "$OPERATION_LOCK_DIR/owner" || return 1
  {
    IFS= read -r line1
    IFS= read -r line2
    IFS= read -r line3
    IFS= read -r line4
    IFS= read -r line5
    ! IFS= read -r
  } < "$OPERATION_LOCK_DIR/owner" || return 1
  [[ "$line1" == "version=1" \
    && "$line2" =~ ^pid=([1-9][0-9]*)$ \
    && "$line3" == start=* \
    && "$line4" =~ ^command=(init|adopt|lock|unlock)$ \
    && "$line5" =~ ^token=([0-9a-f]{64})$ ]] || return 1
  valid_process_start_identity "${line3#start=}" || return 1
  INSPECTED_LOCK_DIR_IDENTITY=$directory_device:$directory_inode
  INSPECTED_LOCK_DIR_LINK_COUNT=$directory_link_count
  INSPECTED_LOCK_OWNER_IDENTITY=$owner_device:$owner_inode
  INSPECTED_LOCK_OWNER_DIGEST=$(operation_owner_digest \
    "$OPERATION_LOCK_DIR/owner") || return 1
  INSPECTED_LOCK_PID=${line2#pid=}
  INSPECTED_LOCK_START=${line3#start=}
  INSPECTED_LOCK_COMMAND=${line4#command=}
  INSPECTED_LOCK_TOKEN=${line5#token=}
}

revalidate_inspected_operation_lock() {
  local expected_directory=$INSPECTED_LOCK_DIR_IDENTITY
  local expected_owner=$INSPECTED_LOCK_OWNER_IDENTITY
  local expected_digest=$INSPECTED_LOCK_OWNER_DIGEST
  local expected_token=$INSPECTED_LOCK_TOKEN
  local expected_directory_links=$INSPECTED_LOCK_DIR_LINK_COUNT
  inspect_operation_lock \
    && [[ "$INSPECTED_LOCK_DIR_IDENTITY" == "$expected_directory" \
      && "$INSPECTED_LOCK_OWNER_IDENTITY" == "$expected_owner" \
      && "$INSPECTED_LOCK_OWNER_DIGEST" == "$expected_digest" \
      && "$INSPECTED_LOCK_DIR_LINK_COUNT" == "$expected_directory_links" \
      && "$INSPECTED_LOCK_TOKEN" == "$expected_token" ]]
}

probe_process_start() { # pid
  local output status
  if output=$(TZ=UTC0 LC_ALL=C \
      "$PS_COMMAND" -p "$1" -o lstart= 2>/dev/null); then
    status=0
  else
    status=$?
  fi
  output=${output#"${output%%[![:space:]]*}"}
  output=${output%"${output##*[![:space:]]}"}
  if [[ "$status" -eq 1 && -z "$output" ]]; then
    PROCESS_PROBE_KIND=absent
    PROCESS_PROBE_START=""
    return 0
  fi
  if [[ "$status" -eq 0 ]] \
      && valid_process_start_identity "$output"; then
    PROCESS_PROBE_KIND=present
    PROCESS_PROBE_START=$output
    return 0
  fi
  PROCESS_PROBE_KIND=ambiguous
  PROCESS_PROBE_START=""
}

classify_inspected_operation_lock() {
  local first_kind first_start second_kind second_start
  probe_process_start "$INSPECTED_LOCK_PID"
  first_kind=$PROCESS_PROBE_KIND
  first_start=$PROCESS_PROBE_START
  probe_process_start "$INSPECTED_LOCK_PID"
  second_kind=$PROCESS_PROBE_KIND
  second_start=$PROCESS_PROBE_START
  if [[ "$first_kind" == absent && "$second_kind" == absent ]]; then
    OPERATION_LOCK_CLASSIFICATION=stale
    return 0
  fi
  if [[ "$first_kind" == present && "$second_kind" == present \
    && "$first_start" == "$second_start" ]]; then
    if [[ "$first_start" == "$INSPECTED_LOCK_START" ]]; then
      OPERATION_LOCK_CLASSIFICATION=live
    else
      OPERATION_LOCK_CLASSIFICATION=stale
    fi
    return 0
  fi
  OPERATION_LOCK_CLASSIFICATION=ambiguous
}

generate_operation_token() {
  local token
  token=$("$OPENSSL_COMMAND" rand -hex 32 2>/dev/null) || return 1
  [[ "$token" =~ ^[0-9a-f]{64}$ ]] || return 1
  printf '%s\n' "$token"
}

partial_operation_lock_directory_matches() {
  local metadata directory_device directory_inode directory_mode directory_uid
  local directory_link_count
  [[ "$OPERATION_LOCK_PARTIAL" == true \
    && -n "$OPERATION_LOCK_DIR_IDENTITY" \
    && -d "$OPERATION_LOCK_DIR" && ! -L "$OPERATION_LOCK_DIR" ]] \
    || return 1
  metadata=$("$BSD_STAT" -f '%d:%i:%Lp:%u:%l' -- \
    "$OPERATION_LOCK_DIR" 2>/dev/null) || return 1
  IFS=: read -r directory_device directory_inode directory_mode directory_uid \
    directory_link_count <<< "$metadata"
  [[ "$directory_device:$directory_inode" == "$OPERATION_LOCK_DIR_IDENTITY" \
      && "$directory_mode" == 700 && "$directory_uid" == "$UID" \
      && "$directory_link_count" =~ ^[1-9][0-9]*$ ]] \
    && private_path_acl_is_absent "$OPERATION_LOCK_DIR"
}

partial_operation_lock_file_matches() { # path identity digest
  local path=$1 expected_identity=$2 expected_digest=$3 metadata
  local file_device file_inode file_mode file_uid file_nlink actual_digest
  [[ -n "$path" && -n "$expected_identity" \
    && -f "$path" && ! -L "$path" ]] || return 1
  metadata=$("$BSD_STAT" -f '%d:%i:%Lp:%u:%l' -- "$path" 2>/dev/null) \
    || return 1
  IFS=: read -r file_device file_inode file_mode file_uid file_nlink \
    <<< "$metadata"
  [[ "$file_device:$file_inode" == "$expected_identity" \
    && "$file_mode" == 600 && "$file_uid" == "$UID" \
    && ( "$file_nlink" == 1 || "$file_nlink" == 2 ) ]] || return 1
  private_path_acl_is_absent "$path" || return 1
  if [[ -n "$expected_digest" ]]; then
    actual_digest=$(operation_owner_digest "$path") || return 1
    [[ "$actual_digest" == "$expected_digest" ]] || return 1
  fi
}

cleanup_partial_operation_lock() {
  local failed=false expected_owner_identity expected_owner_digest candidate
  local discovered_temp="" discovered_identity=""
  [[ "$OPERATION_LOCK_PARTIAL" == true ]] || return 0
  if [[ -z "$OPERATION_LOCK_TEMP" ]] \
    && partial_operation_lock_directory_matches; then
    for candidate in "$OPERATION_LOCK_DIR"/.owner.*; do
      [[ -e "$candidate" || -L "$candidate" ]] || continue
      if [[ -n "$discovered_temp" ]]; then
        failed=true
        break
      fi
      discovered_identity=$(operation_path_identity "$candidate") \
        || { failed=true; break; }
      partial_operation_lock_file_matches "$candidate" \
        "$discovered_identity" "" || { failed=true; break; }
      discovered_temp=$candidate
    done
    if [[ -n "$discovered_temp" ]]; then
      OPERATION_LOCK_TEMP=$discovered_temp
      OPERATION_LOCK_TEMP_IDENTITY=$discovered_identity
    fi
  fi
  expected_owner_identity=$OPERATION_LOCK_OWNER_IDENTITY
  expected_owner_digest=$OPERATION_LOCK_OWNER_DIGEST
  if [[ -z "$expected_owner_identity" ]]; then
    expected_owner_identity=$OPERATION_LOCK_TEMP_IDENTITY
    expected_owner_digest=$OPERATION_LOCK_TEMP_DIGEST
  fi
  if [[ -n "$OPERATION_LOCK_TEMP" \
    && ( -e "$OPERATION_LOCK_TEMP" || -L "$OPERATION_LOCK_TEMP" ) ]]; then
    if partial_operation_lock_file_matches "$OPERATION_LOCK_TEMP" \
      "$OPERATION_LOCK_TEMP_IDENTITY" "$OPERATION_LOCK_TEMP_DIGEST"; then
      "$RM_COMMAND" -f -- "$OPERATION_LOCK_TEMP" || failed=true
    else
      failed=true
    fi
  fi
  if partial_operation_lock_directory_matches; then
    if [[ -e "$OPERATION_LOCK_DIR/owner" \
      || -L "$OPERATION_LOCK_DIR/owner" ]]; then
      if partial_operation_lock_file_matches "$OPERATION_LOCK_DIR/owner" \
        "$expected_owner_identity" "$expected_owner_digest"; then
        "$RM_COMMAND" -f -- "$OPERATION_LOCK_DIR/owner" || failed=true
      else
        failed=true
      fi
    fi
    if [[ "$failed" == false ]]; then
      "$RMDIR_COMMAND" -- "$OPERATION_LOCK_DIR" || failed=true
    fi
  else
    failed=true
  fi
  if [[ "$failed" == false ]]; then
    OPERATION_LOCK_PARTIAL=false
    OPERATION_LOCK_TEMP=""
    OPERATION_LOCK_TEMP_IDENTITY=""
    OPERATION_LOCK_TEMP_DIGEST=""
    OPERATION_LOCK_DIR_IDENTITY=""
    OPERATION_LOCK_OWNER_IDENTITY=""
    OPERATION_LOCK_OWNER_DIGEST=""
    return 0
  fi
  return 1
}

release_owned_operation_lock() {
  local directory_identity owner_identity owner_digest
  [[ "$OPERATION_LOCK_ACTIVE" == true ]] || return 0
  run_named_transition operation_lock_before_release \
    "$OPERATION_LOCK_DIR/owner"
  [[ -d "$OPERATION_LOCK_DIR" && ! -L "$OPERATION_LOCK_DIR" \
    && -f "$OPERATION_LOCK_DIR/owner" \
    && ! -L "$OPERATION_LOCK_DIR/owner" ]] || return 1
  directory_identity=$(operation_path_identity "$OPERATION_LOCK_DIR") \
    || return 1
  owner_identity=$(operation_path_identity "$OPERATION_LOCK_DIR/owner") \
    || return 1
  owner_digest=$(operation_owner_digest "$OPERATION_LOCK_DIR/owner") \
    || return 1
  [[ "$directory_identity" == "$OPERATION_LOCK_DIR_IDENTITY" \
    && "$owner_identity" == "$OPERATION_LOCK_OWNER_IDENTITY" \
    && "$owner_digest" == "$OPERATION_LOCK_OWNER_DIGEST" ]] || return 1
  inspect_operation_lock || return 1
  [[ "$INSPECTED_LOCK_TOKEN" == "$OPERATION_LOCK_TOKEN" \
    && "$INSPECTED_LOCK_COMMAND" == "$OPERATION_LOCK_COMMAND" ]] \
    || return 1
  "$RM_COMMAND" -f -- "$OPERATION_LOCK_DIR/owner" || return 1
  "$RMDIR_COMMAND" -- "$OPERATION_LOCK_DIR" || return 1
  OPERATION_LOCK_ACTIVE=false
  OPERATION_LOCK_PARTIAL=false
}

cleanup_unlock_staging_file() {
  local actual_digest
  [[ -n "$UNLOCK_STAGING_PATH" ]] || return 0
  if private_file_is_valid "$UNLOCK_STAGING_PATH" \
      "$UNLOCK_STAGING_IDENTITY" 600 1 \
      && actual_digest=$(operation_owner_digest "$UNLOCK_STAGING_PATH") \
      && { [[ -z "$UNLOCK_STAGING_DIGEST" ]] \
        || [[ "$actual_digest" == "$UNLOCK_STAGING_DIGEST" ]]; } \
      && "$RM_COMMAND" -f -- "$UNLOCK_STAGING_PATH" \
      && [[ ! -e "$UNLOCK_STAGING_PATH" \
        && ! -L "$UNLOCK_STAGING_PATH" ]]; then
    UNLOCK_STAGING_PATH=""
    UNLOCK_STAGING_IDENTITY=""
    UNLOCK_STAGING_DIGEST=""
    UNLOCK_STAGING_DESCRIPTION=""
    return 0
  fi
  printf 'vaultlock: %s retained at %s\n' \
    "$UNLOCK_STAGING_DESCRIPTION" "$UNLOCK_STAGING_PATH" >&2
  return 1
}

track_unlock_staging_file() { # path identity digest description
  UNLOCK_STAGING_PATH=$1
  UNLOCK_STAGING_IDENTITY=$2
  UNLOCK_STAGING_DIGEST=$3
  UNLOCK_STAGING_DESCRIPTION=$4
}

clear_unlock_staging_file() {
  UNLOCK_STAGING_PATH=""
  UNLOCK_STAGING_IDENTITY=""
  UNLOCK_STAGING_DIGEST=""
  UNLOCK_STAGING_DESCRIPTION=""
}

lock_staging_signature() { # path
  protected_file_signature "$1" 600 1,2 false
}

track_lock_staging_file() { # path signature description
  LOCK_STAGE_PATHS+=("$1")
  LOCK_STAGE_SIGNATURES+=("$2")
  LOCK_STAGE_DESCRIPTIONS+=("$3")
}

refresh_lock_staging_signature() { # path
  local path=$1 index signature
  signature=$(lock_staging_signature "$path") || return 1
  for ((index=0; index<${#LOCK_STAGE_PATHS[@]}; index++)); do
    if [[ "${LOCK_STAGE_PATHS[$index]}" == "$path" ]]; then
      LOCK_STAGE_SIGNATURES[index]=$signature
      return 0
    fi
  done
  return 1
}

clear_lock_staging_file() { # path
  local path=$1 index
  for ((index=0; index<${#LOCK_STAGE_PATHS[@]}; index++)); do
    if [[ "${LOCK_STAGE_PATHS[$index]}" == "$path" ]]; then
      LOCK_STAGE_PATHS[index]=""
      LOCK_STAGE_SIGNATURES[index]=""
      LOCK_STAGE_DESCRIPTIONS[index]=""
      return 0
    fi
  done
}

cleanup_disposable_lock_recovery_pair() {
  local fixed=$STATE_DIR/passphrase-new.txt transaction
  local fixed_actual transaction_actual remaining
  local device inode mode owner links digest
  local remaining_device remaining_inode remaining_mode remaining_owner
  local remaining_links remaining_digest
  transaction=$LOCK_TRANSACTION_STAGE
  fixed_actual=$(lock_staging_signature "$fixed") || return 1
  transaction_actual=$(lock_staging_signature "$transaction") || return 1
  [[ "$fixed_actual" == "$LOCK_FIXED_STAGE_SIGNATURE" \
    && "$transaction_actual" == "$LOCK_TRANSACTION_SIGNATURE" \
    && "$fixed_actual" == "$transaction_actual" ]] || return 1
  IFS=: read -r device inode mode owner links digest \
    <<< "$transaction_actual"
  [[ "$links" == 2 ]] || return 1
  "$RM_COMMAND" -f -- "$fixed" || return 1
  [[ ! -e "$fixed" && ! -L "$fixed" ]] || return 1
  remaining=$(lock_staging_signature "$transaction") || return 1
  IFS=: read -r remaining_device remaining_inode remaining_mode \
    remaining_owner remaining_links remaining_digest <<< "$remaining"
  [[ "$remaining_device:$remaining_inode:$remaining_mode:$remaining_owner" \
      == "$device:$inode:$mode:$owner" \
    && "$remaining_links" == 1 \
    && "$remaining_digest" == "$digest" ]] || return 1
  "$RM_COMMAND" -f -- "$transaction" || return 1
  [[ ! -e "$transaction" && ! -L "$transaction" ]] || return 1
  clear_lock_staging_file "$fixed"
  clear_lock_staging_file "$transaction"
}

cleanup_lock_staging_files() {
  local index path expected actual failed=false pair_handled=false
  if [[ "$LOCK_APFS_ROTATION_ATTEMPTED" == false \
      && -n "$LOCK_TRANSACTION_STAGE" \
      && -n "$LOCK_TRANSACTION_SIGNATURE" \
      && -n "$LOCK_FIXED_STAGE_SIGNATURE" \
      && -e "$LOCK_TRANSACTION_STAGE" \
      && -e "$STATE_DIR/passphrase-new.txt" ]]; then
    pair_handled=true
    if ! cleanup_disposable_lock_recovery_pair; then
      printf 'vaultlock: disposable recovery staging pair retained for inspection\n' \
        >&2
      failed=true
    fi
  fi
  for ((index=0; index<${#LOCK_STAGE_PATHS[@]}; index++)); do
    path=${LOCK_STAGE_PATHS[$index]}
    [[ -n "$path" ]] || continue
    if [[ "$pair_handled" == true \
        && ( "$path" == "$LOCK_TRANSACTION_STAGE" \
          || "$path" == "$STATE_DIR/passphrase-new.txt" ) ]]; then
      continue
    fi
    expected=${LOCK_STAGE_SIGNATURES[$index]}
    if [[ ( "$LOCK_APFS_ROTATED" == true \
          || "$LOCK_APFS_ROTATION_ATTEMPTED" == true ) \
        && ( "$path" == "$LOCK_TRANSACTION_STAGE" \
          || "$path" == "$STATE_DIR/passphrase-new.txt" ) ]]; then
      actual=$(lock_staging_signature "$path") || actual=""
      if [[ -n "$expected" && "$actual" == "$expected" ]]; then
        printf 'vaultlock: verified %s retained at %s\n' \
          "${LOCK_STAGE_DESCRIPTIONS[$index]}" "$path" >&2
      else
        printf 'vaultlock: unverified %s retained at %s\n' \
          "${LOCK_STAGE_DESCRIPTIONS[$index]}" "$path" >&2
      fi
      failed=true
      continue
    fi
    actual=$(lock_staging_signature "$path") || actual=""
    if [[ -n "$expected" && "$actual" == "$expected" ]] \
        && "$RM_COMMAND" -f -- "$path" \
        && [[ ! -e "$path" && ! -L "$path" ]]; then
      clear_lock_staging_file "$path"
    else
      printf 'vaultlock: %s retained at %s\n' \
        "${LOCK_STAGE_DESCRIPTIONS[$index]}" "$path" >&2
      failed=true
    fi
  done
  [[ "$failed" == false ]]
}

operation_cleanup_dispatcher() { # signal
  local signal=$1 status=$? release_failed=false staging_cleanup_failed=false
  trap - EXIT HUP INT TERM
  cleanup_unlock_staging_file || staging_cleanup_failed=true
  cleanup_lock_staging_files || staging_cleanup_failed=true
  if [[ "$signal" != EXIT && "$ADOPT_TRANSACTION_PHASE" != none ]]; then
    cleanup_adopt_transaction_after_signal "$signal"
  elif [[ "$signal" != EXIT ]]; then
    printf 'vaultlock: operation interrupted by %s\n' "$signal" >&2
  fi
  if [[ "$OPERATION_LOCK_ACTIVE" == true ]]; then
    if ! release_owned_operation_lock; then
      release_failed=true
      printf 'vaultlock: operation lock retained: %s\n' \
        "$OPERATION_LOCK_DIR" >&2
    fi
  elif [[ "$OPERATION_LOCK_PARTIAL" == true ]]; then
    if ! cleanup_partial_operation_lock; then
      release_failed=true
      printf 'vaultlock: operation lock retained: %s\n' \
        "$OPERATION_LOCK_DIR" >&2
    fi
  fi
  case "$signal" in
    HUP) status=129 ;;
    INT) status=130 ;;
    TERM) status=143 ;;
    EXIT) ;;
  esac
  if [[ "$status" -eq 0 \
      && ( "$release_failed" == true \
        || "$staging_cleanup_failed" == true ) ]]; then
    status=1
  fi
  exit "$status"
}

operation_signal_handler() { # signal
  if [[ "$OPERATION_SIGNAL_DEFERRED" == true ]]; then
    [[ -n "$OPERATION_PENDING_SIGNAL" ]] \
      || OPERATION_PENDING_SIGNAL=$1
    return 0
  fi
  operation_cleanup_dispatcher "$1"
}

begin_operation_signal_deferral() {
  OPERATION_PENDING_SIGNAL=""
  run_named_transition operation_signal_deferral_begin_window \
    "$OPERATION_LOCK_DIR"
  OPERATION_SIGNAL_DEFERRED=true
}

end_operation_signal_deferral() {
  OPERATION_SIGNAL_DEFERRED=false
  run_named_transition operation_signal_deferral_end_window \
    "$OPERATION_LOCK_DIR"
  local pending=$OPERATION_PENDING_SIGNAL
  OPERATION_PENDING_SIGNAL=""
  [[ -z "$pending" ]] || operation_cleanup_dispatcher "$pending"
}

dispatch_deferred_operation_signal() {
  local pending=$OPERATION_PENDING_SIGNAL
  [[ -z "$pending" ]] || operation_cleanup_dispatcher "$pending"
}

install_operation_cleanup_traps() {
  trap 'operation_cleanup_dispatcher EXIT' EXIT
  trap 'operation_signal_handler HUP' HUP
  trap 'operation_signal_handler INT' INT
  trap 'operation_signal_handler TERM' TERM
}

create_owned_operation_lock() {
  local start temporary
  probe_process_start "$$"
  [[ "$PROCESS_PROBE_KIND" == present ]] \
    || die "cannot inspect current process for operation lock"
  start=$PROCESS_PROBE_START
  temporary=$("$MKTEMP_COMMAND" "$OPERATION_LOCK_DIR/.owner.XXXXXX") \
    || die "cannot create operation lock owner staging file"
  [[ "$temporary" == "$OPERATION_LOCK_DIR/.owner."* \
    && "${temporary#"$OPERATION_LOCK_DIR/.owner."}" != */* ]] \
    || die "operation lock owner staging path is outside expected boundary"
  OPERATION_LOCK_TEMP=$temporary
  OPERATION_LOCK_TEMP_IDENTITY=$(operation_path_identity "$temporary") \
    || die "cannot capture operation lock owner staging identity"
  "$CHMOD_COMMAND" -N "$temporary" \
    || die "cannot remove operation lock owner staging ACL"
  "$CHMOD_COMMAND" 600 "$temporary" \
    || die "cannot protect operation lock owner staging file"
  private_file_is_valid "$temporary" "$OPERATION_LOCK_TEMP_IDENTITY" 600 1 \
    || die "operation lock owner staging metadata is unsafe"
  printf 'version=1\npid=%s\nstart=%s\ncommand=%s\ntoken=%s\n' \
    "$$" "$start" "$OPERATION_LOCK_COMMAND" "$OPERATION_LOCK_TOKEN" \
    > "$temporary"
  private_file_is_valid "$temporary" "$OPERATION_LOCK_TEMP_IDENTITY" 600 1 \
    || die "operation lock owner staging metadata changed"
  OPERATION_LOCK_TEMP_DIGEST=$(operation_owner_digest "$temporary") \
    || die "cannot fingerprint operation lock owner staging file"
  "$LN_COMMAND" -- "$temporary" "$OPERATION_LOCK_DIR/owner" \
    || die "cannot install operation lock owner record"
  OPERATION_LOCK_OWNER_IDENTITY=$OPERATION_LOCK_TEMP_IDENTITY
  OPERATION_LOCK_OWNER_DIGEST=$OPERATION_LOCK_TEMP_DIGEST
  "$RM_COMMAND" -f -- "$temporary" \
    || die "cannot remove operation lock owner staging file"
  OPERATION_LOCK_TEMP=""
  inspect_operation_lock || die "cannot verify operation lock owner record"
  [[ "$INSPECTED_LOCK_PID" == "$$" \
    && "$INSPECTED_LOCK_START" == "$start" \
    && "$INSPECTED_LOCK_COMMAND" == "$OPERATION_LOCK_COMMAND" \
    && "$INSPECTED_LOCK_TOKEN" == "$OPERATION_LOCK_TOKEN" ]] \
    || die "operation lock owner verification failed"
  OPERATION_LOCK_DIR_IDENTITY=$INSPECTED_LOCK_DIR_IDENTITY
  OPERATION_LOCK_OWNER_IDENTITY=$INSPECTED_LOCK_OWNER_IDENTITY
  OPERATION_LOCK_OWNER_DIGEST=$INSPECTED_LOCK_OWNER_DIGEST
  OPERATION_LOCK_PARTIAL=false
  OPERATION_LOCK_ACTIVE=true
}

quarantine_inspected_stale_operation_lock() {
  local suffix quarantine original_lock_dir
  local expected_directory expected_owner expected_digest expected_pid
  local expected_start expected_command expected_token
  local expected_directory_links
  expected_directory=$INSPECTED_LOCK_DIR_IDENTITY
  expected_owner=$INSPECTED_LOCK_OWNER_IDENTITY
  expected_digest=$INSPECTED_LOCK_OWNER_DIGEST
  expected_pid=$INSPECTED_LOCK_PID
  expected_start=$INSPECTED_LOCK_START
  expected_command=$INSPECTED_LOCK_COMMAND
  expected_token=$INSPECTED_LOCK_TOKEN
  expected_directory_links=$INSPECTED_LOCK_DIR_LINK_COUNT
  run_named_transition operation_lock_final_check \
    "$OPERATION_LOCK_DIR/owner"
  revalidate_inspected_operation_lock \
    || die "operation lock changed during final verification"
  suffix=$(generate_operation_token) \
    || die "cannot generate stale operation lock quarantine suffix"
  if [[ "$suffix" == "$OPERATION_LOCK_TOKEN" ]]; then
    suffix=$(generate_operation_token) \
      || die "cannot generate distinct stale operation lock quarantine suffix"
  fi
  [[ "$suffix" != "$OPERATION_LOCK_TOKEN" ]] \
    || die "stale operation lock quarantine suffix is not distinct"
  quarantine=$OPERATION_LOCK_DIR.quarantine.$suffix
  [[ ! -e "$quarantine" && ! -L "$quarantine" ]] \
    || die "stale operation lock quarantine path already exists"
  "$MV_COMMAND" -n -- "$OPERATION_LOCK_DIR" "$quarantine" \
    || die "cannot quarantine verified stale operation lock"
  [[ ! -e "$OPERATION_LOCK_DIR" && ! -L "$OPERATION_LOCK_DIR" ]] \
    || die "stale operation lock source remains after quarantine"
  run_named_transition operation_lock_after_quarantine_move \
    "$quarantine/owner"
  original_lock_dir=$OPERATION_LOCK_DIR
  OPERATION_LOCK_DIR=$quarantine
  if ! inspect_operation_lock \
    || [[ "$INSPECTED_LOCK_DIR_IDENTITY" != "$expected_directory" \
    || "$INSPECTED_LOCK_OWNER_IDENTITY" != "$expected_owner" \
    || "$INSPECTED_LOCK_OWNER_DIGEST" != "$expected_digest" \
    || "$INSPECTED_LOCK_DIR_LINK_COUNT" != "$expected_directory_links" \
    || "$INSPECTED_LOCK_PID" != "$expected_pid" \
    || "$INSPECTED_LOCK_START" != "$expected_start" \
    || "$INSPECTED_LOCK_COMMAND" != "$expected_command" \
    || "$INSPECTED_LOCK_TOKEN" != "$expected_token" ]]; then
    OPERATION_LOCK_DIR=$original_lock_dir
    die "stale operation lock quarantine changed after move"
  fi
  OPERATION_LOCK_DIR=$original_lock_dir
  note "Retained stale operation lock quarantine: $quarantine"
}

acquire_operation_lock() { # command
  local attempt captured_identity cleanup_identity cleanup_failed=false
  OPERATION_LOCK_COMMAND=$1
  install_operation_cleanup_traps
  OPERATION_LOCK_TOKEN=$(generate_operation_token) \
    || die "cannot generate operation lock token"
  for attempt in 1 2; do
    begin_operation_signal_deferral
    if "$MKDIR_COMMAND" -m 700 -- "$OPERATION_LOCK_DIR" 2>/dev/null; then
      OPERATION_LOCK_PARTIAL=true
      if captured_identity=$(operation_path_identity "$OPERATION_LOCK_DIR"); then
        OPERATION_LOCK_DIR_IDENTITY=$captured_identity
        if ! "$CHMOD_COMMAND" -N "$OPERATION_LOCK_DIR"; then
          OPERATION_LOCK_PARTIAL=false
          end_operation_signal_deferral
          die "cannot remove operation lock directory ACL, operation lock retained at $OPERATION_LOCK_DIR"
        fi
        if ! "$CHMOD_COMMAND" 700 "$OPERATION_LOCK_DIR" \
            || ! private_directory_is_valid "$OPERATION_LOCK_DIR" \
              "$OPERATION_LOCK_DIR_IDENTITY" 700; then
          OPERATION_LOCK_PARTIAL=false
          end_operation_signal_deferral
          die "operation lock directory metadata is unsafe, operation lock retained at $OPERATION_LOCK_DIR"
        fi
        end_operation_signal_deferral
      else
        if cleanup_identity=$(operation_path_identity "$OPERATION_LOCK_DIR"); then
          OPERATION_LOCK_DIR_IDENTITY=$cleanup_identity
          cleanup_partial_operation_lock || cleanup_failed=true
        else
          cleanup_failed=true
        fi
        end_operation_signal_deferral
        if [[ "$cleanup_failed" == true ]]; then
          die "cannot capture partial operation lock identity, operation lock retained at $OPERATION_LOCK_DIR"
        fi
        die "cannot capture partial operation lock identity, partial operation lock removed"
      fi
      create_owned_operation_lock
      return 0
    fi
    end_operation_signal_deferral
    [[ "$attempt" -eq 1 ]] \
      || die "cannot acquire cooperative operation lock at $OPERATION_LOCK_DIR"
    inspect_operation_lock || die "malformed operation lock owner"
    classify_inspected_operation_lock
    case "$OPERATION_LOCK_CLASSIFICATION" in
      live)
        die "operation lock is held by live pid $INSPECTED_LOCK_PID command $INSPECTED_LOCK_COMMAND"
        ;;
      stale) quarantine_inspected_stale_operation_lock ;;
      ambiguous) die "cannot safely classify operation lock owner" ;;
    esac
  done
}

finish_operation_lock() {
  local release_failed=false
  begin_operation_signal_deferral
  release_owned_operation_lock || release_failed=true
  if [[ "$release_failed" == true ]]; then
    printf 'vaultlock: operation lock retained: %s\n' \
      "$OPERATION_LOCK_DIR" >&2
  fi
  end_operation_signal_deferral
  trap - EXIT HUP INT TERM
  [[ "$release_failed" == false ]]
}

plan_add_coordination_start() {
  plan_add operation_lock_acquire \
    "Acquire cooperative operation lock at $OPERATION_LOCK_DIR"
  plan_add operation_lock_quarantine \
    "Conditionally quarantine a verified stale operation lock"
}

plan_add_coordination_finish() {
  plan_add operation_lock_release "Release cooperative operation lock"
}

append_serialized_plan_field() { # name value
  SERIALIZED_PLAN_FIELD_NAMES+=("$1")
  SERIALIZED_PLAN_FIELD_VALUES+=("$2")
}

serialize_common_plan_fields() { # command
  local index argument_index locked hook_signature
  append_serialized_plan_field schema 1
  append_serialized_plan_field command "$1"
  append_serialized_plan_field option_dry_run "$OPTION_DRY_RUN"
  append_serialized_plan_field option_yes "$OPTION_YES"
  append_serialized_plan_field option_hooks "$OPTION_HOOKS"
  append_serialized_plan_field operands "$OPTION_OPERANDS"
  append_serialized_plan_field volume "$VOLUME"
  append_serialized_plan_field mount_point "$MOUNT_POINT"
  append_serialized_plan_field state_dir "$STATE_DIR"
  append_serialized_plan_field context_uuid "$PLAN_CONTEXT_UUID"
  append_serialized_plan_field context_device "$PLAN_CONTEXT_DEVICE"
  append_serialized_plan_field context_deadline "$PLAN_CONTEXT_DEADLINE"
  append_serialized_plan_field context_deadline_epoch \
    "$PLAN_CONTEXT_DEADLINE_EPOCH"
  append_serialized_plan_field context_round "$PLAN_CONTEXT_ROUND"
  append_serialized_plan_field snapshot_state_valid \
    "${SNAPSHOT_STATE_VALID:-}"
  append_serialized_plan_field snapshot_init_absent "$SNAPSHOT_INIT_ABSENT"
  append_serialized_plan_field snapshot_recorded_locked \
    "${SNAPSHOT_RECORDED_LOCKED:-}"
  append_serialized_plan_field snapshot_expected_uuid \
    "${SNAPSHOT_EXPECTED_UUID:-}"
  append_serialized_plan_field snapshot_apfs_valid \
    "${SNAPSHOT_APFS_VALID:-}"
  append_serialized_plan_field snapshot_apfs_locked \
    "${SNAPSHOT_APFS_LOCKED:-}"
  append_serialized_plan_field snapshot_apfs_mounted \
    "${SNAPSHOT_APFS_MOUNTED:-}"
  append_serialized_plan_field snapshot_apfs_inspected \
    "${SNAPSHOT_APFS_INSPECTED:-}"
  append_serialized_plan_field snapshot_valid "${SNAPSHOT_VALID:-}"
  append_serialized_plan_field snapshot_error "${SNAPSHOT_ERROR:-}"
  append_serialized_plan_field snapshot_deadline "${SNAPSHOT_DEADLINE:-}"
  append_serialized_plan_field snapshot_deadline_epoch \
    "${SNAPSHOT_DEADLINE_EPOCH:-}"
  append_serialized_plan_field snapshot_round "${SNAPSHOT_ROUND:-}"
  append_serialized_plan_field snapshot_actual_uuid \
    "${SNAPSHOT_ACTUAL_UUID:-}"
  append_serialized_plan_field snapshot_device "${SNAPSHOT_DEVICE:-}"
  append_serialized_plan_field snapshot_mount \
    "${SNAPSHOT_ACTUAL_MOUNT_POINT:-}"
  append_serialized_plan_field snapshot_plaintext \
    "${SNAPSHOT_PLAINTEXT_PRESENT:-}"
  append_serialized_plan_field snapshot_ciphertext \
    "${SNAPSHOT_CIPHERTEXT_PRESENT:-}"
  append_serialized_plan_field snapshot_hash "${SNAPSHOT_HASH_PRESENT:-}"
  append_serialized_plan_field assessment "${RUNTIME_ASSESSMENT:-}"
  for ((index=0; index<${#PLAN_OPERATION_IDS[@]}; index++)); do
    append_serialized_plan_field "operation_id_$index" \
      "${PLAN_OPERATION_IDS[$index]}"
    append_serialized_plan_field "hook_path_$index" \
      "${PLAN_HOOK_PATHS[$index]}"
    append_serialized_plan_field "hook_phase_$index" \
      "${PLAN_HOOK_PHASES[$index]}"
    append_serialized_plan_field "hook_scope_$index" \
      "${PLAN_HOOK_SCOPES[$index]}"
    append_serialized_plan_field "hook_directory_$index" \
      "${PLAN_HOOK_DIRECTORIES[$index]}"
    if [[ ( "$1" == unlock || "$1" == lock ) \
        && "${PLAN_OPERATION_IDS[$index]}" == hook ]]; then
      hook_signature=$(hook_file_signature \
        "${PLAN_HOOK_PATHS[$index]}") \
        || die "planned hook must remain an executable regular file or resolving symlink"
      append_serialized_plan_field "hook_signature_$index" \
        "$hook_signature"
    else
      append_serialized_plan_field "hook_signature_$index" ""
    fi
    if [[ "${PLAN_OPERATION_IDS[$index]}" == hook ]]; then
      locked=$(hook_locked_value "${PLAN_HOOK_PHASES[$index]}")
      build_hook_argv "${PLAN_HOOK_PHASES[$index]}" \
        "${PLAN_HOOK_SCOPES[$index]}" "$PLAN_CONTEXT_UUID" \
        "$PLAN_CONTEXT_DEVICE" "$PLAN_CONTEXT_DEADLINE" \
        "$PLAN_CONTEXT_DEADLINE_EPOCH" "$PLAN_CONTEXT_ROUND" "$locked"
      append_serialized_plan_field "hook_argv_count_$index" \
        "${#HOOK_ARGV[@]}"
      for ((argument_index=0; argument_index<${#HOOK_ARGV[@]}; \
          argument_index++)); do
        append_serialized_plan_field \
          "hook_argv_${index}_$argument_index" \
          "${HOOK_ARGV[$argument_index]}"
      done
    else
      append_serialized_plan_field "hook_argv_count_$index" 0
    fi
  done
}

serialize_planned_command_snapshot() { # target command
  local target=$1 command=$2 state_dir_identity state_file_identity index
  SERIALIZED_PLAN_FIELD_NAMES=()
  SERIALIZED_PLAN_FIELD_VALUES=()
  serialize_common_plan_fields "$command"
  case "$command" in
    init)
      if [[ -e "$STATE_DIR" || -L "$STATE_DIR" ]]; then
        state_dir_identity=$(path_identity "$STATE_DIR") || \
          die "cannot serialize $target state directory identity"
      else
        state_dir_identity=absent
      fi
      if [[ -e "$state_file" || -L "$state_file" ]]; then
        state_file_identity=$(path_identity "$state_file") || \
          die "cannot serialize $target state file identity"
      else
        state_file_identity=absent
      fi
      append_serialized_plan_field typed_operand_count 0
      append_serialized_plan_field state_dir_identity "$state_dir_identity"
      append_serialized_plan_field state_file_identity "$state_file_identity"
      ;;
    adopt)
      state_dir_identity=$(path_identity "$STATE_DIR") || \
        die "cannot serialize $target adopt state directory identity"
      state_file_identity=$(path_identity "$state_file") || \
        die "cannot serialize $target adopt state file identity"
      append_serialized_plan_field typed_operand_count 1
      append_serialized_plan_field state_dir_identity "$state_dir_identity"
      append_serialized_plan_field state_file_identity "$state_file_identity"
      append_serialized_plan_field adopt_reserved_state_dir \
        "$ADOPT_RESERVED_STATE_DIR"
      append_serialized_plan_field adopt_reserved_state_dir_identity \
        "$ADOPT_RESERVED_STATE_DIR_IDENTITY"
      append_serialized_plan_field adopt_reserved_state_file \
        "$ADOPT_RESERVED_STATE_FILE"
      append_serialized_plan_field adopt_reserved_state_file_identity \
        "$ADOPT_RESERVED_STATE_FILE_IDENTITY"
      append_serialized_plan_field adopt_reserved_operation_lock \
        "$ADOPT_RESERVED_OPERATION_LOCK"
      append_serialized_plan_field typed_operand_0_name source
      append_serialized_plan_field typed_operand_0_value "$ADOPT_SOURCE"
      append_serialized_plan_field adopt_source_identity \
        "$ADOPT_SOURCE_IDENTITY"
      append_serialized_plan_field adopt_source_device "$ADOPT_SOURCE_DEVICE"
      append_serialized_plan_field adopt_parent "$ADOPT_PARENT"
      append_serialized_plan_field adopt_parent_identity \
        "$ADOPT_PARENT_IDENTITY"
      append_serialized_plan_field adopt_destination "$ADOPT_DESTINATION"
      append_serialized_plan_field adopt_destination_identity \
        "$ADOPT_DESTINATION_IDENTITY"
      append_serialized_plan_field adopt_destination_device \
        "$ADOPT_DESTINATION_DEVICE"
      ;;
    unlock)
      append_serialized_plan_field typed_operand_count 0
      append_serialized_plan_field unlock_state_dir_identity \
        "$UNLOCK_STATE_DIR_IDENTITY"
      append_serialized_plan_field unlock_state_file_signature \
        "$UNLOCK_STATE_FILE_SIGNATURE"
      append_serialized_plan_field unlock_plaintext_signature \
        "$UNLOCK_PLAINTEXT_SIGNATURE"
      append_serialized_plan_field unlock_ciphertext_signature \
        "$UNLOCK_CIPHERTEXT_SIGNATURE"
      append_serialized_plan_field unlock_hash_signature \
        "$UNLOCK_HASH_SIGNATURE"
      append_serialized_plan_field unlock_keychain_present \
        "$UNLOCK_KEYCHAIN_PRESENT"
      append_serialized_plan_field unlock_keychain_match \
        "$UNLOCK_KEYCHAIN_MATCH"
      append_serialized_plan_field unlock_keychain_digest \
        "$UNLOCK_KEYCHAIN_DIGEST"
      append_serialized_plan_field unlock_actual_apfs_unlock \
        "$UNLOCK_ACTUAL_APFS_UNLOCK"
      ;;
    lock)
      append_serialized_plan_field typed_operand_count 1
      append_serialized_plan_field typed_operand_0_name deadline_expression
      append_serialized_plan_field typed_operand_0_value "$OPTION_OPERANDS"
      append_serialized_plan_field lock_state_dir_identity \
        "$LOCK_STATE_DIR_IDENTITY"
      append_serialized_plan_field lock_state_file_signature \
        "$LOCK_STATE_FILE_SIGNATURE"
      append_serialized_plan_field lock_plaintext_signature \
        "$LOCK_PLAINTEXT_SIGNATURE"
      append_serialized_plan_field lock_ciphertext_signature \
        "$LOCK_CIPHERTEXT_SIGNATURE"
      append_serialized_plan_field lock_hash_signature \
        "$LOCK_HASH_SIGNATURE"
      append_serialized_plan_field lock_keychain_present \
        "$LOCK_KEYCHAIN_PRESENT"
      append_serialized_plan_field lock_keychain_match "$LOCK_KEYCHAIN_MATCH"
      append_serialized_plan_field lock_keychain_digest "$LOCK_KEYCHAIN_DIGEST"
      append_serialized_plan_field lock_secure_noop "$LOCK_SECURE_NOOP"
      append_serialized_plan_field lock_repair_only "$LOCK_REPAIR_ONLY"
      append_serialized_plan_field lock_artifact_count \
        "${#LOCK_ARTIFACT_PATHS[@]}"
      for ((index=0; index<${#LOCK_ARTIFACT_PATHS[@]}; index++)); do
        append_serialized_plan_field \
          "lock_artifact_path_$index" "${LOCK_ARTIFACT_PATHS[$index]}"
      done
      ;;
  esac
}

copy_serialized_plan_snapshot() { # target
  case "$1" in
    frozen)
      FROZEN_PLAN_FIELD_NAMES=("${SERIALIZED_PLAN_FIELD_NAMES[@]}")
      FROZEN_PLAN_FIELD_VALUES=("${SERIALIZED_PLAN_FIELD_VALUES[@]}")
      ;;
    candidate)
      CANDIDATE_PLAN_FIELD_NAMES=("${SERIALIZED_PLAN_FIELD_NAMES[@]}")
      CANDIDATE_PLAN_FIELD_VALUES=("${SERIALIZED_PLAN_FIELD_VALUES[@]}")
      ;;
    *) die "unknown plan snapshot target: $1" ;;
  esac
}

freeze_planned_command_snapshot() { # command
  serialize_planned_command_snapshot frozen "$1"
  copy_serialized_plan_snapshot frozen
}

capture_candidate_planned_command_snapshot() { # command
  serialize_planned_command_snapshot candidate "$1"
  copy_serialized_plan_snapshot candidate
}

compare_frozen_candidate_plan_snapshots() {
  local index
  [[ "${#FROZEN_PLAN_FIELD_NAMES[@]}" \
    -eq "${#CANDIDATE_PLAN_FIELD_NAMES[@]}" ]] || return 1
  for ((index=0; index<${#FROZEN_PLAN_FIELD_NAMES[@]}; index++)); do
    [[ "${FROZEN_PLAN_FIELD_NAMES[$index]}" \
      == "${CANDIDATE_PLAN_FIELD_NAMES[$index]}" \
      && "${FROZEN_PLAN_FIELD_VALUES[$index]}" \
      == "${CANDIDATE_PLAN_FIELD_VALUES[$index]}" ]] || return 1
  done
}

revalidate_plan_under_operation_lock() { # command
  local command=$1
  case "$command" in
    init)
      run_named_transition plan_revalidation_before_inspection "$state_file"
      [[ ! -e "$state_file" && ! -L "$state_file" ]] \
        || die "plan changed after operation lock acquisition: state already exists"
      inspect_init_absent_state
      ;;
    adopt)
      run_named_transition plan_revalidation_before_inspection "$ADOPT_SOURCE"
      inspect_adopt_state
      ;;
    unlock)
      run_named_transition plan_revalidation_before_inspection "$state_file"
      inspect_runtime_state
      classify_runtime_state
      revalidate_unlock_inputs_before_candidate_plan
      ;;
    lock)
      run_named_transition plan_revalidation_before_inspection "$state_file"
      inspect_runtime_state
      classify_runtime_state
      capture_lock_artifact_inventory
      [[ "${#LOCK_ARTIFACT_PATHS[@]}" -eq 0 ]] \
        || die "plan changed after operation lock acquisition: lock staging artifact must be resolved"
      ;;
  esac
  plan_reset
  plan_add_coordination_start
  case "$command" in
    init) build_init_plan ;;
    adopt) build_adopt_plan ;;
    lock) build_lock_plan ;;
    unlock) build_unlock_plan ;;
  esac
  plan_add_coordination_finish
  capture_candidate_planned_command_snapshot "$command"
  compare_frozen_candidate_plan_snapshots \
    || die "plan changed after operation lock acquisition"
}

plan_reset() {
  PLAN_OPERATION_IDS=()
  PLAN_OPERATION_TEXT=()
  PLAN_HOOK_PATHS=()
  PLAN_HOOK_PHASES=()
  PLAN_HOOK_SCOPES=()
  PLAN_HOOK_DIRECTORIES=()
  PLAN_TARGET_TEXT=""
  PLAN_REQUEST_TEXT=""
}

plan_append_internal() { # operation_id text hook_path phase scope directory
  PLAN_OPERATION_IDS+=("$1")
  PLAN_OPERATION_TEXT+=("$2")
  PLAN_HOOK_PATHS+=("$3")
  PLAN_HOOK_PHASES+=("$4")
  PLAN_HOOK_SCOPES+=("$5")
  PLAN_HOOK_DIRECTORIES+=("$6")
}

validate_plan_hook_coordinates() { # phase scope
  case "$1" in
    pre-lock|post-lock|pre-unlock|post-unlock) ;;
    *) die "unknown hook phase: $1" ;;
  esac
  case "$2" in
    global|vault) ;;
    *) die "unknown hook scope: $2" ;;
  esac
}

plan_add() { # operation_id public_description
  local operation_id=$1 public_description=$2

  [[ "$operation_id" != "hook" ]] \
    || die "hook operations require plan_add_hook"
  [[ "$operation_id" != "deferred_hook_discovery" ]] \
    || die "deferred hook discovery requires plan_add_deferred_hook"

  case "$operation_id" in
    repair_verify_plaintext|repair_unlock_apfs|repair_mount|verify_mount_identity|\
hooks_disabled|tm_exclude_state|tm_exclude|\
tm_delete_vault_snapshots|unmount_vault|stage_recovery|rotate_apfs_recovery|\
keychain_update|\
tle_encrypt|tle_verify_future|persist_locked_recovery|remove_plaintext|\
tm_delete_data_snapshots|apfs_lock|verify_locked_postconditions|tle_decrypt|\
verify_decrypted_hash|apfs_unlock|persist_plaintext|persist_unlocked_state|\
verify_secure_target|verify_unlocked_target|\
    init_prepare_state|init_create_volume|init_write_state|\
    adopt_copy|adopt_verify|adopt_replace_source|\
    operation_lock_acquire|operation_lock_quarantine|operation_lock_release)
      ;;
    *)
      die "unknown plan operation ID: $operation_id"
      ;;
  esac

  plan_append_internal "$operation_id" "$public_description" "" "" "" ""
}

plan_add_hook() { # phase scope path
  local phase=$1 scope=$2 path=$3

  validate_plan_hook_coordinates "$phase" "$scope"
  [[ -n "$path" ]] || die "hook plan path is empty"
  plan_append_internal hook "Run hook" "$path" "$phase" "$scope" ""
}

plan_add_deferred_hook() { # phase scope directory
  local phase=$1 scope=$2 directory=$3

  validate_plan_hook_coordinates "$phase" "$scope"
  [[ -n "$directory" ]] || die "deferred hook directory is empty"
  plan_append_internal deferred_hook_discovery "Deferred hook discovery" \
    "" "$phase" "$scope" "$directory"
}

build_hook_argv() { # phase scope uuid device deadline epoch round locked
  local phase=$1 scope=$2 uuid=$3 device=$4 deadline=$5 epoch=$6 round=$7
  local locked=$8

  HOOK_ARGV=(
    --phase "$phase"
    --scope "$scope"
    --volume "$VOLUME"
    --mount-point "$MOUNT_POINT"
    --volume-uuid "$uuid"
    --device "$device"
    --state-dir "$STATE_DIR"
    --state-file "$state_file"
    --deadline "$deadline"
    --deadline-epoch "$epoch"
    --round "$round"
    --locked "$locked"
  )
}

hook_locked_value() { # phase
  case "$1" in
    pre-lock|post-unlock) printf 'false\n' ;;
    post-lock|pre-unlock) printf 'true\n' ;;
    *) die "unknown hook phase: $1" ;;
  esac
}

render_hook_plan_item() { # index
  local index=$1 phase scope path locked argument
  phase=${PLAN_HOOK_PHASES[$index]}
  scope=${PLAN_HOOK_SCOPES[$index]}
  path=${PLAN_HOOK_PATHS[$index]}
  locked=$(hook_locked_value "$phase")
  build_hook_argv "$phase" "$scope" "$PLAN_CONTEXT_UUID" \
    "$PLAN_CONTEXT_DEVICE" "$PLAN_CONTEXT_DEADLINE" \
    "$PLAN_CONTEXT_DEADLINE_EPOCH" "$PLAN_CONTEXT_ROUND" "$locked"

  printf 'Run hook %q' "$path"
  for argument in "${HOOK_ARGV[@]}"; do
    printf ' %q' "$argument"
  done
  printf '\n'
}

render_deferred_hook_plan_item() { # index
  local index=$1 phase scope directory
  phase=${PLAN_HOOK_PHASES[$index]}
  scope=${PLAN_HOOK_SCOPES[$index]}
  directory=${PLAN_HOOK_DIRECTORIES[$index]}
  printf 'Defer %s %s hook discovery in %q until the expected vault is mounted and verified\n' \
    "$phase" "$scope" "$directory"
}

render_confirmation_requirement() { # command
  local command=$1

  printf 'Confirmation:\n'
  if [[ "$command" != "unlock" ]]; then
    if [[ "$OPTION_YES" == "true" ]]; then
      printf '  Not required for normal execution because --yes was supplied\n'
    else
      printf '  Required before normal execution changes the vault\n'
    fi
  else
    printf '  Not required for unlock\n'
  fi
}

render_plan() { # command
  local command=$1 index

  printf 'Vaultlock plan: %s %s\n' "$command" "$VOLUME"
  printf 'Current state:\n'
  render_runtime_summary
  printf 'Target: %s\n' "$PLAN_TARGET_TEXT"
  [[ -z "$PLAN_REQUEST_TEXT" ]] || printf '%s\n' "$PLAN_REQUEST_TEXT"
  printf 'Actions:\n'
  for ((index=0; index<${#PLAN_OPERATION_IDS[@]}; index++)); do
    printf '  %d. ' "$((index + 1))"
    case "${PLAN_OPERATION_IDS[$index]}" in
      hook) render_hook_plan_item "$index" ;;
      deferred_hook_discovery) render_deferred_hook_plan_item "$index" ;;
      *) printf '%s\n' "${PLAN_OPERATION_TEXT[$index]}" ;;
    esac
  done
  render_confirmation_requirement "$command"
}

# Resolve the volume's current device node (diskXsY) from its stable UUID.
# Device numbers can change across reboots, the UUID cannot.
vol_device() {
    diskutil info -plist "$(vol_uuid)" | plutil -extract DeviceIdentifier raw -o - -
}

verify_mount_identity() { # expected_uuid expected_device
    local expected_uuid=$1 expected_device=$2 plist actual_uuid actual_device

    if plist=$(diskutil info -plist "$MOUNT_POINT" 2>/dev/null); then
        actual_uuid=$(printf '%s' "$plist" \
            | plutil -extract VolumeUUID raw -o - - 2>/dev/null) \
            || actual_uuid='<unavailable>'
        actual_device=$(printf '%s' "$plist" \
            | plutil -extract DeviceIdentifier raw -o - - 2>/dev/null) \
            || actual_device='<unavailable>'
    else
        actual_uuid='<unavailable>'
        actual_device='<unavailable>'
    fi

    if [[ "$actual_uuid" == "$expected_uuid" \
        && "$actual_device" == "$expected_device" ]]; then
        return 0
    fi

    printf 'vaultlock: mount identity mismatch at %s: expected UUID %s device %s, got UUID %s device %s\n' \
        "$MOUNT_POINT" "$expected_uuid" "$expected_device" \
        "$actual_uuid" "$actual_device" >&2
    return 1
}

run_hook_file() { # mode phase scope hook uuid device deadline epoch round locked
  local mode=$1 phase=$2 scope=$3 hook=$4 uuid=$5 device=$6
  local deadline=$7 deadline_epoch=$8 round=$9
  shift 9
  local locked=$1 status

  build_hook_argv "$phase" "$scope" "$uuid" "$device" "$deadline" \
    "$deadline_epoch" "$round" "$locked"

  note "running $phase $scope hook: $hook"
  if "$hook" "${HOOK_ARGV[@]}"; then
    return 0
  else
    status=$?
  fi
  printf 'vaultlock: %s %s hook failed with exit %s: %s\n' \
    "$phase" "$scope" "$status" "$hook" >&2
  [[ "$mode" == "post" ]] && return 1
  return "$status"
}

discover_hooks_reset() {
  DISCOVERED_HOOK_PATHS=()
  DISCOVERED_HOOK_SCOPES=()
}

discover_hook_file() { # path scope
  local path=$1 scope=$2

  [[ -f "$path" && -x "$path" ]] || return 0
  DISCOVERED_HOOK_PATHS+=("$path")
  DISCOVERED_HOOK_SCOPES+=("$scope")
}

discover_hook_directory() { # directory scope
    local directory=$1 scope=$2 hook
    local previous_lc=${LC_ALL-} previous_globignore=${GLOBIGNORE-}
    local -i had_lc=0 had_globignore=0 globignore_exported=0 had_noglob=0
    local -i had_dotglob=0 had_failglob=0 had_nullglob=0
    local -a hooks

    [[ -d "$directory" ]] || return 0
    [[ ${LC_ALL+x} ]] && had_lc=1
    [[ ${GLOBIGNORE+x} ]] && had_globignore=1
    if export -p GLOBIGNORE >/dev/null 2>&1; then globignore_exported=1; fi
    [[ $- == *f* ]] && had_noglob=1
    if shopt -q dotglob; then had_dotglob=1; fi
    if shopt -q failglob; then had_failglob=1; fi
    if shopt -q nullglob; then had_nullglob=1; fi

    set +f
    shopt -u dotglob failglob
    shopt -s nullglob
    unset GLOBIGNORE
    LC_ALL=C
    hooks=("$directory"/*)

    if (( had_lc )); then LC_ALL=$previous_lc; else unset LC_ALL; fi
    if (( had_globignore )); then
        GLOBIGNORE=$previous_globignore
        if (( globignore_exported )); then export GLOBIGNORE; fi
    else
        unset GLOBIGNORE
    fi
    if (( had_dotglob )); then shopt -s dotglob; else shopt -u dotglob; fi
    if (( had_failglob )); then shopt -s failglob; else shopt -u failglob; fi
    if (( had_nullglob )); then shopt -s nullglob; else shopt -u nullglob; fi
    if (( had_noglob )); then set -f; else set +f; fi

    for hook in "${hooks[@]}"; do
      discover_hook_file "$hook" "$scope"
    done
}

plan_test_hook_phase() { # phase
  local phase=$1
  plan_reset
  case "$phase" in
    pre-lock)
      verify_mount_identity "$PLAN_CONTEXT_UUID" "$PLAN_CONTEXT_DEVICE" \
        || return
      plan_discovered_hook_file pre-lock global "$STATE_DIR/pre-lock.sh"
      plan_discovered_hook_directory pre-lock global \
        "$STATE_DIR/hooks/pre-lock.d"
      plan_discovered_hook_directory pre-lock vault \
        "$MOUNT_POINT/.vaultlock/hooks/pre-lock.d"
      ;;
    post-lock)
      plan_discovered_hook_directory post-lock global \
        "$STATE_DIR/hooks/post-lock.d"
      ;;
    pre-unlock)
      plan_discovered_hook_directory pre-unlock global \
        "$STATE_DIR/hooks/pre-unlock.d"
      ;;
    post-unlock)
      verify_mount_identity "$PLAN_CONTEXT_UUID" "$PLAN_CONTEXT_DEVICE" \
        || return
      plan_discovered_hook_directory post-unlock vault \
        "$MOUNT_POINT/.vaultlock/hooks/post-unlock.d"
      plan_discovered_hook_directory post-unlock global \
        "$STATE_DIR/hooks/post-unlock.d"
      ;;
    *) die "unknown hook phase: $phase" ;;
  esac
}

freeze_test_hook_plan() { # phase
  local command=unlock
  [[ "$1" == *-lock ]] && command=lock
  SERIALIZED_PLAN_FIELD_NAMES=()
  SERIALIZED_PLAN_FIELD_VALUES=()
  serialize_common_plan_fields "$command"
  copy_serialized_plan_snapshot frozen
}

execute_test_hook_plan() { # phase
  local phase=$1 index status
  local -i failed=0
  for ((index=0; index<${#PLAN_OPERATION_IDS[@]}; index++)); do
    [[ "${PLAN_OPERATION_IDS[$index]}" == hook ]] || continue
    [[ -f "${PLAN_HOOK_PATHS[$index]}" \
      && -x "${PLAN_HOOK_PATHS[$index]}" ]] || continue
    if [[ "$phase" == pre-lock || "$phase" == post-unlock ]]; then
      verify_mount_identity "$PLAN_CONTEXT_UUID" "$PLAN_CONTEXT_DEVICE" \
        || return
    fi
    if run_verified_planned_hook "$index"; then
      continue
    else
      status=$?
    fi
    [[ "$phase" == pre-* ]] && return "$status"
    failed=1
  done
  (( failed == 0 ))
}

run_test_hook_phase() { # phase uuid device deadline epoch round locked
  local phase=$1
  PLAN_CONTEXT_UUID=$2
  PLAN_CONTEXT_DEVICE=$3
  PLAN_CONTEXT_DEADLINE=$4
  PLAN_CONTEXT_DEADLINE_EPOCH=$5
  PLAN_CONTEXT_ROUND=$6
  [[ "$(hook_locked_value "$phase")" == "$7" ]] \
    || die "hook locked argument does not match phase"
  plan_test_hook_phase "$phase"
  freeze_test_hook_plan "$phase"
  execute_test_hook_plan "$phase"
}

inspect_init_volume_absence() {
  local apfs_plist apfs_json invalid_record_count conflict_count
  apfs_plist=$(diskutil apfs list -plist "$CONTAINER" 2>/dev/null) \
    || die "cannot inspect APFS volumes for init"
  printf '%s' "$apfs_plist" | plutil -lint - >/dev/null 2>&1 \
    || die "cannot inspect APFS volumes for init: malformed property list"
  apfs_json=$(printf '%s' "$apfs_plist" \
    | plutil -convert json -o - - 2>/dev/null) \
    || die "cannot inspect APFS volumes for init: conversion failed"
  printf '%s' "$apfs_json" | jq -e \
    'type == "object"
      and (.Containers | type == "array")
      and (.Containers | length > 0)
      and all(.Containers[];
        type == "object"
          and (.Volumes | type == "array")
          and all(.Volumes[]; type == "object"))' \
    >/dev/null 2>&1 \
    || die "cannot inspect APFS volumes for init: invalid APFS list schema"
  invalid_record_count=$(printf '%s' "$apfs_json" | jq -er \
      --arg volume "$VOLUME" \
      '[.Containers[].Volumes[] | select(
        (.Name? == $volume or .VolumeName? == $volume)
        and ((.VolumeUUID? | type) != "string"
          or (.VolumeUUID | length) == 0
          or (.DeviceIdentifier? | type) != "string"
          or (.DeviceIdentifier | length) == 0)
      )] | length' 2>/dev/null) \
    || die "cannot inspect APFS volumes for init: invalid converted data"
  [[ "$invalid_record_count" =~ ^[0-9]+$ ]] \
    || die "cannot inspect APFS volumes for init: invalid record count"
  if (( invalid_record_count > 0 )); then
    die "cannot inspect APFS volumes for init: vault volume record missing UUID or device"
  fi
  printf '%s' "$apfs_json" | jq -e \
    'all(.Containers[].Volumes[];
      ((has("Name") | not)
        or ((.Name | type) == "string" and (.Name | length) > 0))
      and ((has("VolumeName") | not)
        or ((.VolumeName | type) == "string" and (.VolumeName | length) > 0))
      and (has("Name") or has("VolumeName"))
      and ((.VolumeUUID | type) == "string"
        and (.VolumeUUID | length) > 0)
      and ((.DeviceIdentifier | type) == "string"
        and (.DeviceIdentifier
          | test("^disk[1-9][0-9]*s[1-9][0-9]*$")))
      and ((has("MountPoint") | not)
        or (.MountPoint | type) == "string"))' \
    >/dev/null 2>&1 \
    || die "cannot inspect APFS volumes for init: invalid APFS list schema"
  conflict_count=$(printf '%s' "$apfs_json" | jq -er \
      --arg volume "$VOLUME" --arg mount "$MOUNT_POINT" \
      '[.Containers[].Volumes[] | select(
        (.Name? == $volume or .VolumeName? == $volume)
        or .MountPoint? == $mount
      )] | length' 2>/dev/null) \
    || die "cannot inspect APFS volumes for init: invalid converted data"
  [[ "$conflict_count" =~ ^[0-9]+$ ]] \
    || die "cannot inspect APFS volumes for init: invalid conflict count"
  if (( conflict_count > 0 )); then
    die "volume $VOLUME already exists"
  fi
}

inspect_init_absent_state() {
  local artifact
  preflight_init_dependencies
  SNAPSHOT_RECORDED_LOCKED=unknown
  SNAPSHOT_APFS_LOCKED=unknown
  SNAPSHOT_APFS_MOUNTED=unknown
  SNAPSHOT_EXPECTED_UUID=unknown
  SNAPSHOT_ACTUAL_UUID=unknown
  SNAPSHOT_DEVICE=unknown
  SNAPSHOT_ACTUAL_MOUNT_POINT=""
  SNAPSHOT_DEADLINE=null
  SNAPSHOT_DEADLINE_EPOCH=null
  SNAPSHOT_ROUND=null
  SNAPSHOT_PLAINTEXT_PRESENT=false
  SNAPSHOT_CIPHERTEXT_PRESENT=false
  SNAPSHOT_HASH_PRESENT=false
  SNAPSHOT_STATE_VALID=false
  SNAPSHOT_APFS_VALID=false
  SNAPSHOT_APFS_INSPECTED=false
  SNAPSHOT_INIT_ABSENT=false
  SNAPSHOT_VALID=false
  SNAPSHOT_ERROR="state file is absent"
  RUNTIME_ASSESSMENT="not initialized"

  command -v jq >/dev/null || die "jq is required"
  command -v plutil >/dev/null || die "plutil is required"
  if [[ -e "$STATE_DIR" || -L "$STATE_DIR" ]]; then
    [[ -d "$STATE_DIR" && ! -L "$STATE_DIR" ]] \
      || die "state directory is not a real directory: $STATE_DIR"
  fi
  [[ ! -e "$state_file" && ! -L "$state_file" ]] \
    || die "state already exists at $state_file"
  [[ ! -e "$STATE_DIR/passphrase.txt" \
      && ! -L "$STATE_DIR/passphrase.txt" \
      && ! -e "$STATE_DIR/passphrase-new.txt" \
      && ! -L "$STATE_DIR/passphrase-new.txt" \
      && ! -e "$STATE_DIR/passphrase.tle" \
      && ! -L "$STATE_DIR/passphrase.tle" \
      && ! -e "$STATE_DIR/passphrase.sha256" \
    && ! -L "$STATE_DIR/passphrase.sha256" ]] \
    || die "recovery artifacts already exist in $STATE_DIR"
  for artifact in "$STATE_DIR"/.passphrase.* "$STATE_DIR"/.state.* \
      "$STATE_DIR"/.security-output.*; do
    [[ ! -e "$artifact" && ! -L "$artifact" ]] \
      || die "unexpected init artifact exists: $artifact"
  done
  inspect_init_volume_absence
  SNAPSHOT_APFS_INSPECTED=true
  SNAPSHOT_INIT_ABSENT=true
}

build_init_plan() {
  PLAN_TARGET_TEXT="an initialized, unlocked, mounted vault at $MOUNT_POINT"
  plan_add init_prepare_state \
    "Prepare protected state and generate recovery material"
  plan_add init_create_volume \
    "Store recovery material in the keychain and create the encrypted APFS volume"
  plan_add init_write_state \
    "Discover the new volume identity and write initial unlocked state"
}

safe_public_token() { [[ -n "$1" && "$1" =~ ^[A-Za-z0-9._@+-]+$ ]]; }
safe_base64_token() { [[ -n "$1" && "$1" =~ ^[A-Za-z0-9+/]+={0,2}$ ]]; }

preflight_keychain_target() {
  require_command security
  safe_public_token "${USER:-}" \
    || die "USER is missing or unsafe for keychain storage"
  safe_public_token "$KEYCHAIN_SERVICE" \
    || die "keychain service is unsafe for keychain storage"
}

require_command() { # command
  command -v "$1" >/dev/null 2>&1 || die "$1 is required"
}

require_executable() { # path description
  [[ -x "$1" ]] || die "$2 is required at $1"
}

preflight_init_dependencies() {
  local command
  for command in security sudo head base64 mktemp; do
    require_command "$command"
  done
  safe_public_token "${USER:-}" || die "USER is missing or unsafe"
  safe_public_token "$KEYCHAIN_SERVICE" || die "keychain service is unsafe"
}

preflight_adopt_dependencies() {
  require_executable "$DITTO_COMMAND" ditto
  require_executable "$BSD_FIND" "BSD find"
  require_executable "$BSD_LS" "BSD ls"
  require_executable "$BSD_STAT" "BSD stat"
  require_executable /usr/bin/shasum shasum
  require_executable /usr/bin/cmp cmp
  require_executable /usr/bin/sed sed
  require_executable /usr/bin/sort sort
  require_executable /usr/bin/tr tr
  require_executable /usr/bin/xattr xattr
  require_executable /usr/bin/xxd xxd
}

keychain_store_passphrase() { # passphrase
  local passphrase
  export -n passphrase 2>/dev/null || true
  passphrase=$1
  preflight_keychain_target
  safe_base64_token "$passphrase" \
    || die "generated recovery material is not valid base64"
  printf 'add-generic-password -a %s -s %s -w %s -U\n' \
    "$USER" "$KEYCHAIN_SERVICE" "$passphrase" \
    | security -i >/dev/null 2>&1
}

init_path_acl_is_absent() { # path
  local listing
  listing=$(LC_ALL=C "$BSD_LS" -ldeB -- "$1" 2>/dev/null) || return 1
  [[ "$listing" != *$'\n'* ]]
}

init_path_metadata() { # path
  "$BSD_STAT" -f '%d:%i:%Lp:%u:%l' -- "$1" 2>/dev/null
}

init_state_dir_is_valid() {
  local metadata device inode mode owner link_count
  metadata=$(init_path_metadata "$STATE_DIR") || return 1
  IFS=: read -r device inode mode owner link_count <<< "$metadata"
  [[ "$device:$inode" == "$INIT_STATE_DIR_IDENTITY" \
      && "$mode" == 700 && "$owner" == "$UID" \
      && "$INIT_STATE_DIR_LINK_COUNT" =~ ^[1-9][0-9]*$ \
      && "$link_count" =~ ^[1-9][0-9]*$ \
      && -d "$STATE_DIR" && ! -L "$STATE_DIR" ]] \
    || return 1
  (( link_count >= INIT_STATE_DIR_LINK_COUNT )) || return 1
  init_path_acl_is_absent "$STATE_DIR"
}

require_init_state_dir_identity() {
  init_state_dir_is_valid \
    || die "state directory metadata changed during init"
}

installed_init_recovery_is_valid() {
  local metadata device inode mode owner link_count actual_content
  export -n actual_content 2>/dev/null || true
  init_state_dir_is_valid || return 1
  metadata=$(init_path_metadata "$INIT_RECOVERY_PATH") || return 1
  IFS=: read -r device inode mode owner link_count <<< "$metadata"
  [[ "$device:$inode" == "$INIT_RECOVERY_IDENTITY" \
      && "$mode" == 600 && "$owner" == "$UID" \
      && "$link_count" == 1 \
      && -f "$INIT_RECOVERY_PATH" && ! -L "$INIT_RECOVERY_PATH" ]] \
    || return 1
  init_path_acl_is_absent "$INIT_RECOVERY_PATH" || return 1
  actual_content=$(cat -- "$INIT_RECOVERY_PATH" && printf '\034') \
    || return 1
  metadata=$(init_path_metadata "$INIT_RECOVERY_PATH") || return 1
  IFS=: read -r device inode mode owner link_count <<< "$metadata"
  [[ -n "$INIT_RECOVERY_IDENTITY" \
      && "$device:$inode" == "$INIT_RECOVERY_IDENTITY" \
      && "$mode" == 600 && "$owner" == "$UID" \
      && "$link_count" == 1 \
      && "$actual_content" == "$INIT_PASSPHRASE"$'\034' ]] \
    && init_path_acl_is_absent "$INIT_RECOVERY_PATH"
}

verify_installed_init_recovery() { # phase
  local phase=$1
  installed_init_recovery_is_valid \
    || die "installed recovery material changed before $phase"
}

execute_init_prepare_state() {
  local metadata device inode mode owner link_count
  local recovery_identity installed_identity recovery_hash
  if [[ ! -e "$STATE_DIR" && ! -L "$STATE_DIR" ]]; then
    mkdir -m 700 "$STATE_DIR" || die "cannot create protected state directory"
  fi
  [[ -d "$STATE_DIR" && ! -L "$STATE_DIR" ]] \
    || die "state directory is not a real directory: $STATE_DIR"
  "$CHMOD_COMMAND" -N "$STATE_DIR" \
    || die "cannot remove state directory ACL"
  "$CHMOD_COMMAND" 700 "$STATE_DIR" \
    || die "cannot protect state directory"
  metadata=$(init_path_metadata "$STATE_DIR") \
    || die "cannot capture state directory identity"
  IFS=: read -r device inode mode owner link_count <<< "$metadata"
  [[ "$mode" == 700 && "$owner" == "$UID" \
      && "$link_count" =~ ^[1-9][0-9]*$ \
      && -d "$STATE_DIR" && ! -L "$STATE_DIR" ]] \
    || die "state directory metadata is unsafe"
  init_path_acl_is_absent "$STATE_DIR" \
    || die "state directory ACL remains after removal"
  INIT_STATE_DIR_IDENTITY=$device:$inode
  INIT_STATE_DIR_LINK_COUNT=$link_count
  require_init_state_dir_identity
  umask 077
  INIT_RECOVERY_PATH=$(mktemp "$STATE_DIR/.passphrase.XXXXXX") \
    || die "cannot create protected recovery staging file"
  "$CHMOD_COMMAND" -N "$INIT_RECOVERY_PATH" \
    || die "cannot remove recovery staging ACL"
  "$CHMOD_COMMAND" 600 "$INIT_RECOVERY_PATH" \
    || die "cannot protect recovery staging file"
  metadata=$(init_path_metadata "$INIT_RECOVERY_PATH") \
    || die "cannot capture recovery staging identity"
  IFS=: read -r device inode mode owner link_count <<< "$metadata"
  [[ "$mode" == 600 && "$owner" == "$UID" && "$link_count" == 1 \
      && -f "$INIT_RECOVERY_PATH" && ! -L "$INIT_RECOVERY_PATH" ]] \
    || die "recovery staging metadata is unsafe"
  init_path_acl_is_absent "$INIT_RECOVERY_PATH" \
    || die "recovery staging ACL remains after removal"
  recovery_identity=$device:$inode
  INIT_PASSPHRASE=$(head -c 32 /dev/urandom | base64 | tr -d '\n') \
    || die "recovery material generation failed"
  safe_base64_token "$INIT_PASSPHRASE" \
    || die "recovery material generation returned invalid base64"
  printf '%s' "$INIT_PASSPHRASE" > "$INIT_RECOVERY_PATH" \
    || die "cannot write protected recovery material"
  metadata=$(init_path_metadata "$INIT_RECOVERY_PATH") \
    || die "recovery staging identity is unavailable after generation"
  IFS=: read -r device inode mode owner link_count <<< "$metadata"
  installed_identity=$device:$inode
  [[ "$installed_identity" == "$recovery_identity" \
      && "$mode" == 600 && "$owner" == "$UID" && "$link_count" == 1 ]] \
    || die "recovery staging identity changed during initialization"
  init_path_acl_is_absent "$INIT_RECOVERY_PATH" \
    || die "recovery staging ACL changed during initialization"
  require_init_state_dir_identity
  if ! ln -- "$INIT_RECOVERY_PATH" "$STATE_DIR/passphrase.txt"; then
    die "recovery path appeared during initialization, protected material remains at $INIT_RECOVERY_PATH"
  fi
  metadata=$(init_path_metadata "$STATE_DIR/passphrase.txt") \
    || die "installed recovery identity is unavailable"
  IFS=: read -r device inode mode owner link_count <<< "$metadata"
  installed_identity=$device:$inode
  [[ "$installed_identity" == "$recovery_identity" \
      && "$mode" == 600 && "$owner" == "$UID" && "$link_count" == 2 ]] \
    || die "installed recovery identity mismatch"
  init_path_acl_is_absent "$STATE_DIR/passphrase.txt" \
    || die "installed recovery ACL is unsafe"
  INIT_RECOVERY_IDENTITY=$installed_identity
  rm -f -- "$INIT_RECOVERY_PATH" \
    || die "cannot remove recovery staging name"
  INIT_RECOVERY_PATH="$STATE_DIR/passphrase.txt"
  installed_init_recovery_is_valid \
    || die "installed recovery material changed before volume creation"
  recovery_hash=$(sha256_of "$INIT_PASSPHRASE") \
    || die "cannot hash initialized recovery material"
  install_private_state_file "$STATE_DIR/passphrase.sha256" \
    "$recovery_hash" "recovery hash"
}

created_device_from_add_output() { # output
  local output=$1 line candidate device=""
  local completion_prefix="Disk from APFS operation: "
  while IFS= read -r line; do
    if [[ "$line" == "$completion_prefix"* ]]; then
      candidate=${line#"$completion_prefix"}
      valid_apfs_volume_device "$candidate" && [[ -z "$device" ]] \
        || return 1
      device=$candidate
    fi
  done <<< "$output"
  [[ -n "$device" ]] || return 1
  printf '%s\n' "$device"
}

valid_apfs_volume_device() { # device
  [[ "$1" =~ ^disk[123456789][0123456789]*s[123456789][0123456789]*$ ]]
}

read_created_apfs_identity() { # device
  local target=$1 plist name uuid device
  plist=$(diskutil info -plist "$target" 2>/dev/null) || return 1
  printf '%s' "$plist" | plutil -lint - >/dev/null 2>&1 || return 1
  name=$(printf '%s' "$plist" \
    | plutil -extract VolumeName raw -expect string -o - - 2>/dev/null) \
    || return 1
  uuid=$(printf '%s' "$plist" \
    | plutil -extract VolumeUUID raw -expect string -o - - 2>/dev/null) \
    || return 1
  device=$(printf '%s' "$plist" \
    | plutil -extract DeviceIdentifier raw -expect string -o - - 2>/dev/null) \
    || return 1
  [[ -n "$name" && -n "$uuid" ]] \
    && valid_apfs_volume_device "$device" \
    || return 1
  printf '%s\t%s\t%s\n' "$name" "$uuid" "$device"
}

execute_init_create_volume() {
  local add_output created_identity created_name verified_device
  [[ -n "$INIT_PASSPHRASE" ]] || die "init recovery material is unavailable"
  verify_installed_init_recovery "volume creation"
  inspect_init_volume_absence
  verify_installed_init_recovery "keychain storage"
  require_init_state_dir_identity
  keychain_store_passphrase "$INIT_PASSPHRASE" \
    || die "keychain storage failed, protected recovery material remains at $STATE_DIR/passphrase.txt"
  verify_installed_init_recovery "APFS volume creation"
  add_output=$(printf '%s' "$INIT_PASSPHRASE" \
    | sudo diskutil apfs addVolume "$CONTAINER" APFS "$VOLUME" \
      -stdinpassphrase 2>/dev/null) \
    || die "APFS volume creation failed, protected recovery material remains at $STATE_DIR/passphrase.txt"
  INIT_CREATED_DEVICE=$(created_device_from_add_output "$add_output") \
    || die "APFS volume creation returned no unique device, protected recovery material remains at $STATE_DIR/passphrase.txt"
  created_identity=$(read_created_apfs_identity "$INIT_CREATED_DEVICE") \
    || die "cannot discover final APFS identity, protected recovery material remains at $STATE_DIR/passphrase.txt"
  IFS=$'\t' read -r created_name INIT_CREATED_UUID verified_device \
    <<< "$created_identity"
  [[ "$created_name" == "$VOLUME" \
      && "$verified_device" == "$INIT_CREATED_DEVICE" ]] \
    || die "created APFS identity changed before state creation, protected recovery material remains at $STATE_DIR/passphrase.txt"
}

read_apfs_identity() { # target
  local target=$1 plist uuid device locked mount_point
  plist=$(diskutil info -plist "$target" 2>/dev/null) || return 1
  printf '%s' "$plist" | plutil -lint - >/dev/null 2>&1 || return 1
  uuid=$(printf '%s' "$plist" \
    | plutil -extract VolumeUUID raw -expect string -o - - 2>/dev/null) \
    || return 1
  device=$(printf '%s' "$plist" \
    | plutil -extract DeviceIdentifier raw -expect string -o - - 2>/dev/null) \
    || return 1
  locked=$(printf '%s' "$plist" \
    | plutil -extract Locked raw -expect bool -o - - 2>/dev/null) \
    || return 1
  mount_point=$(printf '%s' "$plist" \
    | plutil -extract MountPoint raw -expect string -o - - 2>/dev/null) \
    || return 1
  [[ -n "$uuid" && "$locked" == "false" \
      && "$mount_point" == "$MOUNT_POINT" ]] \
    && valid_apfs_volume_device "$device" \
    || return 1
  printf '%s\t%s\n' "$uuid" "$device"
}

state_path_digest() { # path
  local output digest
  output=$(/usr/bin/shasum -a 256 < "$1" 2>/dev/null) || return 1
  digest=${output%% *}
  [[ "$digest" =~ ^[0123456789abcdef]{64}$ ]] || return 1
  printf '%s\n' "$digest"
}

validate_installed_init_state_path() { # path
  local path=$1 first_identity digest final_identity
  [[ -f "$path" && ! -L "$path" \
      && -n "$INIT_STATE_IDENTITY" && -n "$INIT_STATE_DIGEST" ]] \
    || return 2
  first_identity=$(path_identity "$path") || return 2
  [[ "$first_identity" == "$INIT_STATE_IDENTITY" ]] || return 2
  digest=$(state_path_digest "$path") || return 3
  [[ "$digest" == "$INIT_STATE_DIGEST" ]] || return 3
  final_identity=$(path_identity "$path") || return 2
  [[ "$final_identity" == "$INIT_STATE_IDENTITY" ]] || return 2
}

execute_init_write_state() {
  local identity uuid device temporary_state temporary_identity installed_identity
  local final_identity installed_digest
  verify_installed_init_recovery "state creation"
  identity=$(read_apfs_identity "$MOUNT_POINT") \
    || die "cannot discover final APFS identity, protected recovery material remains at $STATE_DIR/passphrase.txt"
  IFS=$'\t' read -r uuid device <<< "$identity"
  [[ "$uuid" == "$INIT_CREATED_UUID" \
      && "$device" == "$INIT_CREATED_DEVICE" ]] \
    || die "created APFS identity changed before state creation, protected recovery material remains at $STATE_DIR/passphrase.txt"
  PLAN_CONTEXT_UUID=$uuid
  PLAN_CONTEXT_DEVICE=$device
  require_init_state_dir_identity
  temporary_state=$(mktemp "$STATE_DIR/.state.XXXXXX") \
    || die "state staging path is unsafe, protected recovery material remains at $INIT_RECOVERY_PATH"
  chmod 600 "$temporary_state" \
    || die "cannot protect state staging file, recovery material remains at $INIT_RECOVERY_PATH"
  temporary_identity=$(path_identity "$temporary_state") \
    || die "cannot capture state staging identity, recovery material remains at $INIT_RECOVERY_PATH"
  jq -n --arg uuid "$uuid" --arg created "$(/bin/date -Iseconds)" \
    '{locked: false, volume_uuid: $uuid, created: $created, deadline: null, deadline_epoch: null, round: null}' \
    > "$temporary_state" \
    || die "initial state creation failed, protected recovery material remains at $STATE_DIR/passphrase.txt"
  installed_identity=$(path_identity "$temporary_state") \
    || die "state staging identity is unavailable after write, recovery material remains at $INIT_RECOVERY_PATH"
  [[ "$installed_identity" == "$temporary_identity" ]] \
    || die "state staging path is unsafe, protected recovery material remains at $INIT_RECOVERY_PATH"
  INIT_STATE_DIGEST=$(state_path_digest "$temporary_state") \
    || die "state staging content is unreadable, recovery material remains at $INIT_RECOVERY_PATH"
  final_identity=$(path_identity "$temporary_state") \
    || die "state staging identity is unavailable after fingerprinting, recovery material remains at $INIT_RECOVERY_PATH"
  [[ "$final_identity" == "$temporary_identity" ]] \
    || die "state staging identity changed during fingerprinting, recovery material remains at $INIT_RECOVERY_PATH"
  require_init_state_dir_identity
  if ! ln -- "$temporary_state" "$state_file"; then
    die "state staging path is unsafe, protected recovery material remains at $INIT_RECOVERY_PATH"
  fi
  installed_identity=$(path_identity "$state_file") \
    || die "installed state identity is unavailable, installed state retained at $state_file, recovery material remains at $INIT_RECOVERY_PATH"
  [[ "$installed_identity" == "$temporary_identity" ]] \
    || die "installed state identity mismatch, installed state retained at $state_file, recovery material remains at $INIT_RECOVERY_PATH"
  INIT_STATE_IDENTITY=$installed_identity
  installed_digest=$(state_path_digest "$state_file") \
    || die "installed state content is unreadable, installed state retained at $state_file, recovery material remains at $INIT_RECOVERY_PATH"
  final_identity=$(path_identity "$state_file") \
    || die "installed state identity is unavailable after fingerprinting, installed state retained at $state_file, recovery material remains at $INIT_RECOVERY_PATH"
  [[ "$final_identity" == "$INIT_STATE_IDENTITY" ]] \
    || die "installed state identity changed during fingerprinting, installed state retained at $state_file, recovery material remains at $INIT_RECOVERY_PATH"
  [[ "$installed_digest" == "$INIT_STATE_DIGEST" ]] \
    || die "installed state content changed during installation, installed state retained at $state_file, recovery material remains at $INIT_RECOVERY_PATH"
  rm -f -- "$temporary_state" \
    || die "cannot remove state staging name, installed state retained at $state_file, recovery material remains at $INIT_RECOVERY_PATH"
}

ensure_init_quarantine_private() { # directory expected_identity
  local directory=$1 expected_identity=$2 actual_identity actual_mode
  actual_identity=$(path_identity "$directory") || return 1
  [[ "$actual_identity" == "$expected_identity" \
      && -d "$directory" && ! -L "$directory" ]] \
    || return 1
  actual_mode=$(path_mode "$directory") || return 1
  if [[ "$actual_mode" != "700" ]]; then
    chmod 700 "$directory" || return 1
    actual_identity=$(path_identity "$directory") || return 1
    actual_mode=$(path_mode "$directory") || return 1
    [[ "$actual_identity" == "$expected_identity" \
        && "$actual_mode" == "700" \
        && -d "$directory" && ! -L "$directory" ]] \
      || return 1
  fi
}

restore_quarantined_init_state() { # directory expected_identity path
  local directory=$1 expected_identity=$2 path=$3
  local actual_identity moved_identity restored_identity
  INIT_STATE_CLEANUP_DETAIL=$path
  if [[ -e "$state_file" || -L "$state_file" ]]; then
    INIT_STATE_CLEANUP_DETAIL="$path; unowned original-path entry retained at $state_file"
    return 0
  fi
  [[ -f "$path" && ! -L "$path" ]] || return 0
  actual_identity=$(path_identity "$directory") || return 0
  [[ "$actual_identity" == "$expected_identity" \
      && -d "$directory" && ! -L "$directory" ]] \
    || return 0
  moved_identity=$(path_identity "$path") || return 0
  if ! mv -n -- "$path" "$state_file"; then
    if [[ ! -e "$path" && ! -L "$path" \
        && ( -e "$state_file" || -L "$state_file" ) ]]; then
      INIT_STATE_CLEANUP_DETAIL=$state_file
    elif [[ -e "$state_file" || -L "$state_file" ]]; then
      INIT_STATE_CLEANUP_DETAIL="$path; unowned original-path entry retained at $state_file"
    fi
    return 0
  fi
  if [[ ! -e "$path" && ! -L "$path" \
      && ( -e "$state_file" || -L "$state_file" ) ]]; then
    INIT_STATE_CLEANUP_DETAIL=$state_file
  elif [[ ( -e "$path" || -L "$path" ) \
      && ( -e "$state_file" || -L "$state_file" ) ]]; then
    INIT_STATE_CLEANUP_DETAIL="$path; unowned original-path entry retained at $state_file"
    return 0
  else
    return 0
  fi
  if [[ ! -f "$state_file" || -L "$state_file" ]]; then
    INIT_STATE_CLEANUP_DETAIL="unowned original-path entry retained at $state_file"
    return 0
  fi
  restored_identity=$(path_identity "$state_file") || return 0
  if [[ "$restored_identity" != "$moved_identity" ]]; then
    INIT_STATE_CLEANUP_DETAIL="unowned original-path entry retained at $state_file"
    return 0
  fi
  rmdir -- "$directory" 2>/dev/null \
    || INIT_STATE_CLEANUP_DETAIL="$state_file; quarantine directory retained at $directory"
}

remove_owned_init_state() {
  local actual_state_dir_identity quarantine_dir quarantine_identity
  local quarantine_path
  INIT_STATE_CLEANUP_DETAIL=""
  if [[ ! -e "$state_file" && ! -L "$state_file" ]]; then
    return 0
  fi
  actual_state_dir_identity=$(path_identity "$STATE_DIR") \
    || { INIT_STATE_CLEANUP_DETAIL=$state_file; return 2; }
  [[ "$actual_state_dir_identity" == "$INIT_STATE_DIR_IDENTITY" \
      && -d "$STATE_DIR" && ! -L "$STATE_DIR" ]] \
    || { INIT_STATE_CLEANUP_DETAIL=$state_file; return 2; }
  if ! validate_installed_init_state_path "$state_file"; then
    INIT_STATE_CLEANUP_DETAIL=$state_file
    return 2
  fi
  quarantine_dir=$(mktemp -d "$STATE_DIR/.state-quarantine.XXXXXX") \
    || { INIT_STATE_CLEANUP_DETAIL=$state_file; return 3; }
  chmod 700 "$quarantine_dir" \
    || { INIT_STATE_CLEANUP_DETAIL="$state_file; quarantine directory retained at $quarantine_dir"; return 3; }
  quarantine_identity=$(path_identity "$quarantine_dir") \
    || { INIT_STATE_CLEANUP_DETAIL="$state_file; quarantine directory retained at $quarantine_dir"; return 3; }
  quarantine_path="$quarantine_dir/state.json"
  [[ ! -e "$quarantine_path" && ! -L "$quarantine_path" ]] \
    || { INIT_STATE_CLEANUP_DETAIL="$state_file; unexpected entry retained at $quarantine_path"; return 3; }
  ensure_init_quarantine_private "$quarantine_dir" "$quarantine_identity" \
    || { INIT_STATE_CLEANUP_DETAIL="$state_file; quarantine directory retained at $quarantine_dir"; return 3; }
  run_named_transition init_cleanup_before_state_quarantine_move "$state_file" \
    || { INIT_STATE_CLEANUP_DETAIL=$state_file; return 3; }
  if ! mv -- "$state_file" "$quarantine_path"; then
    rmdir -- "$quarantine_dir" 2>/dev/null || true
    INIT_STATE_CLEANUP_DETAIL=$state_file
    return 3
  fi
  run_named_transition init_cleanup_after_state_quarantine_move \
    "$quarantine_path" || {
    restore_quarantined_init_state \
      "$quarantine_dir" "$quarantine_identity" "$quarantine_path"
    return 2
  }
  if ! ensure_init_quarantine_private \
      "$quarantine_dir" "$quarantine_identity"; then
    restore_quarantined_init_state \
      "$quarantine_dir" "$quarantine_identity" "$quarantine_path"
    return 2
  fi
  if validate_installed_init_state_path "$quarantine_path"; then
    if ! ensure_init_quarantine_private \
        "$quarantine_dir" "$quarantine_identity"; then
      restore_quarantined_init_state \
        "$quarantine_dir" "$quarantine_identity" "$quarantine_path"
      return 2
    fi
    if ! rm -f -- "$quarantine_path"; then
      if [[ ! -e "$quarantine_path" && ! -L "$quarantine_path" ]]; then
        rmdir -- "$quarantine_dir" \
          || { INIT_STATE_CLEANUP_DETAIL=$quarantine_dir; return 3; }
        return 0
      fi
      INIT_STATE_CLEANUP_DETAIL=$quarantine_path
      return 3
    fi
    [[ ! -e "$quarantine_path" && ! -L "$quarantine_path" ]] \
      || { INIT_STATE_CLEANUP_DETAIL=$quarantine_path; return 3; }
    rmdir -- "$quarantine_dir" \
      || { INIT_STATE_CLEANUP_DETAIL=$quarantine_dir; return 3; }
    return 0
  fi
  restore_quarantined_init_state \
    "$quarantine_dir" "$quarantine_identity" "$quarantine_path"
  return 2
}

die_after_init_state_cleanup() { # primary_error
  local primary_error=$1 cleanup_status
  if remove_owned_init_state; then
    die "$primary_error"
  else
    cleanup_status=$?
  fi
  case "$cleanup_status" in
    2)
      die "$primary_error; installed state retained because ownership could not be proven at $INIT_STATE_CLEANUP_DETAIL"
      ;;
    3)
      die "$primary_error; installed state removal failed after ownership was proven; retained at $INIT_STATE_CLEANUP_DETAIL"
      ;;
    *)
      die "$primary_error; installed state cleanup failed unexpectedly"
      ;;
  esac
}

verify_installed_init_state_or_cleanup() {
  local validation_status
  if validate_installed_init_state_path "$state_file"; then
    return 0
  else
    validation_status=$?
  fi
  case "$validation_status" in
    3)
      die_after_init_state_cleanup \
        "installed state content changed before final verification"
      ;;
    *)
      die_after_init_state_cleanup \
        "installed state identity changed before final verification"
      ;;
  esac
}

verify_init_target() {
  local initialized_hash expected_hash
  if ! installed_init_recovery_is_valid; then
    die_after_init_state_cleanup \
      "installed recovery material changed before final verification"
  fi
  verify_installed_init_state_or_cleanup
  inspect_runtime_state
  classify_runtime_state
  verify_installed_init_state_or_cleanup
  initialized_hash=$(read_unlock_hash 2>/dev/null || true)
  expected_hash=$(sha256_of "$INIT_PASSPHRASE" 2>/dev/null || true)
  if [[ "$RUNTIME_ASSESSMENT" == "usable" \
      && "$SNAPSHOT_EXPECTED_UUID" == "$INIT_CREATED_UUID" \
      && "$SNAPSHOT_ACTUAL_UUID" == "$INIT_CREATED_UUID" \
      && "$SNAPSHOT_DEVICE" == "$INIT_CREATED_DEVICE" \
      && "$PLAN_CONTEXT_UUID" == "$INIT_CREATED_UUID" \
      && "$PLAN_CONTEXT_DEVICE" == "$INIT_CREATED_DEVICE" \
      && -n "$initialized_hash" \
      && "$initialized_hash" == "$expected_hash" ]] \
      && installed_init_recovery_is_valid; then
    return 0
  fi
  die_after_init_state_cleanup \
    "created vault failed usable-target verification"
}

path_has_control_character() {
  [[ "$1" == *$'\n'* || "$1" == *$'\r'* || "$1" == *$'\t'* ]] \
    && return 0
  LC_ALL=C printf '%s' "$1" | grep -q '[[:cntrl:]]'
}
path_identity() { "$BSD_STAT" -f '%d:%i' -- "$1" 2>/dev/null; }
path_mode() { "$BSD_STAT" -f '%Lp' -- "$1" 2>/dev/null; }

canonical_path_without_following_leaf() { # path
  local path=$1 parent leaf canonical_parent
  parent=$(/usr/bin/dirname -- "$path") || return 1
  leaf=$(/usr/bin/basename -- "$path") || return 1
  canonical_parent=$(cd -P -- "$parent" 2>/dev/null && pwd -P) \
    || return 1
  printf '%s/%s\n' "${canonical_parent%/}" "$leaf"
}

capture_adopt_reserved_control_paths() {
  [[ -d "$STATE_DIR" && ! -L "$STATE_DIR" ]] \
    || die "reserved state directory must be a real directory"
  [[ -f "$state_file" && ! -L "$state_file" ]] \
    || die "reserved state file must be a real file"
  ADOPT_RESERVED_STATE_DIR=$(cd -P -- "$STATE_DIR" 2>/dev/null && pwd -P) \
    || die "cannot canonicalize reserved state directory"
  ADOPT_RESERVED_STATE_FILE=$ADOPT_RESERVED_STATE_DIR/${state_file##*/}
  ADOPT_RESERVED_OPERATION_LOCK=$(canonical_path_without_following_leaf \
    "$OPERATION_LOCK_DIR") \
    || die "cannot canonicalize reserved operation lock path"
}

verify_adopt_reserved_control_identities() {
  local canonical_identity operation_identity resolved_operation_lock
  ADOPT_RESERVED_STATE_DIR_IDENTITY=$(path_identity "$STATE_DIR") \
    || die "cannot capture reserved state directory identity"
  canonical_identity=$(path_identity "$ADOPT_RESERVED_STATE_DIR") \
    || die "cannot verify canonical state directory identity"
  [[ "$canonical_identity" == "$ADOPT_RESERVED_STATE_DIR_IDENTITY" ]] \
    || die "reserved state directory identity changed during canonicalization"
  ADOPT_RESERVED_STATE_FILE_IDENTITY=$(path_identity "$state_file") \
    || die "cannot capture reserved state file identity"
  canonical_identity=$(path_identity "$ADOPT_RESERVED_STATE_FILE") \
    || die "cannot verify canonical state file identity"
  [[ "$canonical_identity" == "$ADOPT_RESERVED_STATE_FILE_IDENTITY" ]] \
    || die "reserved state file identity changed during canonicalization"
  if [[ "$OPERATION_LOCK_ACTIVE" == true ]]; then
    resolved_operation_lock=$(cd -P -- "$OPERATION_LOCK_DIR" 2>/dev/null \
      && pwd -P) || die "cannot resolve owned operation lock path"
    operation_identity=$(path_identity "$OPERATION_LOCK_DIR") \
      || die "cannot verify owned operation lock identity"
    [[ "$resolved_operation_lock" == "$ADOPT_RESERVED_OPERATION_LOCK" \
        && "$operation_identity" == "$OPERATION_LOCK_DIR_IDENTITY" ]] \
      || die "owned operation lock path changed during adopt inspection"
  fi
}

adopt_source_contains_reserved_control_path() {
  local reserved
  for reserved in "$ADOPT_RESERVED_STATE_DIR" \
      "$ADOPT_RESERVED_STATE_FILE" "$ADOPT_RESERVED_OPERATION_LOCK"; do
    if [[ "$reserved" == "$ADOPT_SOURCE" \
        || "$reserved" == "$ADOPT_SOURCE"/* ]]; then
      return 0
    fi
  done
  return 1
}

assert_path_identity() { # path expected description
  local actual
  actual=$(path_identity "$1") || die "$3 identity is unavailable"
  [[ "$actual" == "$2" ]] || die "$3 identity changed"
}

inspect_adopt_state() {
  local raw=$OPTION_OPERANDS parent leaf canonical_mount
  local canonical_destination
  preflight_adopt_dependencies
  [[ -n "$raw" && "$raw" != "/" ]] || die "adopt source must not be empty or root"
  path_has_control_character "$raw" && die "adopt source contains control characters"
  while [[ "$raw" != "/" && "$raw" == */ ]]; do raw=${raw%/}; done
  if [[ "$raw" == /* ]]; then
    ADOPT_SOURCE_DISPLAY=$raw
  else
    ADOPT_SOURCE_DISPLAY=$PWD/$raw
  fi
  parent=$(dirname -- "$raw") || die "cannot resolve adopt source parent"
  leaf=$(basename -- "$raw") || die "cannot resolve adopt source name"
  [[ "$leaf" != "." && "$leaf" != ".." ]] || die "adopt source name is not allowed"
  parent=$(cd -P -- "$parent" 2>/dev/null && pwd -P) \
    || die "cannot resolve adopt source parent"
  ADOPT_PARENT=$parent
  ADOPT_PARENT_IDENTITY=$(path_identity "$ADOPT_PARENT") \
    || die "cannot capture adopt source parent identity"
  ADOPT_SOURCE="${parent%/}/$leaf"
  [[ ! -L "$ADOPT_SOURCE" && -d "$ADOPT_SOURCE" ]] \
    || die "$ADOPT_SOURCE is not a real directory"
  capture_adopt_reserved_control_paths
  adopt_source_contains_reserved_control_path \
    && die "$ADOPT_SOURCE contains reserved vaultlock control path"
  verify_adopt_reserved_control_identities
  canonical_mount=$(cd -P -- "$MOUNT_POINT" 2>/dev/null && pwd -P) \
    || die "cannot resolve expected mount point"
  [[ "$ADOPT_SOURCE" != "$canonical_mount" \
      && "$ADOPT_SOURCE" != "$canonical_mount"/* ]] \
    || die "$ADOPT_SOURCE is already on the vault"
  [[ "$canonical_mount" != "$ADOPT_SOURCE" \
      && "$canonical_mount" != "$ADOPT_SOURCE"/* ]] \
    || die "$ADOPT_SOURCE contains the expected mount point"
  inspect_runtime_state
  classify_runtime_state
  [[ "$RUNTIME_ASSESSMENT" == "usable" \
      && "$SNAPSHOT_APFS_MOUNTED" == "true" \
      && "$SNAPSHOT_ACTUAL_MOUNT_POINT" == "$MOUNT_POINT" ]] \
    || die "adopt requires a usable mounted vault"
  ADOPT_DESTINATION="${MOUNT_POINT%/}/$leaf"
  canonical_destination="${canonical_mount%/}/$leaf"
  [[ "$canonical_destination" != "$ADOPT_SOURCE" \
      && "$canonical_destination" != "$ADOPT_SOURCE"/* ]] \
    || die "$ADOPT_DESTINATION would be inside the adopt source"
  [[ ! -e "$ADOPT_DESTINATION" && ! -L "$ADOPT_DESTINATION" ]] \
    || die "$ADOPT_DESTINATION already exists"
  ADOPT_STAGED_LINK="$ADOPT_SOURCE.vaultlock-link"
  ADOPT_BACKUP="$ADOPT_SOURCE.vaultlock-backup"
  [[ ! -e "$ADOPT_STAGED_LINK" && ! -L "$ADOPT_STAGED_LINK" ]] \
    || die "adopt staging path already exists: $ADOPT_STAGED_LINK"
  [[ ! -e "$ADOPT_BACKUP" && ! -L "$ADOPT_BACKUP" ]] \
    || die "adopt backup path already exists: $ADOPT_BACKUP"
  ADOPT_SOURCE_IDENTITY=$(path_identity "$ADOPT_SOURCE") \
    || die "cannot capture source identity"
  ADOPT_SOURCE_DEVICE=$("$BSD_STAT" -f '%d' -- "$ADOPT_SOURCE" 2>/dev/null) \
    || die "cannot capture source device"
  PLAN_CONTEXT_UUID=$SNAPSHOT_EXPECTED_UUID
  PLAN_CONTEXT_DEVICE=$SNAPSHOT_DEVICE
  ADOPT_SOURCE_TREE_DIGEST=""
  ADOPT_STAGED_LINK_IDENTITY=""
  ADOPT_STAGED_LINK_TARGET=""
  ADOPT_STAGED_LINK_MODE=""
  ADOPT_DESTINATION_IDENTITY=""
  ADOPT_DESTINATION_DEVICE=""
  ADOPT_DESTINATION_TREE_DIGEST=""
  ADOPT_BACKUP_IDENTITY=""
  ADOPT_BACKUP_DEVICE=""
  ADOPT_BACKUP_TREE_DIGEST=""
  ADOPT_BACKUP_RESERVATION=""
  ADOPT_BACKUP_RESERVATION_IDENTITY=""
  ADOPT_BACKUP_RESERVATION_DEVICE=""
  ADOPT_BACKUP_QUARANTINE=""
  ADOPT_BACKUP_QUARANTINE_IDENTITY=""
  ADOPT_DIRECTORY_SKELETON=""
  ADOPT_DIRECTORY_SKELETON_IDENTITY=""
  ADOPT_DIRECTORY_SKELETON_DIGEST=""
  ADOPT_COPY_VERIFIED=false
}

build_adopt_plan() {
  PLAN_TARGET_TEXT="$ADOPT_SOURCE linked to copied data at $ADOPT_DESTINATION"
  plan_add adopt_copy "Copy $ADOPT_SOURCE to $ADOPT_DESTINATION"
  plan_add adopt_verify \
    "Verify copied data, source identity, and mounted vault identity"
  plan_add adopt_replace_source \
    "Replace $ADOPT_SOURCE with a verified symlink using a staged backup"
}

verify_adopt_mount_identity() {
  local identity actual_uuid actual_device
  identity=$(read_apfs_identity "$MOUNT_POINT") \
    || die "mounted vault identity is unavailable"
  IFS=$'\t' read -r actual_uuid actual_device <<< "$identity"
  [[ "$actual_uuid" == "$PLAN_CONTEXT_UUID" \
      && "$actual_device" == "$PLAN_CONTEXT_DEVICE" ]] \
    || die "mounted vault identity changed"
}

sha256_output_digest() { # shasum output
  local output=$1 digest
  digest=${output%% *}
  [[ "$digest" =~ ^[0-9a-f]{64}$ ]] || return 1
  printf '%s\n' "$digest"
}

empty_payload_digest() {
  local output
  output=$(/usr/bin/shasum -a 256 < /dev/null 2>/dev/null) || return 1
  sha256_output_digest "$output"
}

path_stat_signature() { # path
  "$BSD_STAT" -f '%d:%i:%Lp:%u:%g:%z:%.9Fm:%.9FB:%f:%r:%l' -- "$1" \
    2>/dev/null
}

path_payload_digest() { # type path
  local type=$1 path=$2 output
  case "$type" in
    d)
      empty_payload_digest
      ;;
    f)
      output=$(/usr/bin/shasum -a 256 < "$path" 2>/dev/null) \
        || return 1
      sha256_output_digest "$output"
      ;;
    l)
      output=$(/usr/bin/readlink -n -- "$path" 2>/dev/null \
        | /usr/bin/shasum -a 256 2>/dev/null) || return 1
      sha256_output_digest "$output"
      ;;
    *)
      return 1
      ;;
  esac
}

path_acl_digest() { # path
  local output
  output=$(LC_ALL=C "$BSD_LS" -ldnePB -- "$1" 2>/dev/null \
    | /usr/bin/sed -n '2,$p' \
    | /usr/bin/shasum -a 256 2>/dev/null) || return 1
  sha256_output_digest "$output"
}

path_xattr_listing() { # path
  LC_ALL=C "$BSD_LS" -ldnP@B -- "$1" 2>/dev/null \
    | /usr/bin/sed -n '2,$p' \
    | LC_ALL=C /usr/bin/sort
}

decode_ls_escaped_name() { # escaped name
  local encoded=$1 decoded="" character escape octal
  while [[ -n "$encoded" ]]; do
    character=${encoded:0:1}
    encoded=${encoded:1}
    if [[ "$character" != \\ ]]; then
      decoded=$decoded$character
      continue
    fi
    [[ -n "$encoded" ]] || return 1
    escape=${encoded:0:1}
    if [[ "$escape" == \\ ]]; then
      decoded=$decoded\\
      encoded=${encoded:1}
      continue
    fi
    [[ "${#encoded}" -ge 3 ]] || return 1
    octal=${encoded:0:3}
    [[ "$octal" =~ ^[0-7]{3}$ && "$octal" != "000" ]] || return 1
    printf -v character '%b' "\\$octal"
    decoded=$decoded$character
    encoded=${encoded:3}
  done
  printf '%s' "$decoded"
}

path_xattr_manifest_stream() { # path
  local path=$1 before after line escaped_name size_field size name value
  before=$(path_xattr_listing "$path") || return 1
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    [[ "$line" == $'\t'*$'\t'* ]] || return 1
    line=${line#$'\t'}
    escaped_name=${line%%$'\t'*}
    size_field=${line#*$'\t'}
    size=$(printf '%s' "$size_field" | /usr/bin/tr -d '[:space:]')
    [[ "$size" =~ ^[0-9]+$ ]] || return 1
    name=
    IFS= read -r -d '' name \
      < <(decode_ls_escaped_name "$escaped_name" && printf '\0') \
      || return 1
    value=$(/usr/bin/xattr -psx -- "$name" "$path" 2>/dev/null \
      | /usr/bin/tr -d '[:space:]') || return 1
    [[ "$value" =~ ^[0-9A-Fa-f]*$ \
      && $(( ${#value} % 2 )) -eq 0 \
      && $(( ${#value} / 2 )) -eq "$size" ]] || return 1
    printf '%s\0%s\0' "$escaped_name" "$value"
  done <<< "$before"
  after=$(path_xattr_listing "$path") || return 1
  [[ "$after" == "$before" ]]
}

path_xattr_digest() { # path
  local output
  output=$(path_xattr_manifest_stream "$1" \
    | /usr/bin/shasum -a 256 2>/dev/null) || return 1
  sha256_output_digest "$output"
}

hex_string() { # string
  printf '%s' "$1" | /usr/bin/xxd -p | /usr/bin/tr -d '[:space:]'
}

build_hardlink_map() { # root expected_device map identities...
  local root=$1 expected_device=$2 map=$3 map_identity=$4 raw_identity=$5
  local sorted_identity=$6 grouped_identity=$7 path metadata
  local device inode mode uid gid size mtime birthtime flags rdev nlink
  local relative path_hex raw sorted grouped identity current_identity=""
  local current_nlink="" anchor group_count=0 group_paths=() group_path
  raw=$map.raw
  sorted=$map.sorted
  grouped=$map.grouped
  private_file_is_valid "$raw" "$raw_identity" 600 1 || return 1
  if ! LC_ALL=C "$BSD_FIND" -P -s -x "$root" -type f -print0 \
      | while IFS= read -r -d '' path; do
        metadata=$(path_stat_signature "$path") || return 1
        IFS=: read -r device inode mode uid gid size mtime birthtime flags \
          rdev nlink <<< "$metadata"
        [[ "$device" == "$expected_device" ]] || return 1
        if [[ "$path" == "$root" ]]; then
          relative=.
        elif [[ "$path" == "$root/"* ]]; then
          relative=${path#"$root/"}
        else
          return 1
        fi
        path_hex=$(hex_string "$relative") || return 1
        printf '%s:%s\t%s\t%s\n' "$device" "$inode" "$path_hex" "$nlink" \
          >> "$raw" || return 1
      done; then
    return 1
  fi
  private_file_is_valid "$raw" "$raw_identity" 600 1 || return 1
  LC_ALL=C /usr/bin/sort -t $'\t' -k1,1 -k2,2 "$raw" > "$sorted" \
    || return 1
  private_file_is_valid "$sorted" "$sorted_identity" 600 1 || return 1
  while IFS=$'\t' read -r identity path_hex nlink; do
    if [[ -n "$current_identity" && "$identity" != "$current_identity" ]]; then
      [[ "$group_count" -eq "$current_nlink" ]] || return 1
      anchor=${group_paths[0]}
      for group_path in "${group_paths[@]}"; do
        printf '%s\t%s\n' "$group_path" "$anchor" >> "$grouped" \
          || return 1
      done
      group_paths=()
      group_count=0
      current_nlink=""
    fi
    current_identity=$identity
    [[ -z "$current_nlink" || "$nlink" == "$current_nlink" ]] \
      || return 1
    current_nlink=$nlink
    group_paths+=("$path_hex")
    group_count=$((group_count + 1))
  done < "$sorted"
  if [[ -n "$current_identity" ]]; then
    [[ "$group_count" -eq "$current_nlink" ]] || return 1
    anchor=${group_paths[0]}
    for group_path in "${group_paths[@]}"; do
      printf '%s\t%s\n' "$group_path" "$anchor" >> "$grouped" \
        || return 1
    done
  fi
  private_file_is_valid "$grouped" "$grouped_identity" 600 1 || return 1
  LC_ALL=C /usr/bin/sort -t $'\t' -k1,1 "$grouped" > "$map" \
    || return 1
  private_file_is_valid "$map" "$map_identity" 600 1
}

hardlink_metadata_set_is_valid() { # workspace identity links map identities...
  local workspace=$1 workspace_identity=$2 workspace_links=$3 map=$4
  local map_identity=$5 raw_identity=$6 sorted_identity=$7
  local grouped_identity=$8 workspace_device=${workspace_identity%%:*}
  private_directory_is_valid "$workspace" "$workspace_identity" 700 \
    "$workspace_links" \
    && [[ "${map_identity%%:*}" == "$workspace_device" \
      && "${raw_identity%%:*}" == "$workspace_device" \
      && "${sorted_identity%%:*}" == "$workspace_device" \
      && "${grouped_identity%%:*}" == "$workspace_device" ]] \
    && private_file_is_valid "$map" "$map_identity" 600 1 \
    && private_file_is_valid "$map.raw" "$raw_identity" 600 1 \
    && private_file_is_valid "$map.sorted" "$sorted_identity" 600 1 \
    && private_file_is_valid "$map.grouped" "$grouped_identity" 600 1
}

create_hardlink_metadata_file() { # workspace identity links path
  local workspace=$1 workspace_identity=$2 workspace_links=$3 path=$4
  local identity workspace_device=${workspace_identity%%:*}
  local links_after=$((workspace_links + 1))
  private_directory_is_valid "$workspace" "$workspace_identity" 700 \
    "$workspace_links" || return 1
  [[ ! -e "$path" && ! -L "$path" ]] || return 1
  (umask 077; : > "$path") || return 1
  identity=$(operation_path_identity "$path") || return 1
  [[ "${identity%%:*}" == "$workspace_device" ]] || return 1
  "$CHMOD_COMMAND" -N "$path" || return 1
  "$CHMOD_COMMAND" 600 "$path" || return 1
  private_directory_is_valid "$workspace" "$workspace_identity" 700 \
    "$links_after" || return 1
  private_file_is_valid "$path" "$identity" 600 1 || return 1
  printf '%s\n' "$identity"
}

tree_manifest_stream_with_map() { # root expected_device map map_identity
  local root=$1 expected_device=$2 hardlink_map=$3 map_identity=$4
  local path relative type
  local metadata device inode mode uid gid size mtime birthtime flags rdev nlink
  local before after payload acl xattrs hardlink relative_hex
  local map_path map_anchor map_present=false manifest_size manifest_rdev
  local status LC_ALL=C
  private_file_is_valid "$hardlink_map" "$map_identity" 600 1 || return 1
  printf 'vaultlock-manifest-v3\0'
  LC_ALL=C "$BSD_FIND" -P -s -x "$root" -print0 \
    | (
      exec 3< "$hardlink_map"
      if IFS=$'\t' read -r map_path map_anchor <&3; then
        map_present=true
      fi
      while IFS= read -r -d '' path; do
      if [[ "$path" == "$root" ]]; then
        relative=.
      elif [[ "$path" == "$root/"* ]]; then
        relative=${path#"$root/"}
      else
        return 1
      fi
      relative_hex=$(hex_string "$relative") || return 1
      before=$(path_stat_signature "$path") || return 1
      metadata=$before
      IFS=: read -r device inode mode uid gid size mtime birthtime flags rdev nlink \
        <<< "$metadata"
      [[ "$device" == "$expected_device" ]] || return 1
      [[ "$flags" =~ ^[0-9]+$ ]] || return 1
      (( (flags & 32) == 0 \
        && (flags & 2) == 0 \
        && (flags & 4) == 0 \
        && (flags & 131072) == 0 \
        && (flags & 262144) == 0 )) || return 1
      if [[ -L "$path" ]]; then
        type=l
      elif [[ -d "$path" ]]; then
        type=d
      elif [[ -f "$path" ]]; then
        type=f
      else
        return 1
      fi
      acl=$(path_acl_digest "$path") || return 1
      xattrs=$(path_xattr_digest "$path") || return 1
      if [[ "$type" == "f" ]]; then
        [[ "$map_present" == true && "$map_path" == "$relative_hex" ]] \
          || return 1
        hardlink=$map_anchor
        if IFS=$'\t' read -r map_path map_anchor <&3; then
          map_present=true
        else
          map_present=false
        fi
      else
        hardlink=-
      fi
      manifest_size=$size
      manifest_rdev=$rdev
      if [[ "$type" == d ]]; then
        manifest_size=0
        manifest_rdev=0
      fi
      payload=$(path_payload_digest "$type" "$path") || return 1
      after=$(path_stat_signature "$path") || return 1
      [[ "$before" == "$after" ]] || return 1
      printf '%s\0%s\0%s\0%s\0%s\0%s\0%s\0%s\0%s\0%s\0%s\0%s\0%s\0%s\0' \
        "$relative_hex" "$type" "$mode" "$manifest_size" "$manifest_rdev" \
        "$uid" "$gid" "$mtime" "$birthtime" "$flags" "$acl" "$xattrs" \
        "$hardlink" "$payload"
      done
      [[ "$map_present" == false ]]
    )
  status=$?
  private_file_is_valid "$hardlink_map" "$map_identity" 600 1 || return 1
  return "$status"
}

remove_verified_private_file() { # path identity
  local path=$1 identity=$2
  if [[ ! -e "$path" && ! -L "$path" ]]; then
    return 0
  fi
  [[ -n "$identity" ]] \
    && private_file_is_valid "$path" "$identity" 600 1 \
    && "$RM_COMMAND" -f -- "$path" \
    && [[ ! -e "$path" && ! -L "$path" ]]
}

remove_verified_hardlink_metadata() { # workspace identity links path file_identity
  local workspace=$1 workspace_identity=$2 workspace_links=$3 path=$4
  local identity=$5 workspace_device=${workspace_identity%%:*}
  local links_after=$((workspace_links - 1))
  if [[ ! -e "$path" && ! -L "$path" ]]; then
    return 0
  fi
  [[ -n "$workspace_identity" && -n "$workspace_links" && -n "$identity" \
      && "${identity%%:*}" == "$workspace_device" ]] \
    && private_directory_is_valid "$workspace" "$workspace_identity" 700 \
      "$workspace_links" \
    && remove_verified_private_file "$path" "$identity" \
    && private_directory_is_valid "$workspace" "$workspace_identity" 700 \
      "$links_after" \
    && return 0
  printf 'vaultlock: hard-link metadata retained at %s\n' "$path" >&2
  return 1
}

remove_verified_hardlink_metadata_set() { # workspace identities map identities...
  local workspace=$1 workspace_identity=$2 workspace_links=$3 map=$4
  local map_identity=$5 raw_identity=$6 sorted_identity=$7
  local grouped_identity=$8 status=0
  if [[ -e "$map" || -L "$map" ]]; then
    if remove_verified_hardlink_metadata "$workspace" "$workspace_identity" \
        "$workspace_links" "$map" "$map_identity"; then
      workspace_links=$((workspace_links - 1))
    else
      status=1
    fi
  fi
  if [[ -e "$map.raw" || -L "$map.raw" ]]; then
    if remove_verified_hardlink_metadata "$workspace" "$workspace_identity" \
        "$workspace_links" "$map.raw" "$raw_identity"; then
      workspace_links=$((workspace_links - 1))
    else
      status=1
    fi
  fi
  if [[ -e "$map.sorted" || -L "$map.sorted" ]]; then
    if remove_verified_hardlink_metadata "$workspace" "$workspace_identity" \
        "$workspace_links" "$map.sorted" "$sorted_identity"; then
      workspace_links=$((workspace_links - 1))
    else
      status=1
    fi
  fi
  if [[ -e "$map.grouped" || -L "$map.grouped" ]]; then
    if remove_verified_hardlink_metadata "$workspace" "$workspace_identity" \
        "$workspace_links" "$map.grouped" "$grouped_identity"; then
      workspace_links=$((workspace_links - 1))
    else
      status=1
    fi
  fi
  remove_verified_hardlink_workspace "$workspace" "$workspace_identity" \
    "$workspace_links" || status=1
  return "$status"
}

remove_verified_hardlink_workspace() { # workspace identity links
  local workspace=$1 identity=$2 links=$3
  if [[ ! -e "$workspace" && ! -L "$workspace" ]]; then
    return 0
  fi
  [[ -n "$identity" && -n "$links" ]] \
    && private_directory_is_valid "$workspace" "$identity" 700 "$links" \
    && private_directory_is_empty "$workspace" \
    && "$RMDIR_COMMAND" -- "$workspace" \
    && [[ ! -e "$workspace" && ! -L "$workspace" ]] \
    && return 0
  printf 'vaultlock: hard-link metadata workspace retained at %s\n' \
    "$workspace" >&2
  return 1
}

tree_manifest_stream() { # root expected_device
  local root=$1 expected_device=$2 workspace hardlink_map status=1
  local workspace_identity="" workspace_links="" workspace_metadata
  local workspace_device workspace_inode workspace_mode workspace_owner
  local map_identity="" raw_identity="" sorted_identity=""
  local grouped_identity=""
  workspace=$("$MKTEMP_COMMAND" -d \
    "${TMPDIR:-/tmp}/vaultlock-hardlinks.XXXXXX") || return 1
  hardlink_map=$workspace/map
  if workspace_identity=$(operation_path_identity "$workspace") \
      && "$CHMOD_COMMAND" -N "$workspace" \
      && "$CHMOD_COMMAND" 700 "$workspace" \
      && workspace_metadata=$("$BSD_STAT" -f '%d:%i:%Lp:%u:%l' -- \
        "$workspace" 2>/dev/null) \
      && IFS=: read -r workspace_device workspace_inode workspace_mode \
        workspace_owner workspace_links <<< "$workspace_metadata" \
      && [[ "$workspace_device:$workspace_inode" == "$workspace_identity" \
        && "$workspace_mode" == 700 && "$workspace_owner" == "$UID" \
        && "$workspace_links" =~ ^[1-9][0-9]*$ ]] \
      && private_directory_is_valid "$workspace" "$workspace_identity" 700 \
        "$workspace_links" \
      && private_directory_is_empty "$workspace" \
      && map_identity=$(create_hardlink_metadata_file "$workspace" \
        "$workspace_identity" "$workspace_links" "$hardlink_map") \
      && workspace_links=$((workspace_links + 1)) \
      && raw_identity=$(create_hardlink_metadata_file "$workspace" \
        "$workspace_identity" "$workspace_links" "$hardlink_map.raw") \
      && workspace_links=$((workspace_links + 1)) \
      && sorted_identity=$(create_hardlink_metadata_file "$workspace" \
        "$workspace_identity" "$workspace_links" "$hardlink_map.sorted") \
      && workspace_links=$((workspace_links + 1)) \
      && grouped_identity=$(create_hardlink_metadata_file "$workspace" \
        "$workspace_identity" "$workspace_links" "$hardlink_map.grouped") \
      && workspace_links=$((workspace_links + 1)) \
      && hardlink_metadata_set_is_valid "$workspace" "$workspace_identity" \
        "$workspace_links" "$hardlink_map" "$map_identity" "$raw_identity" \
        "$sorted_identity" "$grouped_identity"; then
    if build_hardlink_map "$root" "$expected_device" "$hardlink_map" \
        "$map_identity" "$raw_identity" "$sorted_identity" \
        "$grouped_identity" \
        && hardlink_metadata_set_is_valid "$workspace" \
          "$workspace_identity" "$workspace_links" "$hardlink_map" \
          "$map_identity" "$raw_identity" "$sorted_identity" \
          "$grouped_identity" \
        && tree_manifest_stream_with_map "$root" "$expected_device" \
          "$hardlink_map" "$map_identity" \
        && hardlink_metadata_set_is_valid "$workspace" \
          "$workspace_identity" "$workspace_links" "$hardlink_map" \
          "$map_identity" "$raw_identity" "$sorted_identity" \
          "$grouped_identity"; then
      status=0
    fi
  fi
  remove_verified_hardlink_metadata_set "$workspace" "$workspace_identity" \
    "$workspace_links" "$hardlink_map" "$map_identity" "$raw_identity" \
    "$sorted_identity" "$grouped_identity" || status=1
  return "$status"
}

tree_digest_once() { # root expected_identity expected_device
  local root=$1 expected_identity=$2 expected_device=$3 output digest
  [[ ! -L "$root" && -d "$root" ]] || return 1
  [[ "$(path_identity "$root")" == "$expected_identity" ]] || return 1
  [[ "$("$BSD_STAT" -f '%d' -- "$root" 2>/dev/null)" \
    == "$expected_device" ]] \
    || return 1
  output=$(tree_manifest_stream "$root" "$expected_device" \
    | /usr/bin/shasum -a 256 2>/dev/null) || return 1
  digest=$(sha256_output_digest "$output") || return 1
  [[ "$(path_identity "$root")" == "$expected_identity" ]] || return 1
  [[ "$("$BSD_STAT" -f '%d' -- "$root" 2>/dev/null)" \
    == "$expected_device" ]] \
    || return 1
  printf '%s\n' "$digest"
}

stable_tree_digest() { # root expected_identity expected_device
  local first second
  first=$(tree_digest_once "$1" "$2" "$3") || return 1
  second=$(tree_digest_once "$1" "$2" "$3") || return 1
  [[ "$first" == "$second" ]] || return 1
  printf '%s\n' "$first"
}

assert_adopt_source_manifest() { # failure message
  local digest
  assert_path_identity "$ADOPT_SOURCE" "$ADOPT_SOURCE_IDENTITY" "source"
  assert_path_identity "$ADOPT_PARENT" "$ADOPT_PARENT_IDENTITY" \
    "source parent"
  digest=$(stable_tree_digest "$ADOPT_SOURCE" "$ADOPT_SOURCE_IDENTITY" \
    "$ADOPT_SOURCE_DEVICE") || die "$1"
  [[ "$digest" == "$ADOPT_SOURCE_TREE_DIGEST" ]] || die "$1"
}

assert_adopt_destination_manifest() { # failure message
  local digest
  assert_path_identity "$ADOPT_DESTINATION" "$ADOPT_DESTINATION_IDENTITY" \
    "destination"
  digest=$(stable_tree_digest "$ADOPT_DESTINATION" \
    "$ADOPT_DESTINATION_IDENTITY" "$ADOPT_DESTINATION_DEVICE") || die "$1"
  [[ "$digest" == "$ADOPT_DESTINATION_TREE_DIGEST" ]] || die "$1"
}

path_timestamp_kind() { # path
  if [[ -L "$1" ]]; then
    printf 'l\n'
  elif [[ -d "$1" ]]; then
    printf 'd\n'
  elif [[ -f "$1" ]]; then
    printf 'f\n'
  else
    return 1
  fi
}

epoch_timestamp_to_utc_iso() { # seconds.nanoseconds
  local timestamp=$1 seconds nanoseconds prefix
  [[ "$timestamp" =~ ^([0-9]+)\.([0-9]{9})$ ]] || return 1
  seconds=${BASH_REMATCH[1]}
  nanoseconds=${BASH_REMATCH[2]}
  prefix=$(/bin/date -u -r "$seconds" '+%Y-%m-%dT%H:%M:%S' \
    2>/dev/null) || return 1
  printf '%s.%sZ\n' "$prefix" "$nanoseconds"
}

epoch_timestamp_is_before() { # candidate boundary
  local candidate=$1 boundary=$2 candidate_seconds candidate_nanoseconds
  local boundary_seconds boundary_nanoseconds
  [[ "$candidate" =~ ^([0-9]+)\.([0-9]{9})$ ]] || return 2
  candidate_seconds=${BASH_REMATCH[1]}
  candidate_nanoseconds=${BASH_REMATCH[2]}
  [[ "$boundary" =~ ^([0-9]+)\.([0-9]{9})$ ]] || return 2
  boundary_seconds=${BASH_REMATCH[1]}
  boundary_nanoseconds=${BASH_REMATCH[2]}
  if (( candidate_seconds < boundary_seconds )); then
    return 0
  fi
  if (( candidate_seconds > boundary_seconds )); then
    return 1
  fi
  (( 10#$candidate_nanoseconds < 10#$boundary_nanoseconds ))
}

restore_adopt_copy_birthtimes() {
  local source_path relative destination_path source_identity
  local destination_identity source_kind destination_kind source_times
  local source_atime source_mtime source_birthtime destination_birthtime
  local birth_iso atime_iso mtime_iso restored_source_times
  local restored_destination_times comparison_status
  LC_ALL=C "$BSD_FIND" -P -s -x "$ADOPT_SOURCE" -depth -print0 \
    | while IFS= read -r -d '' source_path; do
      if [[ "$source_path" == "$ADOPT_SOURCE" ]]; then
        destination_path=$ADOPT_DESTINATION
      elif [[ "$source_path" == "$ADOPT_SOURCE/"* ]]; then
        relative=${source_path#"$ADOPT_SOURCE/"}
        destination_path=$ADOPT_DESTINATION/$relative
      else
        return 1
      fi
      source_kind=$(path_timestamp_kind "$source_path") || return 1
      destination_kind=$(path_timestamp_kind "$destination_path") || return 1
      [[ "$destination_kind" == "$source_kind" ]] || return 1
      source_identity=$(path_identity "$source_path") || return 1
      destination_identity=$(path_identity "$destination_path") || return 1
      source_times=$("$BSD_STAT" -f '%.9Fa:%.9Fm:%.9FB' -- \
        "$source_path" 2>/dev/null) || return 1
      IFS=: read -r source_atime source_mtime source_birthtime \
        <<< "$source_times"
      destination_birthtime=$("$BSD_STAT" -f '%.9FB' -- \
        "$destination_path" 2>/dev/null) || return 1
      if epoch_timestamp_is_before "$destination_birthtime" \
          "$source_birthtime"; then
        return 1
      else
        comparison_status=$?
      fi
      [[ "$comparison_status" -eq 1 ]] || return 1
      birth_iso=$(epoch_timestamp_to_utc_iso "$source_birthtime") \
        || return 1
      if [[ "$source_kind" == l ]]; then
        atime_iso=$(epoch_timestamp_to_utc_iso "$source_atime") || return 1
        mtime_iso=$(epoch_timestamp_to_utc_iso "$source_mtime") || return 1
        /usr/bin/touch -c -h -m -d "$birth_iso" "$destination_path" \
          || return 1
        /usr/bin/touch -c -h -a -d "$atime_iso" "$destination_path" \
          || return 1
        /usr/bin/touch -c -h -m -d "$mtime_iso" "$destination_path" \
          || return 1
      else
        /usr/bin/touch -c -m -d "$birth_iso" "$destination_path" \
          || return 1
        /usr/bin/touch -c -r "$source_path" "$destination_path" \
          || return 1
      fi
      [[ "$(path_timestamp_kind "$source_path")" == "$source_kind" \
        && "$(path_timestamp_kind "$destination_path")" \
          == "$destination_kind" \
        && "$(path_identity "$source_path")" == "$source_identity" \
        && "$(path_identity "$destination_path")" \
          == "$destination_identity" ]] || return 1
      restored_source_times=$("$BSD_STAT" -f '%.9Fa:%.9Fm:%.9FB' -- \
        "$source_path" 2>/dev/null) || return 1
      restored_destination_times=$("$BSD_STAT" \
        -f '%.9Fa:%.9Fm:%.9FB' -- "$destination_path" 2>/dev/null) \
        || return 1
      [[ "$restored_source_times" == "$source_times" \
        && "$restored_destination_times" == "$source_times" ]] || return 1
    done
}

execute_adopt_copy() {
  assert_path_identity "$ADOPT_PARENT" "$ADOPT_PARENT_IDENTITY" \
    "source parent"
  assert_path_identity "$ADOPT_SOURCE" "$ADOPT_SOURCE_IDENTITY" "source"
  verify_adopt_mount_identity
  [[ ! -e "$ADOPT_DESTINATION" && ! -L "$ADOPT_DESTINATION" ]] \
    || die "$ADOPT_DESTINATION appeared before copy"
  ADOPT_SOURCE_TREE_DIGEST=$(stable_tree_digest "$ADOPT_SOURCE" \
    "$ADOPT_SOURCE_IDENTITY" "$ADOPT_SOURCE_DEVICE") \
    || die "cannot create stable source manifest, source remains at $ADOPT_SOURCE"
  assert_path_identity "$ADOPT_PARENT" "$ADOPT_PARENT_IDENTITY" \
    "source parent"
  assert_path_identity "$ADOPT_SOURCE" "$ADOPT_SOURCE_IDENTITY" "source"
  verify_adopt_mount_identity
  /usr/bin/env -u DITTONORSRC "$DITTO_COMMAND" -X --rsrc --extattr --acl \
    --qtn --preserveHFSCompression "$ADOPT_SOURCE" "$ADOPT_DESTINATION" \
    || die "copy failed, source remains at $ADOPT_SOURCE and partial copy may remain at $ADOPT_DESTINATION"
  run_named_transition adopt_copy_before_source_identity_check \
    "$ADOPT_SOURCE"
  assert_path_identity "$ADOPT_SOURCE" "$ADOPT_SOURCE_IDENTITY" "source"
  restore_adopt_copy_birthtimes \
    || die "copy verification failed, source remains at $ADOPT_SOURCE and partial copy may remain at $ADOPT_DESTINATION"
}

execute_adopt_verify() {
  local source_digest destination_digest
  assert_path_identity "$ADOPT_SOURCE" "$ADOPT_SOURCE_IDENTITY" "source"
  assert_path_identity "$ADOPT_PARENT" "$ADOPT_PARENT_IDENTITY" \
    "source parent"
  source_digest=$(stable_tree_digest "$ADOPT_SOURCE" \
    "$ADOPT_SOURCE_IDENTITY" "$ADOPT_SOURCE_DEVICE") \
    || die "source manifest changed after copy, source remains at $ADOPT_SOURCE"
  [[ "$source_digest" == "$ADOPT_SOURCE_TREE_DIGEST" ]] \
    || die "source manifest changed after copy, source remains at $ADOPT_SOURCE"
  [[ ! -L "$ADOPT_DESTINATION" && -d "$ADOPT_DESTINATION" ]] \
    || die "copied destination is not a real directory"
  verify_adopt_mount_identity
  ADOPT_DESTINATION_IDENTITY=$(path_identity "$ADOPT_DESTINATION") \
    || die "cannot capture copied destination identity"
  run_named_transition adopt_verify_before_destination_identity_check \
    "$ADOPT_DESTINATION"
  assert_path_identity "$ADOPT_DESTINATION" "$ADOPT_DESTINATION_IDENTITY" \
    "destination"
  ADOPT_DESTINATION_DEVICE=$("$BSD_STAT" -f '%d' -- "$ADOPT_DESTINATION" \
    2>/dev/null) || die "cannot capture copied destination device"
  destination_digest=$(stable_tree_digest "$ADOPT_DESTINATION" \
    "$ADOPT_DESTINATION_IDENTITY" "$ADOPT_DESTINATION_DEVICE") \
    || die "copy verification failed, source remains at $ADOPT_SOURCE"
  [[ "$destination_digest" == "$ADOPT_SOURCE_TREE_DIGEST" ]] \
    || die "copy verification failed, source remains at $ADOPT_SOURCE"
  ADOPT_DESTINATION_TREE_DIGEST=$destination_digest
  source_digest=$(stable_tree_digest "$ADOPT_SOURCE" \
    "$ADOPT_SOURCE_IDENTITY" "$ADOPT_SOURCE_DEVICE") \
    || die "source manifest changed after copy, source remains at $ADOPT_SOURCE"
  [[ "$source_digest" == "$ADOPT_SOURCE_TREE_DIGEST" ]] \
    || die "source manifest changed after copy, source remains at $ADOPT_SOURCE"
  ADOPT_COPY_VERIFIED=true
}

adopt_staged_link_owned_at() { # path
  local identity target metadata device inode mode owner link_count
  [[ -n "$ADOPT_STAGED_LINK_IDENTITY" \
      && -n "$ADOPT_STAGED_LINK_TARGET" \
      && -n "$ADOPT_STAGED_LINK_MODE" && -L "$1" ]] || return 1
  metadata=$("$BSD_STAT" -f '%d:%i:%Lp:%u:%l' -- "$1" 2>/dev/null) \
    || return 1
  IFS=: read -r device inode mode owner link_count <<< "$metadata"
  identity=$device:$inode
  [[ "$identity" == "$ADOPT_STAGED_LINK_IDENTITY" ]] || return 1
  [[ "$mode" == "$ADOPT_STAGED_LINK_MODE" \
      && "$owner" == "$UID" && "$link_count" == 1 ]] || return 1
  private_path_acl_is_absent "$1" || return 1
  target=$(/usr/bin/readlink -- "$1" 2>/dev/null) || return 1
  [[ "$target" == "$ADOPT_STAGED_LINK_TARGET" ]]
}

cleanup_staged_link() {
  if [[ -z "$ADOPT_STAGED_LINK" \
      || ( ! -e "$ADOPT_STAGED_LINK" && ! -L "$ADOPT_STAGED_LINK" ) ]]; then
    return 0
  fi
  if ! adopt_staged_link_owned_at "$ADOPT_STAGED_LINK"; then
    printf 'vaultlock: staged link ownership changed, retained at %s\n' \
      "$ADOPT_STAGED_LINK" >&2
    return 1
  fi
  if ! rm -f -- "$ADOPT_STAGED_LINK" \
      || [[ -e "$ADOPT_STAGED_LINK" || -L "$ADOPT_STAGED_LINK" ]]; then
    printf 'vaultlock: cannot remove staged link, retained at %s\n' \
      "$ADOPT_STAGED_LINK" >&2
    return 1
  fi
}

adopt_original_tree_at() { # path
  local identity digest
  [[ -d "$1" && ! -L "$1" ]] || return 1
  identity=$(path_identity "$1") || return 1
  [[ "$identity" == "$ADOPT_SOURCE_IDENTITY" ]] || return 1
  digest=$(stable_tree_digest "$1" "$identity" "$ADOPT_SOURCE_DEVICE") \
    || return 1
  [[ "$digest" == "$ADOPT_SOURCE_TREE_DIGEST" ]]
}

adopt_backup_reservation_matches() {
  local metadata reservation_device reservation_inode reservation_mode
  local reservation_uid reservation_link_count
  [[ -n "$ADOPT_BACKUP_RESERVATION" \
    && -n "$ADOPT_BACKUP_RESERVATION_IDENTITY" \
    && -d "$ADOPT_BACKUP_RESERVATION" \
    && ! -L "$ADOPT_BACKUP_RESERVATION" ]] || return 1
  metadata=$("$BSD_STAT" -f '%d:%i:%Lp:%u:%l' -- \
    "$ADOPT_BACKUP_RESERVATION" 2>/dev/null) || return 1
  IFS=: read -r reservation_device reservation_inode reservation_mode \
    reservation_uid reservation_link_count <<< "$metadata"
  [[ "$reservation_device:$reservation_inode" \
    == "$ADOPT_BACKUP_RESERVATION_IDENTITY" \
    && "$reservation_device" == "$ADOPT_BACKUP_RESERVATION_DEVICE" \
      && "$reservation_mode" == 700 && "$reservation_uid" == "$UID" \
      && "$reservation_link_count" =~ ^[1-9][0-9]*$ ]] \
    && private_path_acl_is_absent "$ADOPT_BACKUP_RESERVATION"
}

remove_empty_adopt_backup_reservation() {
  adopt_backup_reservation_matches || return 1
  [[ ! -e "$ADOPT_BACKUP" && ! -L "$ADOPT_BACKUP" ]] || return 1
  "$RMDIR_COMMAND" -- "$ADOPT_BACKUP_RESERVATION" || return 1
  ADOPT_BACKUP_RESERVATION=""
  ADOPT_BACKUP_RESERVATION_IDENTITY=""
  ADOPT_BACKUP_RESERVATION_DEVICE=""
}

describe_adopt_rollback_locations() {
  local detail=""
  local display_backup=$ADOPT_SOURCE_DISPLAY.vaultlock-backup
  local display_staged_link=$ADOPT_SOURCE_DISPLAY.vaultlock-link
  if adopt_original_tree_at "$ADOPT_SOURCE"; then
    detail="original source restored at $ADOPT_SOURCE_DISPLAY"
  elif [[ -e "$ADOPT_SOURCE" || -L "$ADOPT_SOURCE" ]]; then
    run_named_transition adopt_reporting_before_source_classification \
      "$ADOPT_SOURCE" || return 1
    if adopt_staged_link_owned_at "$ADOPT_SOURCE"; then
      detail="replacement retained at $ADOPT_SOURCE_DISPLAY"
    elif [[ -e "$ADOPT_SOURCE" || -L "$ADOPT_SOURCE" ]]; then
      detail="unverified source entry retained at $ADOPT_SOURCE_DISPLAY"
    fi
  fi
  if adopt_original_tree_at "$ADOPT_BACKUP" \
    && adopt_backup_reservation_matches; then
    [[ -z "$detail" ]] || detail="$detail; "
    detail="${detail}data remains at $display_backup, backup retained at $display_backup"
  elif [[ -e "$ADOPT_BACKUP_RESERVATION" \
    || -L "$ADOPT_BACKUP_RESERVATION" \
    || -e "$ADOPT_BACKUP" || -L "$ADOPT_BACKUP" ]]; then
    [[ -z "$detail" ]] || detail="$detail; "
    detail="${detail}unverified backup retained at $display_backup"
  fi
  if [[ -e "$ADOPT_STAGED_LINK" || -L "$ADOPT_STAGED_LINK" ]]; then
    run_named_transition adopt_reporting_before_staged_classification \
      "$ADOPT_STAGED_LINK" || return 1
    [[ -z "$detail" ]] || detail="$detail; "
    if adopt_staged_link_owned_at "$ADOPT_STAGED_LINK"; then
      detail="${detail}staged link retained at $display_staged_link"
    else
      detail="${detail}unverified staged path retained at $display_staged_link"
    fi
  fi
  [[ -n "$detail" ]] \
    || detail="no adopt source or backup location could be verified"
  printf '%s\n' "$detail"
}

rollback_adopt_source() {
  local backup_identity backup_digest restored_identity restored_digest
  run_named_transition adopt_rollback_before_source_link_move "$ADOPT_BACKUP" \
    || return 1
  adopt_backup_reservation_matches || return 1
  [[ -d "$ADOPT_BACKUP" && ! -L "$ADOPT_BACKUP" ]] || return 1
  backup_identity=$(path_identity "$ADOPT_BACKUP") || return 1
  [[ "$backup_identity" == "$ADOPT_BACKUP_IDENTITY" ]] || return 1
  backup_digest=$(stable_tree_digest "$ADOPT_BACKUP" "$backup_identity" \
    "$ADOPT_BACKUP_DEVICE") || return 1
  [[ "$backup_digest" == "$ADOPT_BACKUP_TREE_DIGEST" ]] || return 1
  if [[ -e "$ADOPT_SOURCE" || -L "$ADOPT_SOURCE" ]]; then
    adopt_staged_link_owned_at "$ADOPT_SOURCE" || return 1
    [[ ! -e "$ADOPT_STAGED_LINK" && ! -L "$ADOPT_STAGED_LINK" ]] \
      || return 1
    mv -n -- "$ADOPT_SOURCE" "$ADOPT_STAGED_LINK" || return 1
    [[ ! -e "$ADOPT_SOURCE" && ! -L "$ADOPT_SOURCE" ]] || return 1
    adopt_staged_link_owned_at "$ADOPT_STAGED_LINK" || return 1
  fi
  [[ ! -e "$ADOPT_SOURCE" && ! -L "$ADOPT_SOURCE" ]] || return 1
  [[ -d "$ADOPT_PARENT" && ! -L "$ADOPT_PARENT" \
    && "$(path_identity "$ADOPT_PARENT")" == "$ADOPT_PARENT_IDENTITY" ]] \
    || return 1
  [[ -d "$ADOPT_BACKUP" && ! -L "$ADOPT_BACKUP" ]] || return 1
  backup_identity=$(path_identity "$ADOPT_BACKUP") || return 1
  [[ "$backup_identity" == "$ADOPT_SOURCE_IDENTITY" ]] || return 1
  backup_digest=$(stable_tree_digest "$ADOPT_BACKUP" "$backup_identity" \
    "$ADOPT_SOURCE_DEVICE") || return 1
  [[ "$backup_digest" == "$ADOPT_SOURCE_TREE_DIGEST" ]] || return 1
  mv -hn -- "$ADOPT_BACKUP" "$ADOPT_PARENT" || return 1
  [[ ! -e "$ADOPT_BACKUP" && ! -L "$ADOPT_BACKUP" ]] || return 1
  restored_identity=$(path_identity "$ADOPT_SOURCE") || return 1
  restored_digest=$(stable_tree_digest "$ADOPT_SOURCE" "$restored_identity" \
    "$ADOPT_SOURCE_DEVICE") || restored_digest=""
  if [[ "$restored_identity" != "$ADOPT_SOURCE_IDENTITY" \
      || "$restored_digest" != "$ADOPT_SOURCE_TREE_DIGEST" ]]; then
    if [[ -d "$ADOPT_SOURCE" && ! -L "$ADOPT_SOURCE" \
        && ! -e "$ADOPT_BACKUP" && ! -L "$ADOPT_BACKUP" ]]; then
    mv -hn -- "$ADOPT_SOURCE" "$ADOPT_BACKUP_RESERVATION" || return 1
    fi
    return 1
  fi
  remove_empty_adopt_backup_reservation || return 1
  cleanup_staged_link
}

cleanup_adopt_transaction_after_signal() { # signal
  local signal=$1 detail="" rollback_status=1
  case "$ADOPT_TRANSACTION_PHASE" in
    preparing)
      if adopt_original_tree_at "$ADOPT_SOURCE"; then
        detail="original source remains at $ADOPT_SOURCE_DISPLAY"
      else
        detail="original source could not be verified at $ADOPT_SOURCE_DISPLAY"
      fi
      if [[ -e "$ADOPT_STAGED_LINK" || -L "$ADOPT_STAGED_LINK" ]]; then
        if cleanup_staged_link; then
          detail="$detail, owned staged link removed"
        else
          detail="$detail, staged path retained at $ADOPT_STAGED_LINK"
        fi
      fi
      if [[ -e "$ADOPT_BACKUP_RESERVATION" \
          || -L "$ADOPT_BACKUP_RESERVATION" ]]; then
        if remove_empty_adopt_backup_reservation; then
          detail="$detail, owned backup reservation removed"
        else
          detail="$detail, backup reservation retained at $ADOPT_BACKUP_RESERVATION"
        fi
      fi
      ;;
    staging)
      if adopt_original_tree_at "$ADOPT_SOURCE"; then
        cleanup_staged_link || true
        detail="original source remains at $ADOPT_SOURCE_DISPLAY"
        if [[ -e "$ADOPT_BACKUP_RESERVATION" \
            || -L "$ADOPT_BACKUP_RESERVATION" ]]; then
          if remove_empty_adopt_backup_reservation; then
            detail="$detail, owned backup reservation removed"
          else
            detail="$detail, backup reservation retained at $ADOPT_BACKUP_RESERVATION"
          fi
        fi
      else
        detail="adopt staging state could not be verified"
      fi
      ;;
    backup|installed)
      if rollback_adopt_source; then
        rollback_status=0
        detail="original source restored at $ADOPT_SOURCE_DISPLAY"
      fi
      if [[ "$rollback_status" -ne 0 ]]; then
        if adopt_original_tree_at "$ADOPT_BACKUP" \
            && adopt_backup_reservation_matches; then
          detail="verified backup retained at $ADOPT_BACKUP"
        elif adopt_original_tree_at "$ADOPT_SOURCE"; then
          detail="original source verified at $ADOPT_SOURCE_DISPLAY"
        elif adopt_link_matches && adopt_destination_manifest_matches; then
          detail="installed replacement verified at $ADOPT_SOURCE_DISPLAY"
        else
          detail="adopt transaction could not be verified, inspect $ADOPT_SOURCE_DISPLAY and $ADOPT_BACKUP_RESERVATION"
        fi
      fi
      ;;
    quarantined)
      if adopt_quarantined_backup_matches; then
        detail="verified backup retained at $ADOPT_BACKUP_QUARANTINE/backup"
      elif adopt_link_matches && adopt_destination_manifest_matches; then
        detail="installed replacement verified at $ADOPT_SOURCE_DISPLAY, inspect $ADOPT_BACKUP_QUARANTINE"
      else
        detail="adopt quarantine could not be verified, inspect $ADOPT_BACKUP_QUARANTINE"
      fi
      ;;
    complete)
      if adopt_link_matches && adopt_destination_manifest_matches; then
        detail="installed replacement verified at $ADOPT_SOURCE_DISPLAY"
      else
        detail="completed adopt target could not be verified at $ADOPT_SOURCE_DISPLAY"
      fi
      ;;
    *)
      detail="adopt transaction phase is unknown"
      ;;
  esac
  ADOPT_TRANSACTION_PHASE=none
  printf 'vaultlock: adopt interrupted by %s: %s\n' "$signal" "$detail" >&2
}

abort_adopt_replacement_with_rollback() { # reason
  local detail rollback_status
  if rollback_adopt_source; then
    rollback_status=0
  else
    rollback_status=$?
  fi
  detail=$(describe_adopt_rollback_locations) \
    || detail="no adopt source or backup location could be verified"
  if [[ "$rollback_status" -eq 0 ]]; then
    die "$1, $detail"
  fi
  die "$1, rollback incomplete; $detail"
}

adopt_mount_identity_matches() {
  local identity actual_uuid actual_device
  identity=$(read_apfs_identity "$MOUNT_POINT") || return 1
  IFS=$'\t' read -r actual_uuid actual_device <<< "$identity"
  [[ "$actual_uuid" == "$PLAN_CONTEXT_UUID" \
    && "$actual_device" == "$PLAN_CONTEXT_DEVICE" ]]
}

adopt_link_matches() {
  local link_target
  link_target=$(readlink "$ADOPT_SOURCE" 2>/dev/null) || return 1
  [[ -L "$ADOPT_SOURCE" && "$link_target" == "$ADOPT_DESTINATION" ]]
}

adopt_destination_manifest_matches() {
  local digest
  [[ ! -L "$ADOPT_DESTINATION" && -d "$ADOPT_DESTINATION" ]] || return 1
  [[ "$(path_identity "$ADOPT_DESTINATION")" \
    == "$ADOPT_DESTINATION_IDENTITY" ]] || return 1
  digest=$(stable_tree_digest "$ADOPT_DESTINATION" \
    "$ADOPT_DESTINATION_IDENTITY" "$ADOPT_DESTINATION_DEVICE") || return 1
  [[ "$digest" == "$ADOPT_DESTINATION_TREE_DIGEST" ]]
}

adopt_quarantine_envelope_matches() {
  [[ "$(path_identity "$ADOPT_PARENT")" == "$ADOPT_PARENT_IDENTITY" ]] \
    || return 1
  [[ ! -L "$ADOPT_BACKUP_QUARANTINE" \
    && -d "$ADOPT_BACKUP_QUARANTINE" ]] || return 1
  private_directory_is_valid "$ADOPT_BACKUP_QUARANTINE" \
    "$ADOPT_BACKUP_QUARANTINE_IDENTITY" 700 || return 1
  adopt_link_matches || return 1
  adopt_destination_manifest_matches || return 1
  adopt_mount_identity_matches || return 1
}

adopt_quarantined_backup_matches() {
  local quarantined=$ADOPT_BACKUP_QUARANTINE/backup digest
  adopt_quarantine_envelope_matches || return 1
  [[ ! -e "$ADOPT_BACKUP" && ! -L "$ADOPT_BACKUP" ]] || return 1
  [[ ! -L "$quarantined" && -d "$quarantined" ]] || return 1
  [[ "$(path_identity "$quarantined")" == "$ADOPT_BACKUP_IDENTITY" ]] \
    || return 1
  [[ "$("$BSD_STAT" -f '%d' -- "$quarantined" 2>/dev/null)" \
    == "$ADOPT_BACKUP_DEVICE" ]] || return 1
  digest=$(stable_tree_digest "$quarantined" "$ADOPT_BACKUP_IDENTITY" \
    "$ADOPT_BACKUP_DEVICE") || return 1
  [[ "$digest" == "$ADOPT_BACKUP_TREE_DIGEST" ]]
}

tree_is_confined() { # root expected_identity expected_device
  local root=$1 expected_identity=$2 expected_device=$3 path device
  [[ ! -L "$root" && -d "$root" ]] || return 1
  [[ "$(path_identity "$root")" == "$expected_identity" ]] || return 1
  if ! LC_ALL=C "$BSD_FIND" -P -s -x "$root" -print0 \
      | while IFS= read -r -d '' path; do
      device=$("$BSD_STAT" -f '%d' -- "$path" 2>/dev/null) || return 1
      [[ "$device" == "$expected_device" ]] || return 1
      [[ -L "$path" || -d "$path" || -f "$path" ]] || return 1
      done; then
    return 1
  fi
  [[ "$(path_identity "$root")" == "$expected_identity" ]]
}

adopt_quarantined_backup_is_empty_tree() {
  local quarantined=$ADOPT_BACKUP_QUARANTINE/backup remaining
  adopt_quarantine_envelope_matches || return 1
  [[ ! -L "$quarantined" && -d "$quarantined" ]] || return 1
  [[ "$(path_identity "$quarantined")" == "$ADOPT_BACKUP_IDENTITY" ]] \
    || return 1
  tree_is_confined "$quarantined" "$ADOPT_BACKUP_IDENTITY" \
    "$ADOPT_BACKUP_DEVICE" || return 1
  remaining=$("$BSD_FIND" -P -s -x "$quarantined" ! -type d \
    -print -quit) \
    || return 1
  [[ -z "$remaining" ]]
}

file_sha256_digest() { # path
  local output
  output=$(/usr/bin/shasum -a 256 < "$1" 2>/dev/null) || return 1
  sha256_output_digest "$output"
}

verify_adopt_directory_skeleton() {
  local digest
  adopt_quarantine_envelope_matches || return 1
  [[ -f "$ADOPT_DIRECTORY_SKELETON" \
    && ! -L "$ADOPT_DIRECTORY_SKELETON" ]] || return 1
  private_file_is_valid "$ADOPT_DIRECTORY_SKELETON" \
    "$ADOPT_DIRECTORY_SKELETON_IDENTITY" 600 1 || return 1
  digest=$(file_sha256_digest "$ADOPT_DIRECTORY_SKELETON") || return 1
  [[ "$digest" == "$ADOPT_DIRECTORY_SKELETON_DIGEST" ]]
}

capture_adopt_directory_skeleton() { # output
  local output=$1 root=$ADOPT_BACKUP_QUARANTINE/backup
  local path relative identity mode device
  if ! LC_ALL=C "$BSD_FIND" -P -s -x "$root" -depth -type d -print0 \
      | while IFS= read -r -d '' path; do
        if [[ "$path" == "$root" ]]; then
          relative=.
        elif [[ "$path" == "$root/"* ]]; then
          relative=${path#"$root/"}
        else
          return 1
        fi
        device=$("$BSD_STAT" -f '%d' -- "$path" 2>/dev/null) || return 1
        [[ "$device" == "$ADOPT_BACKUP_DEVICE" ]] || return 1
        identity=$(path_identity "$path") || return 1
        mode=$(path_mode "$path") || return 1
        printf '%s\0%s\0%s\0' "$relative" "$identity" "$mode" \
          >> "$output" || return 1
      done; then
    return 1
  fi
}

create_adopt_directory_skeleton() {
  ADOPT_DIRECTORY_SKELETON=$ADOPT_BACKUP_QUARANTINE/.directory-skeleton
  if ! (umask 077; set -o noclobber; : > "$ADOPT_DIRECTORY_SKELETON") \
      2>/dev/null; then
    die "cannot create protected directory skeleton, quarantine retained at $ADOPT_BACKUP_QUARANTINE"
  fi
  ADOPT_DIRECTORY_SKELETON_IDENTITY=$(path_identity \
    "$ADOPT_DIRECTORY_SKELETON") \
    || die "cannot capture directory skeleton identity, quarantine retained at $ADOPT_BACKUP_QUARANTINE"
  run_named_transition adopt_after_directory_skeleton_created \
    "$ADOPT_DIRECTORY_SKELETON"
  "$CHMOD_COMMAND" -N "$ADOPT_DIRECTORY_SKELETON" \
    || die "cannot remove directory skeleton ACL, quarantine retained at $ADOPT_BACKUP_QUARANTINE"
  "$CHMOD_COMMAND" 600 "$ADOPT_DIRECTORY_SKELETON" \
    || die "cannot protect directory skeleton, quarantine retained at $ADOPT_BACKUP_QUARANTINE"
  private_file_is_valid "$ADOPT_DIRECTORY_SKELETON" \
    "$ADOPT_DIRECTORY_SKELETON_IDENTITY" 600 1 \
    || die "directory skeleton metadata is unsafe, quarantine retained at $ADOPT_BACKUP_QUARANTINE"
  if ! capture_adopt_directory_skeleton "$ADOPT_DIRECTORY_SKELETON"; then
    die "cannot capture directory skeleton, quarantine retained at $ADOPT_BACKUP_QUARANTINE"
  fi
  ADOPT_DIRECTORY_SKELETON_DIGEST=$(file_sha256_digest \
    "$ADOPT_DIRECTORY_SKELETON") \
    || die "cannot digest directory skeleton, quarantine retained at $ADOPT_BACKUP_QUARANTINE"
  verify_adopt_directory_skeleton \
    || die "directory skeleton verification failed, quarantine retained at $ADOPT_BACKUP_QUARANTINE"
}

delete_captured_adopt_directories() {
  local root=$ADOPT_BACKUP_QUARANTINE/backup relative identity mode path device
  local current_skeleton current_skeleton_identity
  run_named_transition adopt_before_directory_skeleton_cleanup \
    "$ADOPT_DIRECTORY_SKELETON"
  verify_adopt_directory_skeleton \
    || die "directory skeleton changed, quarantine retained at $ADOPT_BACKUP_QUARANTINE"
  current_skeleton=$("$MKTEMP_COMMAND" \
    "$ADOPT_BACKUP_QUARANTINE/.directory-current.XXXXXX") \
    || die "cannot create current directory snapshot, quarantine retained at $ADOPT_BACKUP_QUARANTINE"
  current_skeleton_identity=$(path_identity "$current_skeleton") \
    || die "cannot capture current directory snapshot identity, quarantine retained at $ADOPT_BACKUP_QUARANTINE"
  "$CHMOD_COMMAND" -N "$current_skeleton" \
    || die "cannot remove current directory snapshot ACL, quarantine retained at $ADOPT_BACKUP_QUARANTINE"
  "$CHMOD_COMMAND" 600 "$current_skeleton" \
    || die "cannot protect current directory snapshot, quarantine retained at $ADOPT_BACKUP_QUARANTINE"
  private_file_is_valid "$current_skeleton" "$current_skeleton_identity" \
    600 1 \
    || die "current directory snapshot metadata is unsafe, quarantine retained at $ADOPT_BACKUP_QUARANTINE"
  if ! capture_adopt_directory_skeleton "$current_skeleton"; then
    remove_verified_private_file "$current_skeleton" \
      "$current_skeleton_identity" \
      || die "current directory snapshot changed, retained at $current_skeleton, quarantine retained at $ADOPT_BACKUP_QUARANTINE"
    die "directory cleanup boundary changed, quarantine retained at $ADOPT_BACKUP_QUARANTINE"
  fi
  run_named_transition adopt_before_current_directory_snapshot_cleanup \
    "$current_skeleton"
  private_file_is_valid "$current_skeleton" "$current_skeleton_identity" \
    600 1 \
    || die "current directory snapshot changed, retained at $current_skeleton, quarantine retained at $ADOPT_BACKUP_QUARANTINE"
  if ! /usr/bin/cmp -s "$ADOPT_DIRECTORY_SKELETON" "$current_skeleton"; then
    remove_verified_private_file "$current_skeleton" \
      "$current_skeleton_identity" \
      || die "current directory snapshot changed, retained at $current_skeleton, quarantine retained at $ADOPT_BACKUP_QUARANTINE"
    die "directory cleanup boundary changed, quarantine retained at $ADOPT_BACKUP_QUARANTINE"
  fi
  remove_verified_private_file "$current_skeleton" \
    "$current_skeleton_identity" \
    || die "current directory snapshot cleanup failed, retained at $current_skeleton, quarantine retained at $ADOPT_BACKUP_QUARANTINE"
  while IFS= read -r -d '' relative \
      && IFS= read -r -d '' identity \
      && IFS= read -r -d '' mode; do
    if [[ "$relative" == "." ]]; then
      path=$root
    else
      path=$root/$relative
    fi
    [[ ! -L "$path" && -d "$path" ]] \
      || die "captured directory changed type, quarantine retained at $ADOPT_BACKUP_QUARANTINE"
    [[ "$(path_identity "$path")" == "$identity" \
      && "$(path_mode "$path")" == "$mode" ]] \
      || die "captured directory identity changed, quarantine retained at $ADOPT_BACKUP_QUARANTINE"
    device=$("$BSD_STAT" -f '%d' -- "$path" 2>/dev/null) \
      || die "captured directory device unavailable, quarantine retained at $ADOPT_BACKUP_QUARANTINE"
    [[ "$device" == "$ADOPT_BACKUP_DEVICE" ]] \
      || die "captured directory device changed, quarantine retained at $ADOPT_BACKUP_QUARANTINE"
    rmdir "$path" \
      || die "captured directory removal failed, quarantine retained at $ADOPT_BACKUP_QUARANTINE"
  done < "$ADOPT_DIRECTORY_SKELETON"
}

create_adopt_backup_quarantine() {
  local quarantine
  assert_path_identity "$ADOPT_PARENT" "$ADOPT_PARENT_IDENTITY" \
    "source parent"
  quarantine=$(mktemp -d "$ADOPT_SOURCE.vaultlock-quarantine.XXXXXX") \
    || die "cannot create backup quarantine after replacement"
  ADOPT_BACKUP_QUARANTINE=$quarantine
  ADOPT_BACKUP_QUARANTINE_IDENTITY=$(path_identity \
    "$ADOPT_BACKUP_QUARANTINE") \
    || die "cannot capture backup quarantine identity, quarantine retained at $ADOPT_BACKUP_QUARANTINE"
  "$CHMOD_COMMAND" -N "$ADOPT_BACKUP_QUARANTINE" \
    || die "cannot remove backup quarantine ACL, quarantine retained at $ADOPT_BACKUP_QUARANTINE"
  "$CHMOD_COMMAND" 700 "$ADOPT_BACKUP_QUARANTINE" \
    || die "cannot protect backup quarantine, quarantine retained at $ADOPT_BACKUP_QUARANTINE"
  adopt_quarantine_envelope_matches \
    || die "backup quarantine verification failed, quarantine retained at $ADOPT_BACKUP_QUARANTINE"
}

quarantine_adopt_backup() {
  local quarantined
  create_adopt_backup_quarantine
  quarantined=$ADOPT_BACKUP_QUARANTINE/backup
  if ! mv -n -- "$ADOPT_BACKUP" "$quarantined"; then
    die "cannot quarantine backup, backup retained at $ADOPT_BACKUP, quarantine retained at $ADOPT_BACKUP_QUARANTINE"
  fi
  run_named_transition adopt_after_backup_quarantine_move \
    "$ADOPT_BACKUP_QUARANTINE"
  adopt_quarantined_backup_matches \
    || die "backup quarantine verification failed, quarantine retained at $ADOPT_BACKUP_QUARANTINE"
  ADOPT_TRANSACTION_PHASE=quarantined
  dispatch_deferred_operation_signal
  remove_empty_adopt_backup_reservation \
    || die "backup reservation cleanup failed, quarantine retained at $ADOPT_BACKUP_QUARANTINE, reservation retained at $ADOPT_BACKUP_RESERVATION"
  create_adopt_directory_skeleton
}

delete_quarantined_adopt_backup() {
  local quarantined=$ADOPT_BACKUP_QUARANTINE/backup
  adopt_quarantined_backup_matches \
    || die "backup deletion boundary changed, quarantine retained at $ADOPT_BACKUP_QUARANTINE"
  "$BSD_FIND" -P -x "$quarantined" -depth ! -type d \
    -exec /bin/rm -f -- {} + \
    || die "replacement succeeded but backup cleanup failed, quarantine retained at $ADOPT_BACKUP_QUARANTINE"
  adopt_quarantined_backup_is_empty_tree \
    || die "backup cleanup boundary changed, quarantine retained at $ADOPT_BACKUP_QUARANTINE"
  delete_captured_adopt_directories
  [[ ! -e "$quarantined" && ! -L "$quarantined" ]] \
    || die "replacement succeeded but quarantined backup remains at $quarantined"
  remove_verified_private_file "$ADOPT_DIRECTORY_SKELETON" \
    "$ADOPT_DIRECTORY_SKELETON_IDENTITY" \
    || die "directory skeleton cleanup failed, quarantine retained at $ADOPT_BACKUP_QUARANTINE"
  [[ ! -e "$ADOPT_DIRECTORY_SKELETON" \
      && ! -L "$ADOPT_DIRECTORY_SKELETON" ]] \
    || die "directory skeleton retained at $ADOPT_DIRECTORY_SKELETON"
  adopt_quarantine_envelope_matches \
    || die "backup quarantine boundary changed, quarantine retained at $ADOPT_BACKUP_QUARANTINE"
  rmdir -- "$ADOPT_BACKUP_QUARANTINE" \
    || die "replacement succeeded but backup quarantine remains at $ADOPT_BACKUP_QUARANTINE"
  ADOPT_BACKUP=""
  ADOPT_BACKUP_QUARANTINE=""
  ADOPT_BACKUP_QUARANTINE_IDENTITY=""
  ADOPT_DIRECTORY_SKELETON=""
  ADOPT_DIRECTORY_SKELETON_IDENTITY=""
  ADOPT_DIRECTORY_SKELETON_DIGEST=""
}

execute_adopt_replace_source() {
  local link_target backup_digest backup_candidate move_status
  local backup_identity backup_device staged_metadata staged_device
  local staged_inode staged_owner staged_link_count
  [[ "$ADOPT_COPY_VERIFIED" == "true" ]] \
    || die "adopt replacement requires verified copy"
  assert_adopt_source_manifest \
    "source manifest changed before replacement, source remains at $ADOPT_SOURCE"
  assert_adopt_destination_manifest \
    "destination manifest changed before replacement, source remains at $ADOPT_SOURCE"
  verify_adopt_mount_identity
  [[ ! -e "$ADOPT_STAGED_LINK" && ! -L "$ADOPT_STAGED_LINK" \
      && ! -e "$ADOPT_BACKUP" && ! -L "$ADOPT_BACKUP" ]] \
    || die "adopt staging paths already exist"
  ADOPT_TRANSACTION_PHASE=preparing
  begin_operation_signal_deferral
  ln -s -- "$ADOPT_DESTINATION" "$ADOPT_STAGED_LINK" || {
    dispatch_deferred_operation_signal
    die "cannot stage replacement symlink, source remains unchanged"
  }
  "$CHMOD_COMMAND" -h -N "$ADOPT_STAGED_LINK" || {
    dispatch_deferred_operation_signal
    die "cannot remove staged link ACL, staged link retained at $ADOPT_STAGED_LINK"
  }
  staged_metadata=$("$BSD_STAT" -f '%d:%i:%Lp:%u:%l' -- \
    "$ADOPT_STAGED_LINK" 2>/dev/null) || {
    dispatch_deferred_operation_signal
    die "cannot capture staged link identity, staged link retained at $ADOPT_STAGED_LINK"
  }
  IFS=: read -r staged_device staged_inode ADOPT_STAGED_LINK_MODE \
    staged_owner staged_link_count <<< "$staged_metadata"
  ADOPT_STAGED_LINK_IDENTITY=$staged_device:$staged_inode
  [[ "$staged_owner" == "$UID" && "$staged_link_count" == 1 ]] || {
    dispatch_deferred_operation_signal
    die "staged link metadata is unsafe, staged link retained at $ADOPT_STAGED_LINK"
  }
  ADOPT_STAGED_LINK_TARGET=$(/usr/bin/readlink -- "$ADOPT_STAGED_LINK" \
    2>/dev/null) || {
    dispatch_deferred_operation_signal
    die "cannot capture staged link target, staged link retained at $ADOPT_STAGED_LINK"
  }
  [[ "$ADOPT_STAGED_LINK_TARGET" == "$ADOPT_DESTINATION" ]] || {
    dispatch_deferred_operation_signal
    die "staged link target changed, staged link retained at $ADOPT_STAGED_LINK"
  }
  adopt_staged_link_owned_at "$ADOPT_STAGED_LINK" || {
    dispatch_deferred_operation_signal
    die "staged link identity changed, staged link retained at $ADOPT_STAGED_LINK"
  }
  run_named_transition adopt_after_staged_link_created "$ADOPT_STAGED_LINK"
  dispatch_deferred_operation_signal
  assert_adopt_source_manifest \
    "source manifest changed before backup move, staged link retained at $ADOPT_STAGED_LINK"
  dispatch_deferred_operation_signal
  assert_adopt_destination_manifest \
    "destination manifest changed before backup move, staged link retained at $ADOPT_STAGED_LINK"
  dispatch_deferred_operation_signal
  verify_adopt_mount_identity
  dispatch_deferred_operation_signal
  backup_candidate=$ADOPT_BACKUP
  run_named_transition adopt_before_backup_move "$backup_candidate"
  dispatch_deferred_operation_signal
  if [[ -e "$backup_candidate" || -L "$backup_candidate" ]]; then
    cleanup_staged_link \
      || die "source backup path changed before move, source remains unchanged, staged link retained at $ADOPT_STAGED_LINK"
    die "source backup path changed before move, source remains unchanged"
  fi
  if ! "$MKDIR_COMMAND" -m 700 -- "$backup_candidate" 2>/dev/null; then
    dispatch_deferred_operation_signal
    cleanup_staged_link \
      || die "cannot reserve source backup path, source remains unchanged, staged link retained at $ADOPT_STAGED_LINK"
    die "cannot reserve source backup path, source remains unchanged"
  fi
  ADOPT_BACKUP_RESERVATION=$backup_candidate
  ADOPT_BACKUP_RESERVATION_IDENTITY=$(path_identity \
    "$ADOPT_BACKUP_RESERVATION") || {
    dispatch_deferred_operation_signal
    die "cannot verify source backup reservation, source remains unchanged, reservation retained at $ADOPT_BACKUP_RESERVATION"
  }
  "$CHMOD_COMMAND" -N "$ADOPT_BACKUP_RESERVATION" || {
    dispatch_deferred_operation_signal
    die "cannot remove backup reservation ACL, source remains unchanged, reservation retained at $ADOPT_BACKUP_RESERVATION"
  }
  "$CHMOD_COMMAND" 700 "$ADOPT_BACKUP_RESERVATION" || {
    dispatch_deferred_operation_signal
    die "cannot protect backup reservation, source remains unchanged, reservation retained at $ADOPT_BACKUP_RESERVATION"
  }
  ADOPT_BACKUP_RESERVATION_DEVICE=$(
    "$BSD_STAT" -f '%d' -- "$ADOPT_BACKUP_RESERVATION" 2>/dev/null
  ) || {
    dispatch_deferred_operation_signal
    die "cannot verify source backup reservation device, source remains unchanged, reservation retained at $ADOPT_BACKUP_RESERVATION"
  }
  ADOPT_BACKUP=$ADOPT_BACKUP_RESERVATION/${ADOPT_SOURCE##*/}
  adopt_backup_reservation_matches || {
    dispatch_deferred_operation_signal
    die "source backup reservation changed, source remains unchanged, reservation retained at $ADOPT_BACKUP_RESERVATION"
  }
  [[ ! -e "$ADOPT_BACKUP" && ! -L "$ADOPT_BACKUP" ]] || {
    dispatch_deferred_operation_signal
    die "source backup reservation is not empty, source remains unchanged, reservation retained at $ADOPT_BACKUP_RESERVATION"
  }
  run_named_transition adopt_after_backup_reservation_created \
    "$ADOPT_BACKUP_RESERVATION"
  dispatch_deferred_operation_signal
  ADOPT_TRANSACTION_PHASE=staging
  if "$MV_COMMAND" -hn -- "$ADOPT_SOURCE" "$ADOPT_BACKUP_RESERVATION"; then
    move_status=0
  else
    move_status=$?
  fi
  if [[ ! -e "$ADOPT_SOURCE" && ! -L "$ADOPT_SOURCE" \
    && -d "$ADOPT_BACKUP" && ! -L "$ADOPT_BACKUP" \
    && "$(path_identity "$ADOPT_BACKUP")" == "$ADOPT_SOURCE_IDENTITY" ]]; then
    :
  elif [[ -d "$ADOPT_SOURCE" && ! -L "$ADOPT_SOURCE" \
    && "$(path_identity "$ADOPT_SOURCE")" == "$ADOPT_SOURCE_IDENTITY" \
      && ! -e "$ADOPT_BACKUP" && ! -L "$ADOPT_BACKUP" ]]; then
    dispatch_deferred_operation_signal
    remove_empty_adopt_backup_reservation || \
      die "cannot stage source backup, source remains unchanged, backup reservation retained at $ADOPT_BACKUP_RESERVATION"
    cleanup_staged_link \
      || die "cannot stage source backup, source remains unchanged, staged link retained at $ADOPT_STAGED_LINK"
    ADOPT_TRANSACTION_PHASE=none
    end_operation_signal_deferral
    die "cannot stage source backup, source remains unchanged"
  else
    dispatch_deferred_operation_signal
    die "source backup move ended in an ambiguous state (status $move_status), inspect $ADOPT_SOURCE and $ADOPT_BACKUP_RESERVATION"
  fi
  ADOPT_BACKUP_IDENTITY=$ADOPT_SOURCE_IDENTITY
  ADOPT_BACKUP_DEVICE=$ADOPT_SOURCE_DEVICE
  ADOPT_BACKUP_TREE_DIGEST=$ADOPT_SOURCE_TREE_DIGEST
  ADOPT_TRANSACTION_PHASE=backup
  run_named_transition adopt_after_backup_move "$ADOPT_BACKUP"
  dispatch_deferred_operation_signal
  backup_identity=$(path_identity "$ADOPT_BACKUP") || {
    dispatch_deferred_operation_signal
    abort_adopt_replacement_with_rollback \
      "cannot verify staged source backup"
  }
  [[ "$backup_identity" == "$ADOPT_SOURCE_IDENTITY" ]] || {
    abort_adopt_replacement_with_rollback \
      "staged source backup identity changed"
  }
  backup_device=$("$BSD_STAT" -f '%d' -- "$ADOPT_BACKUP" \
    2>/dev/null) || {
    dispatch_deferred_operation_signal
    abort_adopt_replacement_with_rollback \
      "cannot verify staged source backup device"
  }
  [[ "$backup_device" == "$ADOPT_SOURCE_DEVICE" ]] \
    || abort_adopt_replacement_with_rollback \
      "staged source backup device changed"
  backup_digest=$(stable_tree_digest "$ADOPT_BACKUP" \
    "$backup_identity" "$backup_device") || {
    dispatch_deferred_operation_signal
    abort_adopt_replacement_with_rollback \
      "cannot verify staged source backup manifest"
  }
  dispatch_deferred_operation_signal
  [[ "$backup_digest" == "$ADOPT_SOURCE_TREE_DIGEST" ]] \
    || abort_adopt_replacement_with_rollback \
      "staged source backup manifest changed"
  ADOPT_BACKUP_IDENTITY=$backup_identity
  ADOPT_BACKUP_DEVICE=$backup_device
  ADOPT_BACKUP_TREE_DIGEST=$backup_digest
  run_named_transition adopt_after_backup_verified "$ADOPT_DESTINATION"
  adopt_destination_manifest_matches \
    || abort_adopt_replacement_with_rollback \
      "destination manifest changed after backup move"
  adopt_mount_identity_matches \
    || abort_adopt_replacement_with_rollback \
      "mounted vault identity changed after backup move"
  if ! mv -n -- "$ADOPT_STAGED_LINK" "$ADOPT_SOURCE" \
      || [[ -e "$ADOPT_STAGED_LINK" || -L "$ADOPT_STAGED_LINK" ]]; then
    abort_adopt_replacement_with_rollback "replacement failed"
  fi
  link_target=$(readlink "$ADOPT_SOURCE" 2>/dev/null) || link_target=""
  if [[ ! -L "$ADOPT_SOURCE" || "$link_target" != "$ADOPT_DESTINATION" ]] \
      || ! adopt_staged_link_owned_at "$ADOPT_SOURCE"; then
    abort_adopt_replacement_with_rollback "replacement verification failed"
  fi
  ADOPT_TRANSACTION_PHASE=installed
  run_named_transition adopt_after_installed_link_verified "$ADOPT_SOURCE"
  dispatch_deferred_operation_signal
  ADOPT_BACKUP_IDENTITY=$(path_identity "$ADOPT_BACKUP") \
    || die "cannot verify backup before cleanup, backup retained at $ADOPT_BACKUP"
  [[ "$ADOPT_BACKUP_IDENTITY" == "$ADOPT_SOURCE_IDENTITY" \
      && -d "$ADOPT_BACKUP" && ! -L "$ADOPT_BACKUP" ]] \
    || die "backup identity changed before cleanup, backup retained at $ADOPT_BACKUP"
  backup_digest=$(stable_tree_digest "$ADOPT_BACKUP" \
    "$ADOPT_BACKUP_IDENTITY" "$ADOPT_BACKUP_DEVICE") \
    || die "cannot verify backup manifest before cleanup, backup retained at $ADOPT_BACKUP"
  [[ "$backup_digest" == "$ADOPT_BACKUP_TREE_DIGEST" ]] \
    || die "backup manifest changed before cleanup, backup retained at $ADOPT_BACKUP"
  adopt_destination_manifest_matches \
    || die "destination changed before backup cleanup, backup retained at $ADOPT_BACKUP"
  adopt_mount_identity_matches \
    || die "mounted vault changed before backup cleanup, backup retained at $ADOPT_BACKUP"
  dispatch_deferred_operation_signal
  quarantine_adopt_backup
  dispatch_deferred_operation_signal
  delete_quarantined_adopt_backup
  ADOPT_TRANSACTION_PHASE=complete
  end_operation_signal_deferral
  ADOPT_TRANSACTION_PHASE=none
}

verify_adopt_target() {
  local link_target
  link_target=$(readlink "$ADOPT_SOURCE" 2>/dev/null) || link_target=""
  [[ -L "$ADOPT_SOURCE" && "$link_target" == "$ADOPT_DESTINATION" ]] \
    || die "adopted source is not the expected symlink"
  assert_path_identity "$ADOPT_DESTINATION" "$ADOPT_DESTINATION_IDENTITY" "destination"
  verify_adopt_mount_identity
}

sha256_of() {
  printf '%s' "$1" | /usr/bin/shasum -a 256 | /usr/bin/cut -d' ' -f1
}

protected_file_signature() { # path required_mode allowed_links allow_absent
  local path=$1 required_mode=$2 allowed_links=$3 allow_absent=$4
  local metadata digest device inode mode owner link_count
  if [[ ! -e "$path" && ! -L "$path" ]]; then
    [[ "$allow_absent" == true ]] || return 1
    printf 'absent\n'
    return
  fi
  [[ -f "$path" && ! -L "$path" ]] || return 1
  metadata=$("$BSD_STAT" -f '%d:%i:%Lp:%u:%l' -- "$path" 2>/dev/null) \
    || return 1
  IFS=: read -r device inode mode owner link_count <<< "$metadata"
  [[ "$owner" == "$UID" \
    && ( -z "$required_mode" || "$mode" == "$required_mode" ) ]] \
    || return 1
  case ",$allowed_links," in
    *,$link_count,*) ;;
    *) return 1 ;;
  esac
  private_path_acl_is_absent "$path" || return 1
  digest=$(operation_owner_digest "$path") || return 1
  printf '%s:%s:%s:%s:%s:%s\n' \
    "$device" "$inode" "$mode" "$owner" "$link_count" "$digest"
}

unlock_file_signature() { # path [required_mode]
  protected_file_signature "$1" "${2:-}" 1 true
}

unlock_state_directory_signature() {
  local metadata device inode mode owner link_count
  [[ -d "$STATE_DIR" && ! -L "$STATE_DIR" ]] || return 1
  metadata=$("$BSD_STAT" -f '%d:%i:%Lp:%u:%l' -- \
    "$STATE_DIR" 2>/dev/null) || return 1
  IFS=: read -r device inode mode owner link_count <<< "$metadata"
  [[ "$mode" == 700 && "$owner" == "$UID" \
    && "$link_count" =~ ^[1-9][0-9]*$ ]] || return 1
  private_path_acl_is_absent "$STATE_DIR" || return 1
  printf '%s:%s:%s:%s:%s\n' \
    "$device" "$inode" "$mode" "$owner" "$link_count"
}

capture_lock_artifact_inventory() {
  local artifact encoded_inventory sort_key insert_at index
  LOCK_ARTIFACT_PATHS=()
  encoded_inventory=$("$BSD_FIND" -P "$STATE_DIR" \
    -mindepth 1 -maxdepth 1 \
    \( -name 'passphrase-new.txt' -o -name '.unlock-recovery.*' \
      -o -name '.tle-unlock.*' -o -name '.state-unlock.*' \
      -o -name '.passphrase-lock.*' -o -name '.tle-lock.*' \
      -o -name '.hash-lock.*' -o -name '.state-lock.*' \
      -o -name '.tle-verify.*' -o -name '.security-output.*' \) \
    -print0 2>/dev/null \
    | while IFS= read -r -d '' artifact; do
        printf '%s' "$artifact" \
          | /usr/bin/od -An -v -tx1 \
          | tr -d ' \n'
        printf '\n'
      done) \
    || die "cannot inspect lock staging artifacts in $STATE_DIR"
  if [[ -n "$encoded_inventory" ]]; then
    while IFS= read -r artifact; do
      [[ -n "$artifact" ]] \
        || die "cannot inspect lock staging artifacts in $STATE_DIR"
      LOCK_ARTIFACT_PATHS+=("$artifact")
    done <<< "$encoded_inventory"
  fi
  for ((index=1; index<${#LOCK_ARTIFACT_PATHS[@]}; index++)); do
    sort_key=${LOCK_ARTIFACT_PATHS[$index]}
    insert_at=$((index - 1))
    while (( insert_at >= 0 )) \
        && [[ "${LOCK_ARTIFACT_PATHS[$insert_at]}" > "$sort_key" ]]; do
      LOCK_ARTIFACT_PATHS[insert_at + 1]=${LOCK_ARTIFACT_PATHS[$insert_at]}
      insert_at=$((insert_at - 1))
    done
    LOCK_ARTIFACT_PATHS[insert_at + 1]=$sort_key
  done
}

require_no_lock_staging_artifacts() {
  capture_lock_artifact_inventory
  [[ "${#LOCK_ARTIFACT_PATHS[@]}" -eq 0 ]] \
    || die "untracked lock staging artifact must be resolved in $STATE_DIR"
}

capture_keychain_snapshot() { # optional expected plaintext
  local expected_plaintext=${1:-} value status
  export -n expected_plaintext value 2>/dev/null || true
  KEYCHAIN_SNAPSHOT_PRESENT=false
  KEYCHAIN_SNAPSHOT_MATCH=false
  KEYCHAIN_SNAPSHOT_DIGEST=absent
  preflight_keychain_target
  if value=$(security find-generic-password -a "$USER" \
      -s "$KEYCHAIN_SERVICE" -w 2>/dev/null); then
    export -n value 2>/dev/null || true
    KEYCHAIN_SNAPSHOT_PRESENT=true
    KEYCHAIN_SNAPSHOT_DIGEST=$(sha256_of "$value") \
      || die "cannot fingerprint keychain recovery material"
    [[ -n "$expected_plaintext" && "$value" == "$expected_plaintext" ]] \
      && KEYCHAIN_SNAPSHOT_MATCH=true
    value=""
    export -n value 2>/dev/null || true
    return 0
  else
    status=$?
  fi
  [[ "$status" -eq 44 ]] || return 1
}

read_lock_keychain_snapshot() { # optional expected plaintext
  capture_keychain_snapshot "${1:-}" || return
  LOCK_KEYCHAIN_PRESENT=$KEYCHAIN_SNAPSHOT_PRESENT
  LOCK_KEYCHAIN_MATCH=$KEYCHAIN_SNAPSHOT_MATCH
  LOCK_KEYCHAIN_DIGEST=$KEYCHAIN_SNAPSHOT_DIGEST
}

capture_protected_file_signatures() {
  [[ -f "$state_file" && ! -L "$state_file" ]] \
    || die "unsafe protected state metadata at $state_file"
  PROTECTED_STATE_FILE_SIGNATURE=$(unlock_file_signature "$state_file" 600) \
    || die "unsafe protected state metadata at $state_file"
  PROTECTED_PLAINTEXT_SIGNATURE=$(unlock_file_signature \
    "$STATE_DIR/passphrase.txt" 600) \
    || die "unsafe protected state metadata at $STATE_DIR/passphrase.txt"
  PROTECTED_CIPHERTEXT_SIGNATURE=$(unlock_file_signature \
    "$STATE_DIR/passphrase.tle" 600) \
    || die "unsafe protected state metadata at $STATE_DIR/passphrase.tle"
  PROTECTED_HASH_SIGNATURE=$(unlock_file_signature \
    "$STATE_DIR/passphrase.sha256" 600) \
    || die "unsafe protected state metadata at $STATE_DIR/passphrase.sha256"
}

capture_lock_boundary_signatures() {
  LOCK_STATE_DIR_IDENTITY=$(lock_state_directory_signature) \
    || die "unsafe protected state metadata at $STATE_DIR"
  capture_protected_file_signatures
  LOCK_STATE_FILE_SIGNATURE=$PROTECTED_STATE_FILE_SIGNATURE
  LOCK_PLAINTEXT_SIGNATURE=$PROTECTED_PLAINTEXT_SIGNATURE
  LOCK_CIPHERTEXT_SIGNATURE=$PROTECTED_CIPHERTEXT_SIGNATURE
  LOCK_HASH_SIGNATURE=$PROTECTED_HASH_SIGNATURE
}

protected_file_boundaries_match() { # state plaintext ciphertext hash
  local expected_state=$1 expected_plaintext=$2
  local expected_ciphertext=$3 expected_hash=$4
  local state plaintext ciphertext hash
  state=$(unlock_file_signature "$state_file" 600) || return 1
  plaintext=$(unlock_file_signature "$STATE_DIR/passphrase.txt" 600) \
    || return 1
  ciphertext=$(unlock_file_signature "$STATE_DIR/passphrase.tle" 600) \
    || return 1
  hash=$(unlock_file_signature "$STATE_DIR/passphrase.sha256" 600) \
    || return 1
  [[ "$state" == "$expected_state" \
    && "$plaintext" == "$expected_plaintext" \
    && "$ciphertext" == "$expected_ciphertext" \
    && "$hash" == "$expected_hash" ]]
}

lock_protected_boundaries_match() {
  local directory
  directory=$(lock_state_directory_signature) || return 1
  [[ "$directory" == "$LOCK_STATE_DIR_IDENTITY" ]] || return 1
  protected_file_boundaries_match \
    "$LOCK_STATE_FILE_SIGNATURE" "$LOCK_PLAINTEXT_SIGNATURE" \
    "$LOCK_CIPHERTEXT_SIGNATURE" "$LOCK_HASH_SIGNATURE"
}

lock_state_directory_signature() {
  unlock_state_directory_signature
}

require_lock_protected_boundaries_match() { # boundary
  local boundary=$1 current
  current=$(lock_state_directory_signature) \
    || die "state directory metadata changed $boundary"
  [[ "$current" == "$LOCK_STATE_DIR_IDENTITY" ]] \
    || die "state directory metadata changed $boundary"
  current=$(unlock_file_signature "$state_file" 600) \
    || die "state file metadata changed $boundary"
  [[ "$current" == "$LOCK_STATE_FILE_SIGNATURE" ]] \
    || die "state file metadata changed $boundary"
  current=$(unlock_file_signature "$STATE_DIR/passphrase.txt" 600) \
    || die "plaintext recovery metadata changed $boundary"
  [[ "$current" == "$LOCK_PLAINTEXT_SIGNATURE" ]] \
    || die "plaintext recovery metadata changed $boundary"
  current=$(unlock_file_signature "$STATE_DIR/passphrase.tle" 600) \
    || die "ciphertext metadata changed $boundary"
  [[ "$current" == "$LOCK_CIPHERTEXT_SIGNATURE" ]] \
    || die "ciphertext metadata changed $boundary"
  current=$(unlock_file_signature "$STATE_DIR/passphrase.sha256" 600) \
    || die "recovery hash metadata changed $boundary"
  [[ "$current" == "$LOCK_HASH_SIGNATURE" ]] \
    || die "recovery hash metadata changed $boundary"
}

require_no_untracked_unlock_staging() {
  local artifact
  artifact=$("$BSD_FIND" -P "$STATE_DIR" -mindepth 1 -maxdepth 1 \
    \( -name '.unlock-recovery.*' -o -name '.tle-unlock.*' \
      -o -name '.state-unlock.*' \) -print -quit 2>/dev/null) \
    || die "cannot inspect unlock staging artifacts in $STATE_DIR"
  [[ -z "$artifact" ]] \
    || die "untracked unlock staging artifact must be resolved: $artifact"
}

capture_unlock_boundary_signatures() {
  UNLOCK_STATE_DIR_IDENTITY=$(unlock_state_directory_signature) \
    || die "unsafe protected state metadata at $STATE_DIR"
  require_no_untracked_unlock_staging
  capture_protected_file_signatures
  UNLOCK_STATE_FILE_SIGNATURE=$PROTECTED_STATE_FILE_SIGNATURE
  UNLOCK_PLAINTEXT_SIGNATURE=$PROTECTED_PLAINTEXT_SIGNATURE
  UNLOCK_CIPHERTEXT_SIGNATURE=$PROTECTED_CIPHERTEXT_SIGNATURE
  UNLOCK_HASH_SIGNATURE=$PROTECTED_HASH_SIGNATURE
}

verify_unlock_target_metadata() {
  unlock_state_directory_signature >/dev/null \
    || die "unsafe protected state metadata at $STATE_DIR"
  require_no_untracked_unlock_staging
  if [[ ! -f "$state_file" || -L "$state_file" ]] \
      || ! unlock_file_signature "$state_file" 600 >/dev/null; then
    die "unsafe protected state metadata at $state_file"
  fi
  if [[ ! -f "$STATE_DIR/passphrase.txt" \
      || -L "$STATE_DIR/passphrase.txt" ]] \
      || ! unlock_file_signature "$STATE_DIR/passphrase.txt" 600 >/dev/null; then
    die "unsafe protected state metadata at $STATE_DIR/passphrase.txt"
  fi
  if [[ ! -f "$STATE_DIR/passphrase.sha256" \
      || -L "$STATE_DIR/passphrase.sha256" ]] \
      || ! unlock_file_signature "$STATE_DIR/passphrase.sha256" 600 >/dev/null; then
    die "unsafe protected state metadata at $STATE_DIR/passphrase.sha256"
  fi
  if [[ -e "$STATE_DIR/passphrase.tle" \
      || -L "$STATE_DIR/passphrase.tle" ]]; then
    unlock_file_signature "$STATE_DIR/passphrase.tle" 600 >/dev/null \
      || die "unsafe protected state metadata at $STATE_DIR/passphrase.tle"
  fi
}

read_unlock_keychain_snapshot() { # expected_plaintext
  capture_keychain_snapshot "$1" || return
  UNLOCK_KEYCHAIN_PRESENT=$KEYCHAIN_SNAPSHOT_PRESENT
  UNLOCK_KEYCHAIN_MATCH=$KEYCHAIN_SNAPSHOT_MATCH
  UNLOCK_KEYCHAIN_DIGEST=$KEYCHAIN_SNAPSHOT_DIGEST
}

read_unlock_hash() {
  local value
  [[ -f "$STATE_DIR/passphrase.sha256" \
    && ! -L "$STATE_DIR/passphrase.sha256" ]] || return 1
  value=$(cat -- "$STATE_DIR/passphrase.sha256") || return 1
  [[ "$value" =~ ^[0-9a-f]{64}$ ]] || return 1
  printf '%s\n' "$value"
}

verify_local_plaintext() {
  local wanted actual
  [[ -f "$STATE_DIR/passphrase.txt" \
    && ! -L "$STATE_DIR/passphrase.txt" ]] \
    || die "plaintext recovery file is missing"
  UNLOCK_PASSPHRASE=$(cat -- "$STATE_DIR/passphrase.txt") \
    || die "plaintext recovery file is unreadable"
  [[ -n "$UNLOCK_PASSPHRASE" ]] \
    || die "plaintext recovery file is empty"
  wanted=$(read_unlock_hash) \
    || die "recovery hash is missing or malformed"
  actual=$(sha256_of "$UNLOCK_PASSPHRASE") \
    || die "cannot hash plaintext recovery material"
  [[ "$actual" == "$wanted" ]] \
    || die "plaintext recovery material fails sha256 verification"
  UNLOCK_PASSPHRASE_SOURCE=local
}

verify_locked_recovery_inputs() {
  if [[ "$SNAPSHOT_PLAINTEXT_PRESENT" == true ]]; then
    [[ "$SNAPSHOT_APFS_LOCKED" == false ]] \
      || die "recorded locked APFS volume unexpectedly retains plaintext recovery material"
    verify_local_plaintext
  fi
  [[ -f "$STATE_DIR/passphrase.tle" \
    && ! -L "$STATE_DIR/passphrase.tle" \
    && -s "$STATE_DIR/passphrase.tle" ]] \
    || die "time-lock ciphertext is missing or empty"
  read_unlock_hash >/dev/null \
    || die "recovery hash is missing or malformed"
}

unlock_state_directory_matches_snapshot() {
  local current
  current=$(unlock_state_directory_signature) || return 1
  [[ "$current" == "$UNLOCK_STATE_DIR_IDENTITY" ]]
}

unlock_protected_boundaries_match() {
  unlock_state_directory_matches_snapshot || return 1
  protected_file_boundaries_match \
    "$UNLOCK_STATE_FILE_SIGNATURE" "$UNLOCK_PLAINTEXT_SIGNATURE" \
    "$UNLOCK_CIPHERTEXT_SIGNATURE" "$UNLOCK_HASH_SIGNATURE"
}

verify_unlock_recovery_boundaries() {
  unlock_protected_boundaries_match \
    || die "protected state changed after unlock plan revalidation"
}

remaining_human() {
  local target=$1 now rem
  now=$(/bin/date +%s)
  rem=$(( target - now ))
  if (( rem <= 0 )); then printf 'deadline passed\n'; return 0; fi
  printf '%dh %dm\n' $(( rem / 3600 )) $(( rem % 3600 / 60 ))
}

plan_discovered_hook_file() { # phase scope path
  local phase=$1 scope=$2 path=$3 index

  discover_hooks_reset
  discover_hook_file "$path" "$scope"
  for ((index=0; index<${#DISCOVERED_HOOK_PATHS[@]}; index++)); do
    plan_add_hook "$phase" "${DISCOVERED_HOOK_SCOPES[$index]}" \
      "${DISCOVERED_HOOK_PATHS[$index]}"
  done
}

plan_discovered_hook_directory() { # phase scope directory
  local phase=$1 scope=$2 directory=$3 index

  discover_hooks_reset
  discover_hook_directory "$directory" "$scope"
  for ((index=0; index<${#DISCOVERED_HOOK_PATHS[@]}; index++)); do
    plan_add_hook "$phase" "${DISCOVERED_HOOK_SCOPES[$index]}" \
      "${DISCOVERED_HOOK_PATHS[$index]}"
  done
}

plan_deferred_hook_directory() { # phase scope directory
  plan_add_deferred_hook "$1" "$2" "$3"
}

require_plan_snapshot() {
  [[ "$SNAPSHOT_VALID" == "true" ]] \
    || die "cannot build a trustworthy plan: $SNAPSHOT_ERROR"
}

require_plan_network_tools() {
  tle_bin >/dev/null || die "tle not found"
  curl -fsS --max-time 10 "$DRAND_URL/$QUICKNET_CHAIN/info" >/dev/null \
    || die "drand chain info unreachable, cannot build a trustworthy plan"
}

plan_lock_hooks() {
  if [[ "$OPTION_HOOKS" == "false" ]]; then
    plan_add hooks_disabled "Hooks disabled by --no-hooks"
    return 0
  fi

  plan_discovered_hook_file pre-lock global "$STATE_DIR/pre-lock.sh"
  plan_discovered_hook_directory pre-lock global \
    "$STATE_DIR/hooks/pre-lock.d"
  if [[ "$SNAPSHOT_APFS_MOUNTED" == "true" ]]; then
    verify_mount_identity "$PLAN_CONTEXT_UUID" "$PLAN_CONTEXT_DEVICE" \
      || die "mounted vault identity changed before pre-lock hook discovery"
    plan_discovered_hook_directory pre-lock vault \
      "$MOUNT_POINT/.vaultlock/hooks/pre-lock.d"
  else
    plan_deferred_hook_directory pre-lock vault \
      "$MOUNT_POINT/.vaultlock/hooks/pre-lock.d"
  fi
}

plan_post_lock_hooks() {
  [[ "$OPTION_HOOKS" == "true" ]] || return 0
  plan_discovered_hook_directory post-lock global \
    "$STATE_DIR/hooks/post-lock.d"
}

plan_lock_repair() {
  [[ "$SNAPSHOT_PLAINTEXT_PRESENT" == "true" ]] \
    || die "cannot build a trustworthy lock plan: plaintext recovery file is missing"

  if [[ "$SNAPSHOT_APFS_LOCKED" == "true" \
      && "$SNAPSHOT_APFS_MOUNTED" == "false" \
      && "$SNAPSHOT_HASH_PRESENT" == "true" ]]; then
    plan_add repair_verify_plaintext \
      "Verify the existing plaintext recovery material against its stored hash for repair"
    plan_add repair_unlock_apfs \
      "Unlock the expected APFS volume with the verified existing recovery material for repair"
    plan_add repair_mount \
      "Mount the expected APFS volume at $MOUNT_POINT for repair"
    plan_add verify_mount_identity \
      "Verify the mounted UUID and device before continuing"
  elif [[ "$SNAPSHOT_APFS_LOCKED" == "false" \
      && "$SNAPSHOT_APFS_MOUNTED" == "false" ]]; then
    plan_add repair_mount \
      "Mount the expected APFS volume at $MOUNT_POINT for repair"
    plan_add verify_mount_identity \
      "Verify the mounted UUID and device before continuing"
  elif [[ "$SNAPSHOT_APFS_LOCKED" != "false" \
      || "$SNAPSHOT_APFS_MOUNTED" != "true" \
      || "$SNAPSHOT_ACTUAL_MOUNT_POINT" != "$MOUNT_POINT" ]]; then
    die "cannot build a trustworthy lock plan from the current APFS state"
  fi
}

plan_lock_transition() {
  require_plan_network_tools
  plan_lock_hooks
  plan_add tm_exclude_state \
    "Persistently exclude the protected state directory from Time Machine and verify the exclusion"
  plan_add tm_exclude \
    "Add the vault volume root to Time Machine exclusions"
  plan_add tm_delete_vault_snapshots \
    "Delete local Time Machine snapshots for the vault"
  plan_add unmount_vault "Unmount the vault"
  plan_add stage_recovery \
    "Generate and durably stage a new random recovery passphrase"
  plan_add rotate_apfs_recovery \
    "Rotate the APFS volume passphrase, then commit the staged plaintext recovery file"
  plan_add keychain_update \
    "Update the keychain with the rotated recovery material"
  plan_add tle_encrypt \
    "Encrypt the rotated recovery material for the resolved drand round"
  plan_add tle_verify_future \
    "Verify the time-lock ciphertext is nonempty and not yet decryptable"
  plan_add persist_locked_recovery \
    "Write the recovery hash and durably record the locked deadline and round"
  plan_add remove_plaintext \
    "Remove plaintext recovery material and its keychain entry"
  plan_add tm_delete_data_snapshots \
    "Delete local Time Machine snapshots for the data volume"
  plan_add apfs_lock "Lock the APFS volume"
  plan_add verify_locked_postconditions \
    "Verify APFS encryption, locked state, and failed unauthenticated mounting"
  plan_post_lock_hooks
}

initialize_lock_plan() {
  local now
  if [[ "$LOCK_DEADLINE_FROZEN" == false ]]; then
    now=$(/bin/date +%s)
    LOCK_REQUEST_DEADLINE_EPOCH=$(resolve_deadline \
      "$OPTION_OPERANDS" "$now") \
      || die "cannot resolve '$OPTION_OPERANDS' to a future deadline, see: vaultlock help"
    LOCK_REQUEST_DEADLINE=$(/bin/date -j -r \
      "$LOCK_REQUEST_DEADLINE_EPOCH" '+%Y-%m-%dT%H:%M:%S%z') \
      || die "deadline is outside the supported date range"
    LOCK_REQUEST_ROUND=$(round_for_epoch "$LOCK_REQUEST_DEADLINE_EPOCH")
    LOCK_DEADLINE_FROZEN=true
  fi
  require_plan_snapshot
  require_no_lock_staging_artifacts

  LOCK_SECURE_NOOP=false
  LOCK_REPAIR_ONLY=false
  LOCK_POST_HOOK_FAILED=false
  LOCK_PERFORM_MOUNT_RESISTANCE=false
  LOCK_DATA_SNAPSHOT_CLEANUP_FAILED=false
  LOCK_KEYCHAIN_PRESENT=false
  LOCK_KEYCHAIN_MATCH=false
  LOCK_KEYCHAIN_DIGEST=not-inspected
  LOCK_PASSPHRASE=""
  LOCK_OLD_PASSPHRASE=""
  export -n LOCK_PASSPHRASE LOCK_OLD_PASSPHRASE 2>/dev/null || true
  capture_lock_boundary_signatures
  preflight_keychain_target

  PLAN_CONTEXT_UUID=$SNAPSHOT_EXPECTED_UUID
  PLAN_CONTEXT_DEVICE=$SNAPSHOT_DEVICE
  PLAN_CONTEXT_DEADLINE=$LOCK_REQUEST_DEADLINE
  PLAN_CONTEXT_DEADLINE_EPOCH=$LOCK_REQUEST_DEADLINE_EPOCH
  PLAN_CONTEXT_ROUND=$LOCK_REQUEST_ROUND
  PLAN_TARGET_TEXT="locked at the resolved deadline"
  PLAN_REQUEST_TEXT="Requested deadline: $LOCK_REQUEST_DEADLINE (epoch $LOCK_REQUEST_DEADLINE_EPOCH)"$'\n'\
"Resolved drand round: target $LOCK_REQUEST_ROUND, current $(current_round)"
}

prepare_recorded_locked_plan() {
  PLAN_CONTEXT_DEADLINE=$SNAPSHOT_DEADLINE
  PLAN_CONTEXT_DEADLINE_EPOCH=$SNAPSHOT_DEADLINE_EPOCH
  PLAN_CONTEXT_ROUND=$SNAPSHOT_ROUND
  [[ "$SNAPSHOT_CIPHERTEXT_PRESENT" == true \
    && "$SNAPSHOT_HASH_PRESENT" == true \
    && -s "$STATE_DIR/passphrase.tle" ]] \
    || die "cannot build a trustworthy lock plan: locked recovery material is incomplete"
  read_unlock_hash >/dev/null \
    || die "recovery hash is missing or malformed"
  if [[ "$SNAPSHOT_PLAINTEXT_PRESENT" == true ]]; then
    verify_local_plaintext
    LOCK_OLD_PASSPHRASE=$UNLOCK_PASSPHRASE
    export -n LOCK_OLD_PASSPHRASE 2>/dev/null || true
    read_lock_keychain_snapshot "$LOCK_OLD_PASSPHRASE" \
      || die "cannot inspect keychain recovery material"
  else
    read_lock_keychain_snapshot \
      || die "cannot inspect keychain recovery material"
  fi
}

plan_recorded_locked_plaintext_repair() {
  LOCK_REPAIR_ONLY=true
  PLAN_TARGET_TEXT="remove retained plaintext recovery material and preserve the existing lock until $SNAPSHOT_DEADLINE"
  PLAN_REQUEST_TEXT="$PLAN_REQUEST_TEXT"$'\n'\
"Existing locked deadline preserved: $SNAPSHOT_DEADLINE, existing drand round $SNAPSHOT_ROUND"
  if [[ "$OPTION_HOOKS" == "false" ]]; then
    plan_add hooks_disabled "Hooks disabled by --no-hooks"
  fi
  plan_add remove_plaintext \
    "Remove retained plaintext and keychain recovery material"
  plan_add verify_secure_target \
    "Verify the repaired locked state, recovery files, and APFS postconditions"
}

plan_recorded_locked_secure_state() {
  PLAN_TARGET_TEXT="already securely locked until $SNAPSHOT_DEADLINE"
  PLAN_REQUEST_TEXT="$PLAN_REQUEST_TEXT"$'\n'\
"Existing locked deadline preserved: $SNAPSHOT_DEADLINE, existing drand round $SNAPSHOT_ROUND"
  if [[ "$LOCK_KEYCHAIN_PRESENT" == true ]]; then
    LOCK_REPAIR_ONLY=true
    PLAN_TARGET_TEXT="remove retained keychain recovery material and preserve the existing lock until $SNAPSHOT_DEADLINE"
    if [[ "$OPTION_HOOKS" == "false" ]]; then
      plan_add hooks_disabled "Hooks disabled by --no-hooks"
    fi
    plan_add remove_plaintext \
      "Remove retained keychain recovery material"
    plan_add verify_secure_target \
      "Verify the repaired locked state, recovery files, and APFS postconditions"
    return 0
  fi
  LOCK_SECURE_NOOP=true
  if [[ "$OPTION_HOOKS" == "false" ]]; then
    plan_add hooks_disabled "Hooks disabled by --no-hooks"
  fi
  plan_add verify_secure_target \
    "Verify the existing locked state, recovery files, and APFS postconditions"
}

plan_recorded_locked_apfs_repair() {
  [[ "$SNAPSHOT_APFS_LOCKED" == false \
    && ( "$SNAPSHOT_APFS_MOUNTED" == false \
      || ( "$SNAPSHOT_APFS_MOUNTED" == true \
        && "$SNAPSHOT_ACTUAL_MOUNT_POINT" == "$MOUNT_POINT" ) ) ]] \
    || die "cannot build a trustworthy lock plan from assessment: $RUNTIME_ASSESSMENT"
  LOCK_REPAIR_ONLY=true
  PLAN_TARGET_TEXT="restore the existing secure lock until $SNAPSHOT_DEADLINE"
  PLAN_REQUEST_TEXT="$PLAN_REQUEST_TEXT"$'\n'\
"Existing locked deadline preserved: $SNAPSHOT_DEADLINE, existing drand round $SNAPSHOT_ROUND"
  if [[ "$OPTION_HOOKS" == "false" ]]; then
    plan_add hooks_disabled "Hooks disabled by --no-hooks"
  fi
  if [[ "$SNAPSHOT_APFS_MOUNTED" == true ]]; then
    plan_add unmount_vault "Unmount the unexpectedly mounted locked vault"
  fi
  plan_add remove_plaintext \
    "Remove any retained plaintext and keychain recovery material"
  plan_add apfs_lock "Restore the APFS locked state"
  plan_add verify_locked_postconditions \
    "Verify the restored secure lock target"
}

plan_unlocked_lock_state() {
  verify_local_plaintext
  LOCK_OLD_PASSPHRASE=$UNLOCK_PASSPHRASE
  export -n LOCK_OLD_PASSPHRASE 2>/dev/null || true
  read_lock_keychain_snapshot "$LOCK_OLD_PASSPHRASE" \
    || die "cannot inspect keychain recovery material"
  [[ "$LOCK_KEYCHAIN_PRESENT" == true \
    && "$LOCK_KEYCHAIN_MATCH" == true ]] \
    || die "keychain recovery material does not match local plaintext"
  plan_lock_repair
  plan_lock_transition
}

build_lock_plan() {
  initialize_lock_plan
  if [[ "$SNAPSHOT_RECORDED_LOCKED" == "true" ]]; then
    prepare_recorded_locked_plan
    if [[ "$SNAPSHOT_APFS_LOCKED" == true \
        && "$SNAPSHOT_APFS_MOUNTED" == false \
        && "$SNAPSHOT_PLAINTEXT_PRESENT" == true ]]; then
      plan_recorded_locked_plaintext_repair
    elif [[ "$RUNTIME_ASSESSMENT" == "securely locked" ]]; then
      plan_recorded_locked_secure_state
    else
      plan_recorded_locked_apfs_repair
    fi
    return 0
  fi
  plan_unlocked_lock_state
}

plan_pre_unlock_hooks() {
  if [[ "$OPTION_HOOKS" == "false" ]]; then
    plan_add hooks_disabled "Hooks disabled by --no-hooks"
    return 0
  fi
  plan_discovered_hook_directory pre-unlock global \
    "$STATE_DIR/hooks/pre-unlock.d"
}

plan_post_unlock_hooks() {
  [[ "$OPTION_HOOKS" == "true" ]] || return 0
  if [[ "$SNAPSHOT_APFS_MOUNTED" == "true" ]]; then
    plan_discovered_hook_directory post-unlock vault \
      "$MOUNT_POINT/.vaultlock/hooks/post-unlock.d"
  else
    plan_deferred_hook_directory post-unlock vault \
      "$MOUNT_POINT/.vaultlock/hooks/post-unlock.d"
  fi
  plan_discovered_hook_directory post-unlock global \
    "$STATE_DIR/hooks/post-unlock.d"
}

plan_locked_unlock_transition() {
  local now
  verify_locked_recovery_inputs
  UNLOCK_ACTUAL_APFS_UNLOCK=false
  if [[ "$SNAPSHOT_APFS_LOCKED" == true \
      && "$SNAPSHOT_APFS_MOUNTED" == false ]]; then
    UNLOCK_ACTUAL_APFS_UNLOCK=true
  elif [[ "$SNAPSHOT_APFS_LOCKED" == false ]]; then
    now=$(/bin/date +%s)
    if (( now < SNAPSHOT_DEADLINE_EPOCH )); then
      die "APFS volume is unexpectedly unlocked before the recorded deadline"
    fi
    [[ "$SNAPSHOT_APFS_MOUNTED" == false \
        || ( "$SNAPSHOT_APFS_MOUNTED" == true \
          && "$SNAPSHOT_ACTUAL_MOUNT_POINT" == "$MOUNT_POINT" ) ]] \
      || die "cannot safely resume an unexpectedly unlocked APFS volume"
  else
    die "cannot build a trustworthy unlock plan from the current APFS state"
  fi
  require_plan_network_tools
  plan_pre_unlock_hooks
  plan_add tle_decrypt \
    "Decrypt the stored time-lock ciphertext after its drand round is available"
  plan_add verify_decrypted_hash \
    "Verify the decrypted recovery material against the stored hash"
  if [[ "$UNLOCK_ACTUAL_APFS_UNLOCK" == true ]]; then
    plan_add apfs_unlock \
      "Unlock the expected APFS volume with the verified recovery material"
  fi
  if [[ "$SNAPSHOT_APFS_MOUNTED" == false ]]; then
    plan_add repair_mount \
      "Mount the expected APFS volume at $MOUNT_POINT"
  fi
  plan_add verify_mount_identity \
    "Verify the mounted UUID and device before continuing"
  if [[ "$SNAPSHOT_PLAINTEXT_PRESENT" == false ]]; then
    plan_add persist_plaintext \
      "Write the verified plaintext recovery file durably"
  fi
  plan_add keychain_update \
    "Update the keychain with the verified recovery material"
  plan_add persist_unlocked_state \
    "Durably record the unlocked state"
  plan_add verify_unlocked_target \
    "Verify the unlocked and mounted target state"
  if [[ "$UNLOCK_ACTUAL_APFS_UNLOCK" == true ]]; then
    plan_post_unlock_hooks
  fi
}

plan_unlocked_repair() {
  verify_local_plaintext
  if [[ "$SNAPSHOT_APFS_LOCKED" == "true" \
      && "$SNAPSHOT_APFS_MOUNTED" == "false" \
      && "$SNAPSHOT_HASH_PRESENT" == "true" ]]; then
    plan_add repair_verify_plaintext \
      "Verify the existing plaintext recovery material against its stored hash for repair"
    plan_add repair_unlock_apfs \
      "Unlock the expected APFS volume with the verified existing recovery material for repair"
    plan_add repair_mount \
      "Mount the expected APFS volume at $MOUNT_POINT for repair"
    plan_add verify_mount_identity \
      "Verify the mounted UUID and device before continuing"
    plan_add keychain_update \
      "Update the keychain with the verified recovery material"
  elif [[ "$SNAPSHOT_APFS_LOCKED" == "false" \
      && "$SNAPSHOT_APFS_MOUNTED" == "false" ]]; then
    plan_add repair_mount \
      "Mount the expected APFS volume at $MOUNT_POINT for repair"
    plan_add verify_mount_identity \
      "Verify the mounted UUID and device before continuing"
  elif [[ "$SNAPSHOT_APFS_LOCKED" == "false" \
      && "$SNAPSHOT_APFS_MOUNTED" == "true" \
      && "$SNAPSHOT_ACTUAL_MOUNT_POINT" == "$MOUNT_POINT" ]]; then
    plan_add verify_mount_identity \
      "Verify the mounted UUID and device before continuing"
  else
    die "cannot build a trustworthy unlock plan from the current APFS state"
  fi
  if [[ "$SNAPSHOT_APFS_LOCKED" == false ]]; then
    read_unlock_keychain_snapshot "$UNLOCK_PASSPHRASE" \
      || die "cannot verify matching keychain recovery material"
    if [[ "$UNLOCK_KEYCHAIN_PRESENT" != true \
        || "$UNLOCK_KEYCHAIN_MATCH" != true ]]; then
      plan_add keychain_update \
        "Update the keychain with the verified recovery material"
    fi
  fi
}

build_unlock_plan() {
  require_plan_snapshot
  UNLOCK_PASSPHRASE=""
  UNLOCK_PASSPHRASE_SOURCE=""
  UNLOCK_DECRYPTED_VERIFIED=false
  UNLOCK_KEYCHAIN_PRESENT=false
  UNLOCK_KEYCHAIN_MATCH=false
  UNLOCK_KEYCHAIN_DIGEST=not-inspected
  UNLOCK_POST_HOOK_FAILED=false
  UNLOCK_ACTUAL_APFS_UNLOCK=false
  if [[ "$SNAPSHOT_RECORDED_LOCKED" == true \
      || "$SNAPSHOT_APFS_LOCKED" == true ]]; then
    preflight_keychain_target
  fi
  capture_unlock_boundary_signatures
  PLAN_CONTEXT_UUID=$SNAPSHOT_EXPECTED_UUID
  PLAN_CONTEXT_DEVICE=$SNAPSHOT_DEVICE
  PLAN_CONTEXT_DEADLINE=$SNAPSHOT_DEADLINE
  PLAN_CONTEXT_DEADLINE_EPOCH=$SNAPSHOT_DEADLINE_EPOCH
  PLAN_CONTEXT_ROUND=$SNAPSHOT_ROUND
  PLAN_TARGET_TEXT="unlocked and mounted at $MOUNT_POINT"

  if [[ "$SNAPSHOT_RECORDED_LOCKED" == "true" ]]; then
    plan_locked_unlock_transition
    return 0
  fi

  plan_unlocked_repair
  plan_add verify_unlocked_target \
    "Verify the unlocked and mounted target state"
  if [[ "$OPTION_HOOKS" == "false" ]]; then
    plan_add hooks_disabled "Hooks disabled by --no-hooks"
  elif [[ "$SNAPSHOT_APFS_LOCKED" == "true" ]]; then
    plan_post_unlock_hooks
  fi
}

frozen_plan_field_value() { # name
  local wanted=$1 index
  for ((index=0; index<${#FROZEN_PLAN_FIELD_NAMES[@]}; index++)); do
    if [[ "${FROZEN_PLAN_FIELD_NAMES[$index]}" == "$wanted" ]]; then
      printf '%s\n' "${FROZEN_PLAN_FIELD_VALUES[$index]}"
      return 0
    fi
  done
  return 1
}

frozen_plan_field_equals() { # name value
  local expected
  expected=$(frozen_plan_field_value "$1") || return 1
  [[ "$expected" == "$2" ]]
}

frozen_plan_fields_equal() { # name value...
  while [[ $# -gt 0 ]]; do
    [[ $# -ge 2 ]] || return 1
    frozen_plan_field_equals "$1" "$2" || return 1
    shift 2
  done
}

revalidate_unlock_inputs_before_candidate_plan() {
  local plaintext
  export -n plaintext 2>/dev/null || true
  # These fields determine whether candidate plan construction may read a
  # credential, reject a deadline, or choose a mutating branch. The canonical
  # serializer below remains the only complete plan-equality schema.
  if ! frozen_plan_fields_equal \
      snapshot_state_valid "$SNAPSHOT_STATE_VALID" \
      snapshot_recorded_locked "$SNAPSHOT_RECORDED_LOCKED" \
      snapshot_expected_uuid "$SNAPSHOT_EXPECTED_UUID" \
      snapshot_apfs_valid "$SNAPSHOT_APFS_VALID" \
      snapshot_apfs_locked "$SNAPSHOT_APFS_LOCKED" \
      snapshot_apfs_mounted "$SNAPSHOT_APFS_MOUNTED" \
      snapshot_valid "$SNAPSHOT_VALID" \
      snapshot_deadline "$SNAPSHOT_DEADLINE" \
      snapshot_deadline_epoch "$SNAPSHOT_DEADLINE_EPOCH" \
      snapshot_round "$SNAPSHOT_ROUND" \
      snapshot_actual_uuid "$SNAPSHOT_ACTUAL_UUID" \
      snapshot_device "$SNAPSHOT_DEVICE" \
      snapshot_mount "$SNAPSHOT_ACTUAL_MOUNT_POINT" \
      snapshot_plaintext "$SNAPSHOT_PLAINTEXT_PRESENT" \
      snapshot_ciphertext "$SNAPSHOT_CIPHERTEXT_PRESENT" \
      snapshot_hash "$SNAPSHOT_HASH_PRESENT"; then
    die "plan changed after operation lock acquisition"
  fi

  capture_unlock_boundary_signatures
  if ! frozen_plan_fields_equal \
      unlock_state_dir_identity "$UNLOCK_STATE_DIR_IDENTITY" \
      unlock_state_file_signature "$UNLOCK_STATE_FILE_SIGNATURE" \
      unlock_plaintext_signature "$UNLOCK_PLAINTEXT_SIGNATURE" \
      unlock_ciphertext_signature "$UNLOCK_CIPHERTEXT_SIGNATURE" \
      unlock_hash_signature "$UNLOCK_HASH_SIGNATURE"; then
    die "plan changed after operation lock acquisition"
  fi

  if [[ "$(frozen_plan_field_value unlock_keychain_digest)" \
      != not-inspected ]]; then
    plaintext=$(cat -- "$STATE_DIR/passphrase.txt") \
      || die "plan changed after operation lock acquisition"
    read_unlock_keychain_snapshot "$plaintext" \
      || die "plan changed after operation lock acquisition"
    if ! frozen_plan_fields_equal \
        unlock_keychain_present "$UNLOCK_KEYCHAIN_PRESENT" \
        unlock_keychain_match "$UNLOCK_KEYCHAIN_MATCH" \
        unlock_keychain_digest "$UNLOCK_KEYCHAIN_DIGEST"; then
      die "plan changed after operation lock acquisition"
    fi
  fi
}

verify_unlock_inputs_after_revalidation() {
  local expected_present=$UNLOCK_KEYCHAIN_PRESENT
  local expected_match=$UNLOCK_KEYCHAIN_MATCH
  local expected_digest=$UNLOCK_KEYCHAIN_DIGEST plaintext
  export -n plaintext 2>/dev/null || true
  require_no_untracked_unlock_staging
  unlock_protected_boundaries_match \
    || die "unlock inputs changed after plan revalidation"
  if [[ "$expected_digest" != not-inspected ]]; then
    plaintext=$(cat -- "$STATE_DIR/passphrase.txt") \
      || die "unlock inputs changed after plan revalidation"
    read_unlock_keychain_snapshot "$plaintext" \
      || die "unlock inputs changed after plan revalidation"
    [[ "$UNLOCK_KEYCHAIN_PRESENT" == "$expected_present" \
      && "$UNLOCK_KEYCHAIN_MATCH" == "$expected_match" \
      && "$UNLOCK_KEYCHAIN_DIGEST" == "$expected_digest" ]] \
      || die "unlock inputs changed after plan revalidation"
  fi
}

verify_lock_inputs_after_revalidation() {
  local expected_present=$LOCK_KEYCHAIN_PRESENT
  local expected_match=$LOCK_KEYCHAIN_MATCH
  local expected_digest=$LOCK_KEYCHAIN_DIGEST plaintext
  export -n plaintext 2>/dev/null || true
  require_no_lock_staging_artifacts
  lock_protected_boundaries_match \
    || die "lock inputs changed after plan revalidation"
  if [[ "$expected_digest" != not-inspected ]]; then
    if [[ "$LOCK_PLAINTEXT_SIGNATURE" != absent ]]; then
      plaintext=$(cat -- "$STATE_DIR/passphrase.txt") \
        || die "lock inputs changed after plan revalidation"
      read_lock_keychain_snapshot "$plaintext" \
        || die "lock inputs changed after plan revalidation"
    else
      read_lock_keychain_snapshot \
        || die "lock inputs changed after plan revalidation"
    fi
    [[ "$LOCK_KEYCHAIN_PRESENT" == "$expected_present" \
      && "$LOCK_KEYCHAIN_MATCH" == "$expected_match" \
      && "$LOCK_KEYCHAIN_DIGEST" == "$expected_digest" ]] \
      || die "lock inputs changed after plan revalidation"
  fi
}

install_private_state_file() { # destination content description
  local destination content description temporary identity installed_identity
  local installed_digest
  export -n content 2>/dev/null || true
  destination=$1
  content=$2
  description=$3
  [[ ! -e "$destination" && ! -L "$destination" ]] \
    || die "$description destination already exists"
  begin_operation_signal_deferral
  temporary=$("$MKTEMP_COMMAND" "$STATE_DIR/.unlock-recovery.XXXXXX") \
    || die "cannot create $description staging file"
  track_unlock_staging_file "$temporary" "" "" \
    "$description staging file"
  identity=$(operation_path_identity "$temporary") \
    || die "cannot capture $description staging identity"
  UNLOCK_STAGING_IDENTITY=$identity
  "$CHMOD_COMMAND" -N "$temporary" \
    || die "cannot remove $description staging ACL"
  "$CHMOD_COMMAND" 600 "$temporary" \
    || die "cannot protect $description staging file"
  private_file_is_valid "$temporary" "$identity" 600 1 \
    || die "$description staging metadata is unsafe"
  printf '%s' "$content" > "$temporary" \
    || die "cannot write $description staging file"
  private_file_is_valid "$temporary" "$identity" 600 1 \
    || die "$description staging identity changed"
  UNLOCK_STAGING_DIGEST=$(operation_owner_digest "$temporary") \
    || die "cannot fingerprint $description staging file"
  if [[ "$description" == "plaintext recovery" ]]; then
    run_named_transition unlock_plaintext_staged "$temporary" \
      || die "plaintext recovery installation failed after staging"
  fi
  if ! "$MV_COMMAND" -n -- "$temporary" "$destination" \
      || [[ -e "$temporary" || -L "$temporary" ]]; then
    die "cannot install $description without replacing an existing path"
  fi
  UNLOCK_STAGING_PATH=$destination
  installed_identity=$(operation_path_identity "$destination") \
    || die "$description installation identity is unavailable"
  installed_digest=$(operation_owner_digest "$destination") \
    || die "$description installation fingerprint is unavailable"
  if [[ "$installed_identity" != "$identity" \
      || "$installed_digest" != "$UNLOCK_STAGING_DIGEST" ]] \
      || ! private_file_is_valid "$destination" "$identity" 600 1; then
    die "$description installation metadata changed"
  fi
  clear_unlock_staging_file
  end_operation_signal_deferral
}

execute_tle_recovery() {
  local tle errfile err_identity error_text status wanted actual
  export -n error_text 2>/dev/null || true
  verify_unlock_recovery_boundaries
  tle=$(tle_bin) || die "tle not found"
  begin_operation_signal_deferral
  errfile=$("$MKTEMP_COMMAND" "$STATE_DIR/.tle-unlock.XXXXXX") \
    || die "cannot create protected TLE error file"
  track_unlock_staging_file "$errfile" "" "" \
    "protected TLE error staging file"
  err_identity=$(operation_path_identity "$errfile") \
    || die "cannot capture protected TLE error file identity"
  UNLOCK_STAGING_IDENTITY=$err_identity
  "$CHMOD_COMMAND" -N "$errfile" \
    || die "cannot remove protected TLE error file ACL"
  "$CHMOD_COMMAND" 600 "$errfile" \
    || die "cannot protect TLE error file"
  private_file_is_valid "$errfile" "$err_identity" 600 1 \
    || die "protected TLE error file metadata is unsafe"
  if UNLOCK_PASSPHRASE=$("$tle" -d -n "$DRAND_URL" \
      -c "$QUICKNET_CHAIN" "$STATE_DIR/passphrase.tle" 2>"$errfile"); then
    status=0
  else
    status=$?
  fi
  error_text=$(cat -- "$errfile" 2>/dev/null || true)
  private_file_is_valid "$errfile" "$err_identity" 600 1 \
    || die "protected TLE error file identity changed"
  UNLOCK_STAGING_DIGEST=$(operation_owner_digest "$errfile") \
    || die "cannot fingerprint protected TLE error file"
  run_named_transition unlock_tle_error_staged "$errfile" \
    || die "TLE recovery failed after error staging"
  cleanup_unlock_staging_file \
    || die "cannot remove protected TLE error file"
  end_operation_signal_deferral
  if [[ "$status" -ne 0 ]]; then
    if grep -qiE "$EARLY_RE" <<< "$error_text"; then
      die "still locked until $PLAN_CONTEXT_DEADLINE ($(remaining_human "$PLAN_CONTEXT_DEADLINE_EPOCH") remaining) - this failure is the lock working"
    fi
    die "TLE recovery failed"
  fi
  [[ -n "$UNLOCK_PASSPHRASE" ]] \
    || die "TLE recovery returned empty recovery material"
  wanted=$(read_unlock_hash) \
    || die "recovery hash is missing or malformed"
  actual=$(sha256_of "$UNLOCK_PASSPHRASE") \
    || die "cannot hash decrypted recovery material"
  [[ "$wanted" == "$actual" ]] \
    || die "decrypted recovery material fails sha256 verification"
  UNLOCK_PASSPHRASE_SOURCE=tle
  UNLOCK_DECRYPTED_VERIFIED=true
}

verify_expected_apfs_state() { # expected_locked
  local expected_locked=$1
  inspect_runtime_state
  [[ "$SNAPSHOT_VALID" == true \
    && "$SNAPSHOT_EXPECTED_UUID" == "$PLAN_CONTEXT_UUID" \
    && "$SNAPSHOT_ACTUAL_UUID" == "$PLAN_CONTEXT_UUID" \
    && "$SNAPSHOT_DEVICE" == "$PLAN_CONTEXT_DEVICE" \
    && "$SNAPSHOT_APFS_LOCKED" == "$expected_locked" ]] \
    || die "expected APFS identity or lock state changed before unlock operation"
}

execute_apfs_unlock() {
  [[ -n "$UNLOCK_PASSPHRASE" ]] \
    || die "verified recovery material is unavailable for APFS unlock"
  run_named_transition unlock_before_apfs_unlock "$PLAN_CONTEXT_DEVICE"
  verify_expected_apfs_state true
  printf '%s' "$UNLOCK_PASSPHRASE" \
    | sudo diskutil apfs unlockVolume "$PLAN_CONTEXT_DEVICE" \
      -stdinpassphrase >/dev/null \
    || die "APFS unlock failed with verified recovery material"
}

execute_mount_expected_volume() {
  inspect_runtime_state
  [[ "$SNAPSHOT_VALID" == true \
    && "$SNAPSHOT_ACTUAL_UUID" == "$PLAN_CONTEXT_UUID" \
    && "$SNAPSHOT_DEVICE" == "$PLAN_CONTEXT_DEVICE" \
    && "$SNAPSHOT_APFS_LOCKED" == false ]] \
    || die "expected unlocked APFS volume changed before mount"
  if [[ "$SNAPSHOT_APFS_MOUNTED" == false ]]; then
    diskutil mount "$PLAN_CONTEXT_DEVICE" >/dev/null \
      || die "cannot mount expected unlocked APFS volume"
  fi
}

execute_restore_plaintext() {
  [[ "$UNLOCK_PASSPHRASE_SOURCE" == tle \
    && "$UNLOCK_DECRYPTED_VERIFIED" == true ]] \
    || die "verified TLE recovery material is unavailable for restoration"
  unlock_state_directory_matches_snapshot \
    || die "state directory changed before plaintext restoration"
  install_private_state_file "$STATE_DIR/passphrase.txt" \
    "$UNLOCK_PASSPHRASE" "plaintext recovery"
  run_named_transition unlock_after_plaintext_restored \
    "$STATE_DIR/passphrase.txt"
}

verify_frozen_unlock_keychain() { # boundary
  local boundary=$1 expected_present expected_match expected_digest
  expected_present=$(frozen_plan_field_value unlock_keychain_present) \
    || die "frozen keychain state is missing"
  expected_match=$(frozen_plan_field_value unlock_keychain_match) \
    || die "frozen keychain match is missing"
  expected_digest=$(frozen_plan_field_value unlock_keychain_digest) \
    || die "frozen keychain digest is missing"
  read_unlock_keychain_snapshot "$UNLOCK_PASSPHRASE" \
    || die "keychain state changed $boundary"
  [[ "$UNLOCK_KEYCHAIN_PRESENT" == "$expected_present" \
    && "$UNLOCK_KEYCHAIN_MATCH" == "$expected_match" \
    && "$UNLOCK_KEYCHAIN_DIGEST" == "$expected_digest" ]] \
    || die "keychain state changed $boundary"
}

execute_unlock_keychain_update() {
  [[ -n "$UNLOCK_PASSPHRASE" ]] \
    || die "verified recovery material is unavailable for keychain update"
  run_named_transition unlock_before_keychain_update "$KEYCHAIN_SERVICE"
  if [[ "$(frozen_plan_field_value unlock_keychain_digest)" \
      != not-inspected ]]; then
    verify_unlock_recovery_boundaries
    verify_frozen_unlock_keychain "before recovery update"
  fi
  keychain_store_passphrase "$UNLOCK_PASSPHRASE" \
    || die "keychain recovery update failed"
  read_unlock_keychain_snapshot "$UNLOCK_PASSPHRASE" \
    || die "cannot verify keychain recovery update"
  [[ "$UNLOCK_KEYCHAIN_PRESENT" == true \
    && "$UNLOCK_KEYCHAIN_MATCH" == true ]] \
    || die "cannot verify keychain recovery update"
}

execute_persist_unlocked_state() {
  local temporary identity expected_state current_state
  local installed_identity installed_digest staged_digest
  expected_state=$UNLOCK_STATE_FILE_SIGNATURE
  current_state=$(unlock_file_signature "$state_file") \
    || die "state file changed before unlocked state update"
  [[ "$current_state" == "$expected_state" ]] \
    || die "state file changed before unlocked state update"
  begin_operation_signal_deferral
  temporary=$("$MKTEMP_COMMAND" "$STATE_DIR/.state-unlock.XXXXXX") \
    || die "cannot create unlocked state staging file"
  track_unlock_staging_file "$temporary" "" "" \
    "unlocked state staging file"
  identity=$(operation_path_identity "$temporary") \
    || die "cannot capture unlocked state staging identity"
  UNLOCK_STAGING_IDENTITY=$identity
  "$CHMOD_COMMAND" -N "$temporary" \
    || die "cannot remove unlocked state staging ACL"
  "$CHMOD_COMMAND" 600 "$temporary" \
    || die "cannot protect unlocked state staging file"
  jq '.locked = false | .deadline = null | .deadline_epoch = null | .round = null' \
    "$state_file" > "$temporary" \
    || die "cannot build unlocked state"
  private_file_is_valid "$temporary" "$identity" 600 1 \
    || die "unlocked state staging metadata changed"
  UNLOCK_STAGING_DIGEST=$(operation_owner_digest "$temporary") \
    || die "cannot fingerprint unlocked state staging file"
  run_named_transition unlock_state_staged "$temporary" \
    || die "unlocked state installation failed after staging"
  current_state=$(unlock_file_signature "$state_file") \
    || die "state file changed before unlocked state installation"
  [[ "$current_state" == "$expected_state" ]] \
    || die "state file changed before unlocked state installation"
  if ! "$MV_COMMAND" -f -- "$temporary" "$state_file"; then
    cleanup_unlock_staging_file \
      || die "cannot install unlocked state, staging cleanup failed"
    die "cannot install unlocked state"
  fi
  [[ ! -e "$temporary" && ! -L "$temporary" ]] \
    || die "unlocked state staging path remains after installation"
  staged_digest=$UNLOCK_STAGING_DIGEST
  clear_unlock_staging_file
  installed_identity=$(operation_path_identity "$state_file") \
    || die "installed unlocked state identity is unavailable"
  installed_digest=$(operation_owner_digest "$state_file") \
    || die "installed unlocked state fingerprint is unavailable"
  if [[ "$installed_identity" != "$identity" \
      || "$installed_digest" != "$staged_digest" ]] \
      || ! private_file_is_valid "$state_file" "$identity" 600 1; then
    die "installed unlocked state metadata changed"
  fi
  end_operation_signal_deferral
}

verify_unlock_target() {
  verify_unlock_target_metadata
  inspect_runtime_state
  [[ "$SNAPSHOT_VALID" == true \
    && "$SNAPSHOT_RECORDED_LOCKED" == false \
    && "$SNAPSHOT_APFS_LOCKED" == false \
    && "$SNAPSHOT_APFS_MOUNTED" == true \
    && "$SNAPSHOT_ACTUAL_MOUNT_POINT" == "$MOUNT_POINT" \
    && "$SNAPSHOT_EXPECTED_UUID" == "$PLAN_CONTEXT_UUID" \
    && "$SNAPSHOT_ACTUAL_UUID" == "$PLAN_CONTEXT_UUID" \
    && "$SNAPSHOT_DEVICE" == "$PLAN_CONTEXT_DEVICE" ]] \
    || die "unlock target is not recorded unlocked, mounted, and identity-verified"
  verify_mount_identity "$PLAN_CONTEXT_UUID" "$PLAN_CONTEXT_DEVICE" \
    || die "unlock target mount identity is not verified"
  verify_local_plaintext
  read_unlock_keychain_snapshot "$UNLOCK_PASSPHRASE" \
    || die "cannot verify matching keychain recovery material"
  [[ "$UNLOCK_KEYCHAIN_PRESENT" == true \
    && "$UNLOCK_KEYCHAIN_MATCH" == true ]] \
    || die "cannot verify matching keychain recovery material"
}

verify_planned_hook() { # index
  local index=$1 expected actual
  expected=$(frozen_plan_field_value "hook_signature_$index") \
    || die "planned hook signature is missing"
  actual=$(hook_file_signature "${PLAN_HOOK_PATHS[$index]}") \
    || die "planned hook changed before execution"
  [[ "$actual" == "$expected" ]] \
    || die "planned hook changed before execution"
}

run_verified_planned_hook() { # index
  local index=$1 phase scope path locked
  phase=${PLAN_HOOK_PHASES[$index]}
  scope=${PLAN_HOOK_SCOPES[$index]}
  path=${PLAN_HOOK_PATHS[$index]}
  verify_planned_hook "$index"
  locked=$(hook_locked_value "$phase")
  run_hook_file "${phase%%-*}" "$phase" "$scope" "$path" \
    "$PLAN_CONTEXT_UUID" "$PLAN_CONTEXT_DEVICE" \
    "$PLAN_CONTEXT_DEADLINE" "$PLAN_CONTEXT_DEADLINE_EPOCH" \
    "$PLAN_CONTEXT_ROUND" "$locked"
}

execute_planned_unlock_hook() { # index
  local index=$1 phase status
  phase=${PLAN_HOOK_PHASES[$index]}
  if [[ "$phase" == post-unlock ]]; then
    verify_unlock_target
  fi
  if run_verified_planned_hook "$index"; then
    return 0
  else
    status=$?
  fi
  if [[ "$phase" == pre-unlock ]]; then
    if [[ "$SNAPSHOT_APFS_LOCKED" == true ]]; then
      die "pre-unlock hooks failed, vault remains locked"
    fi
    die "pre-unlock hooks failed, recorded state remains locked while APFS is already unlocked"
  fi
  UNLOCK_POST_HOOK_FAILED=true
  return 0
}

execute_deferred_unlock_hooks() { # index
  local index=$1 phase scope directory hook hook_scope status hook_index locked
  local hook_argument hook_signature current_signature
  phase=${PLAN_HOOK_PHASES[$index]}
  scope=${PLAN_HOOK_SCOPES[$index]}
  directory=${PLAN_HOOK_DIRECTORIES[$index]}
  [[ "$phase" == post-unlock ]] \
    || die "unsupported deferred unlock hook phase: $phase"
  verify_unlock_target
  discover_hooks_reset
  discover_hook_directory "$directory" "$scope"
  locked=$(hook_locked_value "$phase")
  for ((hook_index=0; hook_index<${#DISCOVERED_HOOK_PATHS[@]}; \
      hook_index++)); do
    verify_unlock_target
    hook=${DISCOVERED_HOOK_PATHS[$hook_index]}
    hook_scope=${DISCOVERED_HOOK_SCOPES[$hook_index]}
    hook_signature=$(hook_file_signature "$hook") \
      || die "discovered unlock hook is no longer executable and regular"
    printf 'Discovered hook %q' "$hook"
    build_hook_argv "$phase" "$hook_scope" "$PLAN_CONTEXT_UUID" \
      "$PLAN_CONTEXT_DEVICE" "$PLAN_CONTEXT_DEADLINE" \
      "$PLAN_CONTEXT_DEADLINE_EPOCH" "$PLAN_CONTEXT_ROUND" "$locked"
    for hook_argument in "${HOOK_ARGV[@]}"; do
      printf ' %q' "$hook_argument"
    done
    printf '\n'
    current_signature=$(hook_file_signature "$hook") \
      || die "discovered unlock hook changed before execution"
    [[ "$current_signature" == "$hook_signature" ]] \
      || die "discovered unlock hook changed before execution"
    if run_hook_file post "$phase" "$hook_scope" "$hook" \
        "$PLAN_CONTEXT_UUID" "$PLAN_CONTEXT_DEVICE" \
        "$PLAN_CONTEXT_DEADLINE" "$PLAN_CONTEXT_DEADLINE_EPOCH" \
        "$PLAN_CONTEXT_ROUND" "$locked"; then
      continue
    else
      status=$?
    fi
    : "$status"
    UNLOCK_POST_HOOK_FAILED=true
  done
}

lock_crypto_marker() { # public marker
  local marker=$1
  if [[ -n "$LOCK_CRYPTO_MARKER_LOG" ]]; then
    printf '%s\n' "$marker" >> "$LOCK_CRYPTO_MARKER_LOG"
  fi
  run_named_transition "lock_crypto_$marker" "$STATE_DIR"
}

complete_lock_crypto_operation() { # marker operation [argv...]
  local marker=$1 operation=$2
  shift 2
  "$operation" "$@"
  lock_crypto_marker "$marker"
}

require_lock_state_directory_match() { # boundary
  local boundary=$1 current
  current=$(lock_state_directory_signature) \
    || die "state directory metadata changed $boundary"
  [[ "$current" == "$LOCK_STATE_DIR_IDENTITY" ]] \
    || die "state directory metadata changed $boundary"
}

record_lock_state_directory_entry_change() { # delta boundary
  local delta=$1 boundary=$2 current
  local old_device old_inode old_mode old_owner old_links
  local new_device new_inode new_mode new_owner new_links
  current=$(lock_state_directory_signature) \
    || die "state directory metadata changed $boundary"
  IFS=: read -r old_device old_inode old_mode old_owner old_links \
    <<< "$LOCK_STATE_DIR_IDENTITY"
  IFS=: read -r new_device new_inode new_mode new_owner new_links \
    <<< "$current"
  [[ "$new_device:$new_inode:$new_mode:$new_owner" \
      == "$old_device:$old_inode:$old_mode:$old_owner" \
    && "$new_links" -eq $((old_links + delta)) ]] \
    || die "state directory metadata changed $boundary"
  LOCK_STATE_DIR_IDENTITY=$current
}

require_lock_destination_match() { # path expected description
  local path=$1 expected=$2 description=$3 current
  require_lock_state_directory_match "before $description installation"
  current=$(unlock_file_signature "$path" 600) \
    || die "$description destination changed before installation"
  [[ "$current" == "$expected" ]] \
    || die "$description destination changed before installation"
}

create_lock_staging_file() { # template description
  local template=$1 description=$2 path signature
  require_lock_state_directory_match "before staging"
  run_named_transition lock_before_stage_create "$STATE_DIR"
  require_lock_state_directory_match "before staging"
  begin_operation_signal_deferral
  path=$("$MKTEMP_COMMAND" "$STATE_DIR/$template") \
    || die "cannot create $description"
  case "$path" in
    "$STATE_DIR"/${template%XXXXXX}*) ;;
    *) die "$description path is outside the protected state directory" ;;
  esac
  [[ "${path#"$STATE_DIR"/}" != */* ]] \
    || die "$description path is outside the protected state directory"
  record_lock_state_directory_entry_change 1 \
    "while creating $description staging"
  [[ -f "$path" && ! -L "$path" ]] \
    || die "$description staging metadata is unsafe"
  unlock_file_signature "$path" 600 >/dev/null \
    || die "$description staging metadata is unsafe"
  signature=$(lock_staging_signature "$path") \
    || die "$description staging metadata is unsafe"
  track_lock_staging_file "$path" "$signature" "$description staging file"
  LOCK_CREATED_STAGE=$path
  run_named_transition lock_after_stage_create "$path"
  "$CHMOD_COMMAND" -N "$path" \
    || die "cannot remove $description staging ACL"
  "$CHMOD_COMMAND" 600 "$path" \
    || die "cannot protect $description staging file"
  refresh_lock_staging_signature "$path" \
    || die "$description staging metadata changed while protecting it"
  end_operation_signal_deferral
}

verify_lock_stage_signature() { # path expected description
  local actual
  actual=$(lock_staging_signature "$1") || return 1
  [[ "$actual" == "$2" ]] || return 1
  : "$3"
}

execute_repair_for_lock() { # operation ID
  case "$1" in
    repair_verify_plaintext)
      lock_protected_boundaries_match \
        || die "protected state changed before lock repair"
      verify_local_plaintext
      ;;
    repair_unlock_apfs) execute_apfs_unlock ;;
    repair_mount) execute_mount_expected_volume ;;
    verify_mount_identity)
      verify_mount_identity "$PLAN_CONTEXT_UUID" "$PLAN_CONTEXT_DEVICE" \
        || die "expected vault is not mounted at $MOUNT_POINT"
      ;;
    *) die "unknown lock repair operation: $1" ;;
  esac
}

execute_pre_lock_hooks() { # index
  execute_planned_lock_hook "$1"
}

time_machine_exclusion_plist_is_active() { # plist expected_path
  local plist=$1 expected_path=$2 excluded path
  printf '%s' "$plist" | plutil -lint - >/dev/null 2>&1 \
    || return 1
  excluded=$(printf '%s' "$plist" \
    | plutil -extract 0.IsExcluded raw -expect integer -o - - \
      2>/dev/null) \
    || return 1
  path=$(printf '%s' "$plist" \
    | plutil -extract 0.Path raw -expect string -o - - 2>/dev/null) \
    || return 1
  [[ "$excluded" == 1 && "$path" == "$expected_path" ]] || return 1
  if printf '%s' "$plist" \
      | plutil -extract 1 raw -o - - >/dev/null 2>&1; then
    return 1
  fi
}

verify_lock_time_machine_boundary() {
  verify_lock_inputs_after_revalidation
  verify_mount_identity "$PLAN_CONTEXT_UUID" "$PLAN_CONTEXT_DEVICE" \
    || die "mounted vault identity changed before Time Machine preflight"
}

execute_state_time_machine_exclusion() {
  local canonical_state_dir output
  verify_lock_time_machine_boundary
  canonical_state_dir=$(cd -P -- "$STATE_DIR" 2>/dev/null && pwd -P) \
    || die "cannot canonicalize protected state directory"
  sudo tmutil addexclusion -p "$canonical_state_dir" \
    || die "cannot establish protected state directory Time Machine exclusion"
  output=$(tmutil isexcluded -X "$canonical_state_dir" 2>/dev/null) \
    || die "cannot verify protected state directory Time Machine exclusion"
  time_machine_exclusion_plist_is_active "$output" "$canonical_state_dir" \
    || die "protected state directory Time Machine exclusion is not active"
}

execute_vault_time_machine_exclusion() {
  verify_lock_time_machine_boundary
  sudo tmutil addexclusion -v "$MOUNT_POINT" \
    || die "cannot add the vault Time Machine exclusion"
}

execute_vault_snapshot_cleanup() {
  verify_lock_time_machine_boundary
  sudo tmutil deletelocalsnapshots "$MOUNT_POINT" >/dev/null 2>&1 \
    || die "cannot delete local Time Machine snapshots for the vault"
}

execute_data_snapshot_cleanup() {
  if ! sudo tmutil deletelocalsnapshots /System/Volumes/Data \
      >/dev/null 2>&1; then
    LOCK_DATA_SNAPSHOT_CLEANUP_FAILED=true
  fi
}

execute_unmount() {
  inspect_runtime_state
  [[ "$SNAPSHOT_VALID" == true \
    && "$SNAPSHOT_ACTUAL_UUID" == "$PLAN_CONTEXT_UUID" \
    && "$SNAPSHOT_DEVICE" == "$PLAN_CONTEXT_DEVICE" \
    && "$SNAPSHOT_APFS_LOCKED" == false ]] \
    || die "lock target identity changed before unmount"
  if [[ "$SNAPSHOT_APFS_MOUNTED" == true ]]; then
    verify_mount_identity "$PLAN_CONTEXT_UUID" "$PLAN_CONTEXT_DEVICE" \
      || die "mounted vault identity changed before unmount"
    if ! diskutil unmount "$MOUNT_POINT"; then
      note "vault is busy, offending processes:"
      lsof +f -- "$MOUNT_POINT" || true
      die "close them and rerun vaultlock lock (no crypto state was changed)"
    fi
  fi
}

generate_rotated_recovery_plaintext() {
  LOCK_PASSPHRASE=$(head -c 32 /dev/urandom | base64)
  export -n LOCK_PASSPHRASE 2>/dev/null || true
  [[ -n "$LOCK_PASSPHRASE" ]] \
    || die "generated recovery material is empty"
  safe_base64_token "$LOCK_PASSPHRASE" \
    || die "generated recovery material is not valid base64"
}

stage_rotated_recovery_plaintext() {
  local transaction_signature fixed_signature
  create_lock_staging_file '.passphrase-lock.XXXXXX' \
    "rotated recovery"
  LOCK_TRANSACTION_STAGE=$LOCK_CREATED_STAGE
  begin_operation_signal_deferral
  printf '%s' "$LOCK_PASSPHRASE" > "$LOCK_TRANSACTION_STAGE" \
    || die "cannot write rotated recovery staging file"
  run_named_transition lock_after_recovery_stage_write \
    "$LOCK_TRANSACTION_STAGE"
  refresh_lock_staging_signature "$LOCK_TRANSACTION_STAGE" \
    || die "rotated recovery staging metadata changed"
  end_operation_signal_deferral
  run_named_transition lock_before_recovery_stage \
    "$STATE_DIR/passphrase-new.txt"
  [[ ! -e "$STATE_DIR/passphrase-new.txt" \
      && ! -L "$STATE_DIR/passphrase-new.txt" ]] \
    || die "cannot install recovery staging file without clobbering an existing path"
  begin_operation_signal_deferral
  "$LN_COMMAND" -- "$LOCK_TRANSACTION_STAGE" \
    "$STATE_DIR/passphrase-new.txt" \
    || die "cannot install recovery staging file without clobbering an existing path"
  run_named_transition lock_after_fixed_stage_link \
    "$STATE_DIR/passphrase-new.txt"
  record_lock_state_directory_entry_change 1 \
    "while installing fixed recovery staging"
  refresh_lock_staging_signature "$LOCK_TRANSACTION_STAGE" \
    || die "rotated recovery transaction metadata changed"
  transaction_signature=$(lock_staging_signature "$LOCK_TRANSACTION_STAGE") \
    || die "rotated recovery transaction metadata changed"
  fixed_signature=$(lock_staging_signature "$STATE_DIR/passphrase-new.txt") \
    || die "rotated recovery fixed staging metadata changed"
  [[ "$transaction_signature" == "$fixed_signature" ]] \
    || die "rotated recovery staging links do not share one identity"
  track_lock_staging_file "$STATE_DIR/passphrase-new.txt" \
    "$fixed_signature" "fixed rotated recovery"
  LOCK_TRANSACTION_SIGNATURE=$transaction_signature
  LOCK_FIXED_STAGE_SIGNATURE=$fixed_signature
  end_operation_signal_deferral
}

generate_and_stage_rotated_recovery() {
  complete_lock_crypto_operation generate-new-plaintext \
    generate_rotated_recovery_plaintext
  complete_lock_crypto_operation write-staged-plaintext \
    stage_rotated_recovery_plaintext
}

verify_frozen_lock_keychain() { # boundary
  local boundary=$1 expected_present expected_match expected_digest
  expected_present=$(frozen_plan_field_value lock_keychain_present) \
    || die "frozen keychain state is missing"
  expected_match=$(frozen_plan_field_value lock_keychain_match) \
    || die "frozen keychain match is missing"
  expected_digest=$(frozen_plan_field_value lock_keychain_digest) \
    || die "frozen keychain digest is missing"
  if [[ -n "$LOCK_OLD_PASSPHRASE" ]]; then
    read_lock_keychain_snapshot "$LOCK_OLD_PASSPHRASE" \
      || die "keychain state changed $boundary"
  else
    read_lock_keychain_snapshot || die "keychain state changed $boundary"
  fi
  [[ "$LOCK_KEYCHAIN_PRESENT" == "$expected_present" \
    && "$LOCK_KEYCHAIN_MATCH" == "$expected_match" \
    && "$LOCK_KEYCHAIN_DIGEST" == "$expected_digest" ]] \
    || die "keychain state changed $boundary"
}

verify_staged_recovery_pair() { # boundary
  local boundary=$1 transaction_signature fixed_signature
  require_lock_state_directory_match "$boundary"
  transaction_signature=$(lock_staging_signature \
    "$LOCK_TRANSACTION_STAGE") \
    || die "staged recovery changed $boundary"
  fixed_signature=$(lock_staging_signature \
    "$STATE_DIR/passphrase-new.txt") \
    || die "staged recovery changed $boundary"
  [[ "$transaction_signature" == "$LOCK_TRANSACTION_SIGNATURE" \
    && "$fixed_signature" == "$LOCK_FIXED_STAGE_SIGNATURE" \
    && "$transaction_signature" == "$fixed_signature" ]] \
    || die "staged recovery changed $boundary"
}

require_lock_rotation_boundaries_match() { # boundary
  local boundary=$1 current
  require_lock_state_directory_match "$boundary"
  current=$(unlock_file_signature "$state_file" 600) \
    || die "state file metadata changed $boundary"
  [[ "$current" == "$LOCK_STATE_FILE_SIGNATURE" ]] \
    || die "state file metadata changed $boundary"
  current=$(lock_staging_signature "$STATE_DIR/passphrase.txt") \
    || die "plaintext recovery metadata changed $boundary"
  [[ "$current" == "$LOCK_PLAINTEXT_SIGNATURE" ]] \
    || die "plaintext recovery metadata changed $boundary"
  current=$(unlock_file_signature "$STATE_DIR/passphrase.tle" 600) \
    || die "ciphertext metadata changed $boundary"
  [[ "$current" == "$LOCK_CIPHERTEXT_SIGNATURE" ]] \
    || die "ciphertext metadata changed $boundary"
  current=$(unlock_file_signature "$STATE_DIR/passphrase.sha256" 600) \
    || die "recovery hash metadata changed $boundary"
  [[ "$current" == "$LOCK_HASH_SIGNATURE" ]] \
    || die "recovery hash metadata changed $boundary"
}

verify_before_apfs_rotation() {
  local old_passphrase
  export -n old_passphrase 2>/dev/null || true
  run_named_transition lock_before_change_passphrase \
    "$PLAN_CONTEXT_DEVICE"
  inspect_runtime_state
  [[ "$SNAPSHOT_VALID" == true \
    && "$SNAPSHOT_EXPECTED_UUID" == "$PLAN_CONTEXT_UUID" \
    && "$SNAPSHOT_ACTUAL_UUID" == "$PLAN_CONTEXT_UUID" \
    && "$SNAPSHOT_DEVICE" == "$PLAN_CONTEXT_DEVICE" \
    && "$SNAPSHOT_APFS_MOUNTED" == false ]] \
    || die "APFS identity or state changed before passphrase rotation"
  require_lock_protected_boundaries_match "before passphrase rotation"
  verify_staged_recovery_pair "before passphrase rotation"
  verify_frozen_lock_keychain "before passphrase rotation"
  old_passphrase=$(cat -- "$STATE_DIR/passphrase.txt") \
    || die "cannot read existing recovery material for APFS rotation"
  export -n old_passphrase 2>/dev/null || true
  [[ "$old_passphrase" == "$LOCK_OLD_PASSPHRASE" ]] \
    || die "plaintext recovery changed before APFS rotation"
}

change_apfs_recovery_passphrase() {
  LOCK_APFS_ROTATION_ATTEMPTED=true
  if ! { printf '%s\n' "$LOCK_OLD_PASSPHRASE"; \
      printf '%s\n' "$LOCK_PASSPHRASE"; } \
      | sudo diskutil apfs changePassphrase "$PLAN_CONTEXT_DEVICE" \
        -user disk -oldStdinpassphrase -newStdinpassphrase \
        >/dev/null 2>&1; then
    die "APFS passphrase rotation failed, staged recovery retained"
  fi
  LOCK_APFS_ROTATED=true
}

install_rotated_plaintext() {
  local transaction_signature
  run_named_transition lock_before_plaintext_install \
    "$STATE_DIR/passphrase.txt"
  require_lock_protected_boundaries_match \
    "before rotated plaintext installation"
  verify_staged_recovery_pair "before rotated plaintext installation"
  require_lock_destination_match "$STATE_DIR/passphrase.txt" \
    "$LOCK_PLAINTEXT_SIGNATURE" "plaintext"
  verify_lock_stage_signature "$STATE_DIR/passphrase-new.txt" \
    "$LOCK_FIXED_STAGE_SIGNATURE" "fixed rotated recovery" \
    || die "fixed rotated recovery changed before installation"
  "$MV_COMMAND" -f -- "$STATE_DIR/passphrase-new.txt" \
    "$STATE_DIR/passphrase.txt" \
    || die "cannot install rotated plaintext recovery"
  record_lock_state_directory_entry_change -1 \
    "while installing rotated plaintext"
  [[ ! -e "$STATE_DIR/passphrase-new.txt" \
      && ! -L "$STATE_DIR/passphrase-new.txt" ]] \
    || die "fixed rotated recovery remains after installation"
  clear_lock_staging_file "$STATE_DIR/passphrase-new.txt"
  refresh_lock_staging_signature "$LOCK_TRANSACTION_STAGE" \
    || die "rotated recovery transaction changed after installation"
  LOCK_TRANSACTION_SIGNATURE=$(lock_staging_signature \
    "$LOCK_TRANSACTION_STAGE") \
    || die "rotated recovery transaction changed after installation"
  LOCK_PLAINTEXT_SIGNATURE=$(lock_staging_signature \
    "$STATE_DIR/passphrase.txt") \
    || die "installed rotated plaintext metadata is unsafe"
}

update_rotated_keychain() {
  run_named_transition lock_before_keychain_update "$KEYCHAIN_SERVICE"
  require_lock_rotation_boundaries_match "before keychain recovery update"
  verify_frozen_lock_keychain "before recovery update"
  keychain_store_passphrase "$LOCK_PASSPHRASE" \
    || die "keychain recovery update failed"
  read_lock_keychain_snapshot "$LOCK_PASSPHRASE" \
    || die "cannot verify keychain recovery update"
  [[ "$LOCK_KEYCHAIN_PRESENT" == true && "$LOCK_KEYCHAIN_MATCH" == true ]] \
    || die "cannot verify keychain recovery update"
}

rotate_and_install_recovery() {
  verify_before_apfs_rotation
  complete_lock_crypto_operation change-apfs-passphrase \
    change_apfs_recovery_passphrase
  complete_lock_crypto_operation install-rotated-plaintext \
    install_rotated_plaintext
  complete_lock_crypto_operation update-keychain update_rotated_keychain
}

encrypt_and_install_lock_ciphertext() {
  local tle stage stage_signature install_delta=0
  tle=$(tle_bin) || die "tle not found"
  create_lock_staging_file '.tle-lock.XXXXXX' "TLE ciphertext"
  stage=$LOCK_CREATED_STAGE
  if ! printf '%s\n' "$LOCK_PASSPHRASE" \
      | "$tle" -e -n "$DRAND_URL" -c "$QUICKNET_CHAIN" \
        -r "$PLAN_CONTEXT_ROUND" -o "$stage" >/dev/null 2>&1; then
    die "TLE encryption failed"
  fi
  refresh_lock_staging_signature "$stage" \
    || die "TLE ciphertext staging metadata changed"
  stage_signature=$(lock_staging_signature "$stage") \
    || die "TLE ciphertext staging metadata changed"
  run_named_transition lock_before_ciphertext_install \
    "$STATE_DIR/passphrase.tle"
  require_lock_rotation_boundaries_match \
    "before ciphertext installation"
  verify_lock_stage_signature "$stage" "$stage_signature" \
    "TLE ciphertext" \
    || die "TLE ciphertext staging changed before installation"
  require_lock_destination_match "$STATE_DIR/passphrase.tle" \
    "$LOCK_CIPHERTEXT_SIGNATURE" "ciphertext"
  [[ "$LOCK_CIPHERTEXT_SIGNATURE" == absent ]] || install_delta=-1
  "$MV_COMMAND" -f -- "$stage" "$STATE_DIR/passphrase.tle" \
    || die "cannot install TLE ciphertext"
  record_lock_state_directory_entry_change "$install_delta" \
    "while installing ciphertext"
  clear_lock_staging_file "$stage"
  LOCK_CIPHERTEXT_SIGNATURE=$(unlock_file_signature \
    "$STATE_DIR/passphrase.tle" 600) \
    || die "installed TLE ciphertext metadata is unsafe"
}

verify_lock_ciphertext_nonempty() {
  [[ -s "$STATE_DIR/passphrase.tle" ]] \
    || die "empty ciphertext, NOT locking"
}

verify_lock_ciphertext_not_early() {
  local tle status
  tle=$(tle_bin) || die "tle not found"
  export -n LOCK_TLE_VERIFY_ERROR 2>/dev/null || true
  if LOCK_TLE_VERIFY_ERROR=$("$tle" -d -n "$DRAND_URL" \
      -c "$QUICKNET_CHAIN" \
      "$STATE_DIR/passphrase.tle" 2>&1); then
    die "ciphertext decrypts right now (past round?), NOT locking"
  else
    status=$?
  fi
  : "$status"
  export -n LOCK_TLE_VERIFY_ERROR 2>/dev/null || true
}

verify_expected_lock_ciphertext_error() {
  grep -qiE "$EARLY_RE" <<< "$LOCK_TLE_VERIFY_ERROR" \
    || die "unexpected TLE verification failure, NOT locking"
  LOCK_TLE_VERIFY_ERROR=""
  export -n LOCK_TLE_VERIFY_ERROR 2>/dev/null || true
}

encrypt_and_verify_lock_ciphertext() {
  complete_lock_crypto_operation create-tle-ciphertext \
    encrypt_and_install_lock_ciphertext
  complete_lock_crypto_operation verify-ciphertext-nonempty \
    verify_lock_ciphertext_nonempty
  complete_lock_crypto_operation verify-ciphertext-not-early \
    verify_lock_ciphertext_not_early
  complete_lock_crypto_operation verify-expected-early-error \
    verify_expected_lock_ciphertext_error
}

install_lock_recovery_hash() {
  local stage stage_signature
  local install_delta=0
  create_lock_staging_file '.hash-lock.XXXXXX' "recovery hash"
  stage=$LOCK_CREATED_STAGE
  sha256_of "$LOCK_PASSPHRASE" > "$stage" \
    || die "cannot write recovery hash staging file"
  refresh_lock_staging_signature "$stage" \
    || die "recovery hash staging metadata changed"
  stage_signature=$(lock_staging_signature "$stage") \
    || die "recovery hash staging metadata changed"
  run_named_transition lock_before_hash_install \
    "$STATE_DIR/passphrase.sha256"
  require_lock_rotation_boundaries_match \
    "before recovery hash installation"
  verify_lock_stage_signature "$stage" "$stage_signature" "recovery hash" \
    || die "recovery hash staging changed before installation"
  require_lock_destination_match "$STATE_DIR/passphrase.sha256" \
    "$LOCK_HASH_SIGNATURE" "recovery hash"
  [[ "$LOCK_HASH_SIGNATURE" == absent ]] || install_delta=-1
  "$MV_COMMAND" -f -- "$stage" "$STATE_DIR/passphrase.sha256" \
    || die "cannot install recovery hash"
  record_lock_state_directory_entry_change "$install_delta" \
    "while installing recovery hash"
  clear_lock_staging_file "$stage"
  LOCK_HASH_SIGNATURE=$(unlock_file_signature \
    "$STATE_DIR/passphrase.sha256" 600) \
    || die "installed recovery hash metadata is unsafe"
}

write_locked_json_stage() {
  local stage
  create_lock_staging_file '.state-lock.XXXXXX' "locked JSON state"
  stage=$LOCK_CREATED_STAGE
  jq --arg d "$PLAN_CONTEXT_DEADLINE" \
    --argjson e "$PLAN_CONTEXT_DEADLINE_EPOCH" \
    --argjson r "$PLAN_CONTEXT_ROUND" \
    '.locked = true | .deadline = $d | .deadline_epoch = $e | .round = $r' \
    "$state_file" > "$stage" \
    || die "cannot build locked JSON state"
  refresh_lock_staging_signature "$stage" \
    || die "locked JSON staging metadata changed"
  LOCK_JSON_STAGE_SIGNATURE=$(lock_staging_signature "$stage") \
    || die "locked JSON staging metadata changed"
  LOCK_JSON_STAGE=$stage
}

install_locked_json_state() {
  local state_signature install_delta=0
  run_named_transition lock_before_state_install "$state_file"
  require_lock_rotation_boundaries_match \
    "before locked state installation"
  verify_lock_stage_signature "$LOCK_JSON_STAGE" \
    "$LOCK_JSON_STAGE_SIGNATURE" \
    "locked JSON state" \
    || die "locked JSON staging changed before installation"
  require_lock_destination_match "$state_file" \
    "$LOCK_STATE_FILE_SIGNATURE" "state"
  install_delta=0
  [[ "$LOCK_STATE_FILE_SIGNATURE" == absent ]] || install_delta=-1
  "$MV_COMMAND" -f -- "$LOCK_JSON_STAGE" "$state_file" \
    || die "cannot install locked JSON state"
  record_lock_state_directory_entry_change "$install_delta" \
    "while installing locked state"
  clear_lock_staging_file "$LOCK_JSON_STAGE"
  LOCK_JSON_STAGE=""
  LOCK_JSON_STAGE_SIGNATURE=""
  state_signature=$(unlock_file_signature "$state_file" 600) \
    || die "installed locked JSON metadata is unsafe"
  LOCK_STATE_FILE_SIGNATURE=$state_signature
}

commit_lock_recovery_transaction() {
  local transaction_signature
  transaction_signature=$(lock_staging_signature "$LOCK_TRANSACTION_STAGE") \
    || die "rotated recovery transaction changed before commit"
  [[ "$transaction_signature" == "$LOCK_TRANSACTION_SIGNATURE" ]] \
    || die "rotated recovery transaction changed before commit"
  "$RM_COMMAND" -f -- "$LOCK_TRANSACTION_STAGE" \
    || die "cannot remove committed recovery transaction staging file"
  record_lock_state_directory_entry_change -1 \
    "while removing committed recovery transaction staging"
  clear_lock_staging_file "$LOCK_TRANSACTION_STAGE"
  LOCK_TRANSACTION_STAGE=""
  LOCK_APFS_ROTATED=false
  LOCK_APFS_ROTATION_ATTEMPTED=false
  LOCK_PLAINTEXT_SIGNATURE=$(unlock_file_signature \
    "$STATE_DIR/passphrase.txt" 600) \
    || die "committed rotated plaintext metadata is unsafe"
}

install_and_commit_locked_json() {
  install_locked_json_state
  commit_lock_recovery_transaction
}

persist_locked_recovery_state() {
  complete_lock_crypto_operation write-plaintext-hash \
    install_lock_recovery_hash
  complete_lock_crypto_operation write-locked-json write_locked_json_stage
  complete_lock_crypto_operation install-locked-json \
    install_and_commit_locked_json
}

execute_rotate_and_encrypt() {
  generate_and_stage_rotated_recovery
  rotate_and_install_recovery
  encrypt_and_verify_lock_ciphertext
  persist_locked_recovery_state
}

remove_verified_lock_plaintext() {
  local current
  [[ -e "$STATE_DIR/passphrase.txt" \
      || -L "$STATE_DIR/passphrase.txt" ]] || return 0
  current=$(unlock_file_signature "$STATE_DIR/passphrase.txt" 600) \
    || die "plaintext recovery changed before removal"
  [[ "$current" == "$LOCK_PLAINTEXT_SIGNATURE" ]] \
    || die "plaintext recovery changed before removal"
  run_named_transition lock_before_plaintext_remove \
    "$STATE_DIR/passphrase.txt"
  if [[ "$LOCK_REPAIR_ONLY" == true ]]; then
    verify_lock_repair_deletion_boundary true
  else
    verify_lock_deletion_boundary true
  fi
  current=$(unlock_file_signature "$STATE_DIR/passphrase.txt" 600) \
    || die "plaintext recovery changed before removal"
  [[ "$current" == "$LOCK_PLAINTEXT_SIGNATURE" ]] \
    || die "plaintext recovery changed before removal"
  "$RM_COMMAND" -f -- "$STATE_DIR/passphrase.txt" \
    || die "cannot verify removal of plaintext recovery material"
  [[ ! -e "$STATE_DIR/passphrase.txt" \
      && ! -L "$STATE_DIR/passphrase.txt" ]] \
    || die "cannot verify removal of plaintext recovery material"
  record_lock_state_directory_entry_change -1 \
    "while removing plaintext recovery material"
  LOCK_PLAINTEXT_SIGNATURE=absent
}

verify_lock_repair_deletion_boundary() { # plaintext_expected
  local plaintext_expected=$1
  inspect_runtime_state
  [[ "$SNAPSHOT_VALID" == true \
    && "$SNAPSHOT_EXPECTED_UUID" == "$PLAN_CONTEXT_UUID" \
    && "$SNAPSHOT_ACTUAL_UUID" == "$PLAN_CONTEXT_UUID" \
    && "$SNAPSHOT_DEVICE" == "$PLAN_CONTEXT_DEVICE" \
    && "$SNAPSHOT_APFS_MOUNTED" == false \
    && "$SNAPSHOT_RECORDED_LOCKED" == true \
    && "$SNAPSHOT_DEADLINE" == "$PLAN_CONTEXT_DEADLINE" \
    && "$SNAPSHOT_DEADLINE_EPOCH" == "$PLAN_CONTEXT_DEADLINE_EPOCH" \
    && "$SNAPSHOT_ROUND" == "$PLAN_CONTEXT_ROUND" \
    && "$SNAPSHOT_PLAINTEXT_PRESENT" == "$plaintext_expected" \
    && "$SNAPSHOT_CIPHERTEXT_PRESENT" == true \
    && "$SNAPSHOT_HASH_PRESENT" == true \
    && -s "$STATE_DIR/passphrase.tle" ]] \
    || die "protected recovery state changed before repair removal"
  lock_protected_boundaries_match \
    || die "protected recovery state changed before repair removal"
  if [[ "$plaintext_expected" == true ]]; then
    verify_local_plaintext
  fi
  verify_frozen_lock_keychain "before repair removal"
}

verify_lock_deletion_boundary() { # plaintext_expected
  local plaintext_expected=$1 wanted actual
  inspect_runtime_state
  [[ "$SNAPSHOT_VALID" == true \
    && "$SNAPSHOT_EXPECTED_UUID" == "$PLAN_CONTEXT_UUID" \
    && "$SNAPSHOT_ACTUAL_UUID" == "$PLAN_CONTEXT_UUID" \
    && "$SNAPSHOT_DEVICE" == "$PLAN_CONTEXT_DEVICE" \
    && "$SNAPSHOT_APFS_MOUNTED" == false \
    && "$SNAPSHOT_RECORDED_LOCKED" == true \
    && "$SNAPSHOT_DEADLINE" == "$PLAN_CONTEXT_DEADLINE" \
    && "$SNAPSHOT_DEADLINE_EPOCH" == "$PLAN_CONTEXT_DEADLINE_EPOCH" \
    && "$SNAPSHOT_ROUND" == "$PLAN_CONTEXT_ROUND" \
    && "$SNAPSHOT_PLAINTEXT_PRESENT" == "$plaintext_expected" \
    && "$SNAPSHOT_CIPHERTEXT_PRESENT" == true \
    && "$SNAPSHOT_HASH_PRESENT" == true \
    && -s "$STATE_DIR/passphrase.tle" ]] \
    || die "protected recovery state changed before plaintext removal"
  lock_protected_boundaries_match \
    || die "protected recovery state changed before plaintext removal"
  wanted=$(read_unlock_hash) \
    || die "protected recovery hash changed before plaintext removal"
  actual=$(sha256_of "$LOCK_PASSPHRASE") \
    || die "cannot verify recovery hash before plaintext removal"
  [[ "$wanted" == "$actual" ]] \
    || die "protected recovery hash changed before plaintext removal"
  read_lock_keychain_snapshot "$LOCK_PASSPHRASE" \
    || die "keychain state changed before plaintext removal"
  [[ "$LOCK_KEYCHAIN_PRESENT" == true \
    && "$LOCK_KEYCHAIN_MATCH" == true ]] \
    || die "keychain state changed before plaintext removal"
}

delete_and_verify_lock_keychain() {
  local value status
  export -n value 2>/dev/null || true
  security delete-generic-password -a "$USER" \
    -s "$KEYCHAIN_SERVICE" >/dev/null 2>&1 || true
  if value=$(security find-generic-password -a "$USER" \
      -s "$KEYCHAIN_SERVICE" -w 2>/dev/null); then
    value=""
    export -n value 2>/dev/null || true
    die "cannot verify removal of keychain recovery material"
  else
    status=$?
  fi
  [[ "$status" -eq 44 ]] \
    || die "cannot verify removal of keychain recovery material"
  LOCK_KEYCHAIN_PRESENT=false
  LOCK_KEYCHAIN_MATCH=false
  LOCK_KEYCHAIN_DIGEST=absent
}

execute_remove_plaintext() {
  complete_lock_crypto_operation remove-plaintext \
    remove_verified_lock_plaintext
  if [[ "$LOCK_REPAIR_ONLY" == true ]]; then
    run_named_transition lock_before_repair_keychain_remove \
      "$KEYCHAIN_SERVICE"
    verify_lock_repair_deletion_boundary false
  else
    verify_lock_deletion_boundary false
  fi
  complete_lock_crypto_operation remove-keychain-plaintext \
    delete_and_verify_lock_keychain
}

lock_apfs_volume() {
  local lock_output status
  run_named_transition lock_before_apfs_lock "$PLAN_CONTEXT_DEVICE"
  inspect_runtime_state
  [[ "$SNAPSHOT_VALID" == true \
    && "$SNAPSHOT_EXPECTED_UUID" == "$PLAN_CONTEXT_UUID" \
    && "$SNAPSHOT_ACTUAL_UUID" == "$PLAN_CONTEXT_UUID" \
    && "$SNAPSHOT_DEVICE" == "$PLAN_CONTEXT_DEVICE" \
    && "$SNAPSHOT_APFS_MOUNTED" == false \
    && "$SNAPSHOT_RECORDED_LOCKED" == true \
    && "$SNAPSHOT_DEADLINE" == "$PLAN_CONTEXT_DEADLINE" \
    && "$SNAPSHOT_DEADLINE_EPOCH" == "$PLAN_CONTEXT_DEADLINE_EPOCH" \
    && "$SNAPSHOT_ROUND" == "$PLAN_CONTEXT_ROUND" \
    && "$SNAPSHOT_PLAINTEXT_PRESENT" == false \
    && "$SNAPSHOT_CIPHERTEXT_PRESENT" == true \
    && "$SNAPSHOT_HASH_PRESENT" == true ]] \
    || die "APFS identity or state changed before lockVolume"
  lock_protected_boundaries_match \
    || die "protected locked state changed before lockVolume"
  read_lock_keychain_snapshot \
    || die "keychain state changed before lockVolume"
  [[ "$LOCK_KEYCHAIN_PRESENT" == false ]] \
    || die "keychain state changed before lockVolume"
  if lock_output=$(sudo diskutil apfs lockVolume \
      "$PLAN_CONTEXT_DEVICE" 2>&1); then
    status=0
  else
    status=$?
  fi
  if [[ "$status" -ne 0 ]] \
      && ! grep -qi 'already locked' <<< "$lock_output"; then
    die "APFS lock failed after recovery material removal, target security is unverified"
  fi
  [[ -z "$lock_output" ]] || note "$lock_output"
}

execute_apfs_lock() {
  complete_lock_crypto_operation lock-apfs lock_apfs_volume
}

verify_lock_filevault() {
  local filevault_output
  filevault_output=$(diskutil info "$PLAN_CONTEXT_DEVICE") \
    || die "lock target verification failed: cannot inspect FileVault"
  grep -q 'FileVault:.*Yes' <<< "$filevault_output" \
    || die "lock target verification failed: volume does not report FileVault"
}

verify_lock_mount_resistance() {
  if diskutil mount "$PLAN_CONTEXT_DEVICE" >/dev/null 2>&1; then
    die "lock target verification failed: volume mounted without a passphrase"
  fi
}

verify_lock_target() {
  require_no_lock_staging_artifacts
  inspect_runtime_state
  [[ "$SNAPSHOT_VALID" == true \
    && "$SNAPSHOT_RECORDED_LOCKED" == true \
    && "$SNAPSHOT_APFS_LOCKED" == true \
    && "$SNAPSHOT_APFS_MOUNTED" == false \
    && "$SNAPSHOT_EXPECTED_UUID" == "$PLAN_CONTEXT_UUID" \
    && "$SNAPSHOT_ACTUAL_UUID" == "$PLAN_CONTEXT_UUID" \
    && "$SNAPSHOT_DEVICE" == "$PLAN_CONTEXT_DEVICE" \
    && "$SNAPSHOT_DEADLINE" == "$PLAN_CONTEXT_DEADLINE" \
    && "$SNAPSHOT_DEADLINE_EPOCH" == "$PLAN_CONTEXT_DEADLINE_EPOCH" \
    && "$SNAPSHOT_ROUND" == "$PLAN_CONTEXT_ROUND" \
    && "$SNAPSHOT_PLAINTEXT_PRESENT" == false \
    && "$SNAPSHOT_CIPHERTEXT_PRESENT" == true \
    && "$SNAPSHOT_HASH_PRESENT" == true ]] \
    || die "lock target verification failed: recorded and APFS state is not securely locked"
  lock_protected_boundaries_match \
    || die "lock target verification failed: protected recovery state changed"
  unlock_file_signature "$state_file" 600 >/dev/null \
    || die "lock target verification failed: locked JSON metadata is unsafe"
  unlock_file_signature "$STATE_DIR/passphrase.tle" 600 >/dev/null \
    || die "lock target verification failed: ciphertext metadata is unsafe"
  unlock_file_signature "$STATE_DIR/passphrase.sha256" 600 >/dev/null \
    || die "lock target verification failed: recovery hash metadata is unsafe"
  read_unlock_hash >/dev/null \
    || die "lock target verification failed: recovery hash is malformed"
  read_lock_keychain_snapshot \
    || die "lock target verification failed: cannot inspect keychain"
  [[ "$LOCK_KEYCHAIN_PRESENT" == false ]] \
    || die "lock target verification failed: keychain plaintext remains"
  if [[ "$LOCK_PERFORM_MOUNT_RESISTANCE" == true ]]; then
    complete_lock_crypto_operation verify-filevault verify_lock_filevault
    complete_lock_crypto_operation verify-mount-resistance \
      verify_lock_mount_resistance
    LOCK_PERFORM_MOUNT_RESISTANCE=false
  else
    verify_lock_filevault
  fi
}

execute_post_lock_hooks() { # index
  execute_planned_lock_hook "$1"
}

execute_planned_lock_hook() { # index
  local index=$1 phase status
  phase=${PLAN_HOOK_PHASES[$index]}
  if [[ "$phase" == pre-lock ]]; then
    verify_mount_identity "$PLAN_CONTEXT_UUID" "$PLAN_CONTEXT_DEVICE" \
      || die "mounted vault identity changed before pre-lock hook"
  fi
  if [[ "$phase" == post-lock ]]; then
    verify_lock_target
  fi
  if run_verified_planned_hook "$index"; then
    return 0
  else
    status=$?
  fi
  if [[ "$phase" == pre-lock ]]; then
    die "pre-lock hooks failed, vault remains unlocked"
  fi
  : "$status"
  LOCK_POST_HOOK_FAILED=true
  return 0
}

execute_deferred_lock_hooks() { # index
  local index=$1 phase scope directory hook hook_scope hook_index locked status
  local hook_signature current_signature
  phase=${PLAN_HOOK_PHASES[$index]}
  scope=${PLAN_HOOK_SCOPES[$index]}
  directory=${PLAN_HOOK_DIRECTORIES[$index]}
  [[ "$phase" == pre-lock ]] \
    || die "unsupported deferred lock hook phase: $phase"
  verify_mount_identity "$PLAN_CONTEXT_UUID" "$PLAN_CONTEXT_DEVICE" \
    || die "mounted vault identity changed before deferred pre-lock hooks"
  discover_hooks_reset
  discover_hook_directory "$directory" "$scope"
  locked=$(hook_locked_value "$phase")
  for ((hook_index=0; hook_index<${#DISCOVERED_HOOK_PATHS[@]}; \
      hook_index++)); do
    verify_mount_identity "$PLAN_CONTEXT_UUID" "$PLAN_CONTEXT_DEVICE" \
      || die "mounted vault identity changed before deferred pre-lock hook"
    hook=${DISCOVERED_HOOK_PATHS[$hook_index]}
    hook_scope=${DISCOVERED_HOOK_SCOPES[$hook_index]}
    hook_signature=$(hook_file_signature "$hook") \
      || die "discovered pre-lock hook is no longer executable and regular"
    printf 'Discovered hook %q' "$hook"
    build_hook_argv "$phase" "$hook_scope" "$PLAN_CONTEXT_UUID" \
      "$PLAN_CONTEXT_DEVICE" "$PLAN_CONTEXT_DEADLINE" \
      "$PLAN_CONTEXT_DEADLINE_EPOCH" "$PLAN_CONTEXT_ROUND" "$locked"
    printf ' %q' "${HOOK_ARGV[@]}"
    printf '\n'
    run_named_transition lock_before_deferred_hook "$hook"
    current_signature=$(hook_file_signature "$hook") \
      || die "discovered pre-lock hook changed before execution"
    [[ "$current_signature" == "$hook_signature" ]] \
      || die "discovered pre-lock hook changed before execution"
    if run_hook_file pre "$phase" "$hook_scope" "$hook" \
        "$PLAN_CONTEXT_UUID" "$PLAN_CONTEXT_DEVICE" \
        "$PLAN_CONTEXT_DEADLINE" "$PLAN_CONTEXT_DEADLINE_EPOCH" \
        "$PLAN_CONTEXT_ROUND" "$locked"; then
      continue
    else
      status=$?
    fi
    : "$status"
    die "pre-lock hooks failed, vault remains unlocked"
  done
}

execute_init_plan_operation() { # operation_id
  case "$1" in
    init_prepare_state) execute_init_prepare_state ;;
    init_create_volume) execute_init_create_volume ;;
    init_write_state) execute_init_write_state ;;
    *) die "no init executor for plan operation: $1" ;;
  esac
}

execute_adopt_plan_operation() { # operation_id
  case "$1" in
    adopt_copy) execute_adopt_copy ;;
    adopt_verify) execute_adopt_verify ;;
    adopt_replace_source) execute_adopt_replace_source ;;
    *) die "no adopt executor for plan operation: $1" ;;
  esac
}

execute_unlock_plan_operation() { # index operation_id
  local index=$1 operation_id=$2 decrypted_recovery
  export -n decrypted_recovery 2>/dev/null || true
  case "$operation_id" in
    repair_verify_plaintext)
      verify_unlock_recovery_boundaries
      verify_local_plaintext
      ;;
    repair_unlock_apfs|apfs_unlock) execute_apfs_unlock ;;
    repair_mount) execute_mount_expected_volume ;;
    verify_mount_identity)
      verify_mount_identity "$PLAN_CONTEXT_UUID" "$PLAN_CONTEXT_DEVICE" \
        || die "expected vault is not mounted at $MOUNT_POINT"
      ;;
    tle_decrypt) execute_tle_recovery ;;
    verify_decrypted_hash)
      [[ "$UNLOCK_DECRYPTED_VERIFIED" == true ]] \
        || die "decrypted recovery material is not verified"
      if [[ "$SNAPSHOT_PLAINTEXT_PRESENT" == true ]]; then
        decrypted_recovery=$UNLOCK_PASSPHRASE
        verify_local_plaintext
        [[ "$UNLOCK_PASSPHRASE" == "$decrypted_recovery" ]] \
          || die "retained plaintext does not match decrypted recovery material"
        UNLOCK_PASSPHRASE=$decrypted_recovery
        UNLOCK_PASSPHRASE_SOURCE=tle
      fi
      ;;
    persist_plaintext) execute_restore_plaintext ;;
    keychain_update) execute_unlock_keychain_update ;;
    persist_unlocked_state) execute_persist_unlocked_state ;;
    verify_unlocked_target) verify_unlock_target ;;
    hook) execute_planned_unlock_hook "$index" ;;
    deferred_hook_discovery) execute_deferred_unlock_hooks "$index" ;;
    *) die "no unlock executor for plan operation: $operation_id" ;;
  esac
}

execute_lock_plan_operation() { # index operation_id
  local index=$1 operation_id=$2
  case "$operation_id" in
    repair_verify_plaintext|repair_unlock_apfs|repair_mount|\
verify_mount_identity)
      execute_repair_for_lock "$operation_id"
      ;;
    hook)
      case "${PLAN_HOOK_PHASES[$index]}" in
        pre-lock) execute_pre_lock_hooks "$index" ;;
        post-lock)
          [[ "$LOCK_DATA_SNAPSHOT_CLEANUP_FAILED" == true ]] \
            || execute_post_lock_hooks "$index"
          ;;
        *) die "unsupported lock hook phase" ;;
      esac
      ;;
    deferred_hook_discovery) execute_deferred_lock_hooks "$index" ;;
      tm_exclude_state) execute_state_time_machine_exclusion ;;
      tm_exclude) execute_vault_time_machine_exclusion ;;
      tm_delete_vault_snapshots) execute_vault_snapshot_cleanup ;;
      unmount_vault) execute_unmount ;;
      stage_recovery) execute_rotate_and_encrypt ;;
      rotate_apfs_recovery|keychain_update|tle_encrypt|tle_verify_future|\
persist_locked_recovery) ;;
      remove_plaintext) execute_remove_plaintext ;;
      tm_delete_data_snapshots) execute_data_snapshot_cleanup ;;
      apfs_lock) execute_apfs_lock ;;
      verify_locked_postconditions)
        LOCK_PERFORM_MOUNT_RESISTANCE=true
        verify_lock_target
        ;;
      verify_secure_target)
        LOCK_PERFORM_MOUNT_RESISTANCE=true
        verify_lock_target
        ;;
      *) die "no lock executor for plan operation: $operation_id" ;;
  esac
}

execute_plan() {
  local index operation_id
  for ((index=0; index<${#PLAN_OPERATION_IDS[@]}; index++)); do
    operation_id=${PLAN_OPERATION_IDS[$index]}
    case "$operation_id" in
      hooks_disabled|operation_lock_acquire|operation_lock_quarantine|\
operation_lock_release) continue ;;
    esac
    case "$OPERATION_LOCK_COMMAND" in
      init) execute_init_plan_operation "$operation_id" ;;
      adopt) execute_adopt_plan_operation "$operation_id" ;;
      unlock) execute_unlock_plan_operation "$index" "$operation_id" ;;
      lock) execute_lock_plan_operation "$index" "$operation_id" ;;
      *) die "no executor for planned command: $OPERATION_LOCK_COMMAND" ;;
    esac
  done
}

run_planned_command() { # command
  local command=$1
  case "$command" in
    init)
      inspect_init_absent_state
      plan_reset
      plan_add_coordination_start
      build_init_plan
      plan_add_coordination_finish
      ;;
    adopt)
      inspect_adopt_state
      plan_reset
      plan_add_coordination_start
      build_adopt_plan
      plan_add_coordination_finish
      ;;
    unlock)
      inspect_runtime_state
      classify_runtime_state
      plan_reset
      plan_add_coordination_start
      build_unlock_plan
      plan_add_coordination_finish
      ;;
    lock)
      inspect_runtime_state
      classify_runtime_state
      plan_reset
      plan_add_coordination_start
      build_lock_plan
      plan_add_coordination_finish
      ;;
    *) die "no planned command runner for: $command" ;;
  esac
  freeze_planned_command_snapshot "$command"
  render_plan "$command"
  if [[ "$OPTION_DRY_RUN" == "true" ]]; then
    printf 'Result: no changes made\n'
    return 0
  fi
  [[ "$command" == unlock ]] || confirm_plan
  acquire_operation_lock "$command"
  revalidate_plan_under_operation_lock "$command"
  if [[ "$command" == unlock ]]; then
    run_named_transition unlock_before_execution "$state_file"
    verify_unlock_inputs_after_revalidation
  elif [[ "$command" == lock ]]; then
    run_named_transition lock_before_execution "$state_file"
    verify_lock_inputs_after_revalidation
  fi
  execute_plan
  case "$command" in
    init) verify_init_target ;;
    adopt) verify_adopt_target ;;
    unlock)
      verify_unlock_target
      if [[ "$UNLOCK_POST_HOOK_FAILED" == true ]]; then
        die "vault is unlocked and mounted at $MOUNT_POINT, but one or more post-unlock hooks failed"
      fi
      ;;
    lock) verify_lock_target ;;
  esac
  finish_operation_lock
  if [[ "$command" == lock \
      && "$LOCK_DATA_SNAPSHOT_CLEANUP_FAILED" == true ]]; then
    die "cannot delete local Time Machine snapshots for the data volume"
  fi
  if [[ "$command" == lock && "$LOCK_POST_HOOK_FAILED" == true ]]; then
    die "vault is locked until $PLAN_CONTEXT_DEADLINE, but one or more post-lock hooks failed"
  fi
  case "$command" in
    init)
      note "Result: created encrypted volume $VOLUME ($PLAN_CONTEXT_UUID), state in $STATE_DIR"
      ;;
    adopt)
      note "Result: adopted $ADOPT_SOURCE -> $ADOPT_DESTINATION"
      ;;
    unlock)
      note "Result: unlocked and mounted at $MOUNT_POINT"
      note "next: cd ~/your-project && ./run.sh"
      ;;
    lock)
      note "Result: locked until $PLAN_CONTEXT_DEADLINE (drand round $PLAN_CONTEXT_ROUND)"
      ;;
  esac
}

dispatch_init() {
  parse_command_options init "$@"
  run_planned_command init
}

dispatch_adopt() {
  parse_command_options adopt "$@"
  run_planned_command adopt
}

dispatch_lock() {
  parse_command_options lock "$@"
  run_planned_command lock
}

dispatch_unlock() {
  parse_command_options unlock "$@"
  [[ -f "$state_file" ]] || die "no state"
  run_planned_command unlock
}

cmd_status() {
  [[ $# -eq 0 ]] || die_usage "usage: vaultlock status"
  inspect_runtime_state
  classify_runtime_state
  render_runtime_summary
}

usage() {
  cat >&2 <<'EOF'
usage: vaultlock <command>
  init [--dry-run] [--yes] create the encrypted vault volume
  adopt [--dry-run] [--yes] <dir>
                             move a directory onto the vault, leave a symlink
  lock [--dry-run] [--yes] [--no-hooks] <deadline>
                             time-lock the vault until a future deadline
  unlock [--dry-run] [--no-hooks]
                             unlock after the deadline (needs internet)
  status                     show lock state and remaining time

deadline forms:
  "YYYY-MM-DD HH:MM"         absolute local date and time
  H:MM                       next occurrence of a local clock time
  NdNhNm                     elapsed duration, for example 1d4h or 20h
  H:MM +Nd                   local clock time N calendar days from today

hook directories:
  ~/.vaultlock/hooks/<phase>.d
  /Volumes/vault/.vaultlock/hooks/{pre-lock,post-unlock}.d
EOF
  exit 64
}

case "${1:-}" in
  __round) round_for_epoch "$2" ;;
  __parse) parse_deadline "$2" ;;
  __options)
    [[ $# -ge 2 ]] \
      || die_usage "usage: vaultlock __options <command> [arguments...]"
    shift
    parse_command_options "$@"
    printf 'dry_run=%s\nyes=%s\nhooks=%s\noperands=%s\n' \
      "$OPTION_DRY_RUN" "$OPTION_YES" "$OPTION_HOOKS" "$OPTION_OPERANDS"
    ;;
  __confirm_response)
    [[ $# -eq 2 ]] \
      || die_usage "usage: vaultlock __confirm_response <response>"
    if confirmation_accepts "$2"; then
      note true
    else
      note false
    fi
    ;;
  __process_start_valid)
    [[ $# -eq 2 ]] \
      || die_usage "usage: vaultlock __process_start_valid <value>"
    valid_process_start_identity "$2"
    ;;
  __keychain_store)
    [[ $# -eq 1 ]] || die_usage "usage: vaultlock __keychain_store"
    IFS= read -r harness_passphrase \
      || die "keychain helper input is unavailable"
    keychain_store_passphrase "$harness_passphrase"
    ;;
  __confirm_plan)
    [[ $# -eq 3 ]] \
      || die_usage "usage: vaultlock __confirm_plan <dry_run> <yes>"
    OPTION_DRY_RUN=$2
    OPTION_YES=$3
    confirm_plan
    ;;
  __plan_operation)
    [[ $# -eq 2 ]] \
      || die_usage "usage: vaultlock __plan_operation <operation_id>"
    plan_reset
    plan_add "$2" "test operation"
    ;;
  __plan_deferred)
    [[ $# -eq 4 ]] \
      || die_usage "usage: vaultlock __plan_deferred <phase> <scope> <directory>"
    plan_reset
    plan_add_deferred_hook "$2" "$3" "$4"
    printf 'id=%s\nphase=%s\nscope=%s\ndirectory=%q\nrendered=' \
      "${PLAN_OPERATION_IDS[0]}" "${PLAN_HOOK_PHASES[0]}" \
      "${PLAN_HOOK_SCOPES[0]}" "${PLAN_HOOK_DIRECTORIES[0]}"
    render_deferred_hook_plan_item 0
    ;;
  __deadline)
    now=${2:?usage: vaultlock __deadline <now_epoch> <expression>}
    shift 2
    [[ $# -gt 0 ]] || die "usage: vaultlock __deadline <now_epoch> <expression>"
    resolve_deadline "$*" "$now"
    ;;
  __hooks)
    [[ $# -eq 8 ]] \
      || die "usage: vaultlock __hooks <phase> <uuid> <device> <deadline> <epoch> <round> <locked>"
    shift
    run_test_hook_phase "$@"
    ;;
  init) shift; dispatch_init "$@" ;;
  adopt) shift; dispatch_adopt "$@" ;;
  lock) shift; dispatch_lock "$@" ;;
  unlock) shift; dispatch_unlock "$@" ;;
  status) shift; cmd_status "$@" ;;
  *) usage ;;
esac
